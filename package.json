{
  "name": "jearonwong-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/**",
    "public/**",
    "README.md"
  ],
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "clean:astro": "rm -rf .astro node_modules/.astro dist",
    "build:clean": "npm run clean:astro && npm run build",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "audit:publication": "node scripts/site-publication-audit.mjs",
    "audit:ia": "node scripts/site-information-architecture-audit.mjs",
    "audit:editorial": "node scripts/site-editorial-audit.mjs",
    "audit:content": "node scripts/site-content-quality-audit.mjs",
    "audit:content-quality": "node scripts/site-content-quality-audit.mjs",
    "audit:package-surface": "node scripts/site-package-surface-audit.mjs",
    "audit:security": "node scripts/site-security-headers-audit.mjs",
    "audit:asset-registry": "node scripts/site-asset-registry-audit.mjs",
    "audit:browser": "node scripts/site-browser-quality-audit.mjs",
    "audit:visual": "node scripts/site-visual-system-audit.mjs",
    "audit:media": "node scripts/site-media-visual-system-audit.mjs --check",
    "assets:og": "node scripts/generate-site-og-assets.mjs",
    "assets:og:check": "node scripts/generate-site-og-assets.mjs --check",
    "assets:media": "npm run assets:og && node scripts/migrate-site-media-visual-system.mjs && node scripts/site-media-visual-system-audit.mjs",
    "assets:media:check": "npm run assets:og:check && node scripts/migrate-site-media-visual-system.mjs --check && npm run audit:media",
    "publication:plan": "node scripts/site-publication-plan.mjs",
    "publication:sync": "node scripts/site-publication-sync.mjs",
    "publication:verify": "node scripts/site-generated-drift-audit.mjs",
    "audit:impact": "node scripts/site-change-impact.mjs",
    "audit:routes": "node scripts/site-route-matrix.mjs",
    "publication:closeout": "npm run publication:verify && node scripts/site-publication-receipt.mjs --out dist/publication-receipt.json",
    "verify:production": "node scripts/site-production-verify.mjs",
    "verify:production:local": "node scripts/site-production-verify.mjs --base http://127.0.0.1:4329 --allow-missing-commit",
    "audit:all": "npm run typecheck && npm run lint && npm run build && npm run publication:verify && npm run assets:og:check && npm run audit:media && npm run audit:publication && npm run audit:ia && npm run audit:editorial && npm run audit:content && npm run audit:asset-registry && npm run audit:browser && npm run audit:package-surface && npm run audit:security && npm run audit:visual",
    "audit:governance": "npm run audit:all",
    "lint": "eslint . --ext .js,.mjs,.astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.3.1",
    "sharp": "^0.35.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.11.1",
    "fast-xml-builder": "^1.3.1",
    "svgo": "^4.1.0",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.18"
    }
  }
}
