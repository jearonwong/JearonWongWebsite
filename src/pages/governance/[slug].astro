---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegistryPageHero from "../../components/RegistryPageHero.astro";
import ReadingGuide from "../../components/ReadingGuide.astro";
import GAICSourceTrace from "../../components/GAICSourceTrace.astro";
import { getGaicP1SourceTraceByRoute } from "../../data/gaicP1SourceTrace";
import {
  getGovernanceMappingBySlug,
  governanceMappings,
  isIndexableGovernanceRoute
} from "../../data/governanceMappings";
import { siteConfig } from "../../data/site";
import { absoluteUrl, createBreadcrumbJsonLd } from "../../data/schema";

export function getStaticPaths() {
  return governanceMappings.map((mapping) => ({
    params: { slug: mapping.slug }
  }));
}

const { slug } = Astro.params;
const mapping = slug ? getGovernanceMappingBySlug(slug) : undefined;

if (!mapping) {
  throw new Error(`Unknown governance mapping: ${slug}`);
}

const canonicalPath = mapping.canonicalRoute;
const pageUrl = absoluteUrl(canonicalPath);
const gaicSourceTrace = getGaicP1SourceTraceByRoute(canonicalPath);
const whitePaperHub = "/research/global-ai-compliance-white-paper-2026/";
const conceptCorePath = "/concepts/agentic-lifecycle-governance/";
const relatedLinks = [
  { href: mapping.canonicalParent, label: "Governance index" },
  ...mapping.relatedLinks
]
  .filter((link, index, links) => links.findIndex((candidate) => candidate.href === link.href) === index)
  .filter((link) => isIndexableGovernanceRoute(link.href))
  .slice(0, 5);
const hasOfficialSource = mapping.sourceRefs.some((source) => source.authority !== "authored-research");
const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: mapping.title,
  description: mapping.seoDescription,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  mainEntity: {
    "@id": `${pageUrl}#article`
  },
  breadcrumb: {
    "@id": `${pageUrl}#breadcrumb`
  },
  citation: mapping.sourceRefs.map((source) => absoluteUrl(source.url))
};
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${pageUrl}#article`,
  headline: mapping.title,
  description: mapping.seoDescription,
  url: pageUrl,
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  publisher: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  ...(mapping.publishedAt ? { datePublished: mapping.publishedAt } : {}),
  ...(mapping.updatedAt ? { dateModified: mapping.updatedAt } : {}),
  keywords: mapping.keywords,
  audience: mapping.primaryAudience.map((audience) => ({
    "@type": "Audience",
    audienceType: audience
  })),
  about: mapping.keywords.map((keyword) => ({
    "@type": "Thing",
    name: keyword
  })),
  mentions: [
    ...mapping.relatedObjects.map((object) => ({
      "@type": "Thing",
      name: object
    })),
    ...(gaicSourceTrace
      ? gaicSourceTrace.sourceAnchors.map((anchor) => ({
          "@type": "Thing",
          name: anchor.label
        }))
      : [])
  ],
  isPartOf: {
    "@type": "CollectionPage",
    name: "AI Agent Governance and Lifecycle Responsibility",
    url: absoluteUrl(mapping.canonicalParent)
  },
  isBasedOn: [
    ...mapping.sourceRefs.map((source) => ({
      "@type": source.authority === "authored-research" ? "TechArticle" : "CreativeWork",
      name: source.label,
      url: absoluteUrl(source.url)
    })),
    {
      "@type": "WebPage",
      name: "Agentic Lifecycle Governance",
      url: absoluteUrl(conceptCorePath)
    }
  ]
};
const breadcrumbJsonLd = createBreadcrumbJsonLd(pageUrl, [
  { name: "Home", path: "/" },
  { name: "Governance", path: mapping.canonicalParent },
  { name: mapping.title, path: canonicalPath }
]);
---

<BaseLayout
  title={mapping.seoTitle}
  description={mapping.seoDescription}
  canonicalPath={canonicalPath}
  noindex={mapping.indexability === "noindex"}
  jsonLd={[pageJsonLd, articleJsonLd, breadcrumbJsonLd]}
  ogType="article"
  keywords={mapping.keywords}
  ogImagePath="/social/og-ai-agent-governance.png"
  ogImageAlt={`${mapping.title} by Jearon Wong`}
>
  <RegistryPageHero
    title={mapping.title}
    objectType="GOVERNANCE_MAPPING"
    objectValue={mapping.category.toUpperCase().replaceAll(" ", "_")}
    lead={mapping.seoDescription}
  >
    <div class="governance-hero-links">
      <a href={mapping.canonicalParent} class="registry-annotation governance-hero-link">
        <span class="registry-key">BACK_TO</span>: <span class="registry-value">GOVERNANCE</span>
      </a>
      <a href={conceptCorePath} class="registry-annotation governance-hero-link">
        <span class="registry-key">CONCEPT_CORE</span>: <span class="registry-value">AGENTIC LIFECYCLE GOVERNANCE</span>
      </a>
      <a href={whitePaperHub} class="registry-annotation governance-hero-link">
        <span class="registry-key">AUTHORITY_SOURCE</span>: <span class="registry-value">GAIC WHITE PAPER</span>
      </a>
    </div>
  </RegistryPageHero>

  <div class="zone-b page-body page-body--standard">
    <article class="shell governance-detail-shell">
      <ReadingGuide
        role="GOVERNANCE_MAPPING"
        answer={mapping.summary}
        startHref="#mapping-summary"
        startLabel="Read the mapping summary"
        nextLinks={[{ href: mapping.canonicalParent, label: "Return to governance" }, { href: conceptCorePath, label: "Open lifecycle governance" }]}
        sections={["Summary and boundary", "Lifecycle lens", "Key questions", "Related objects", "Source boundary"]}
      />
      <aside class="registry-chassis governance-sidebar" aria-label={`${mapping.title} reference`}>
        <div class="registry-annotation" style="margin-bottom: 1rem;">
          <span class="registry-key">MAPPING_RECORD</span>
        </div>
        <p class="sidebar-title">{mapping.title}</p>
        <div class="sidebar-group">
          <p class="sidebar-label">Category</p>
          <p class="sidebar-copy">{mapping.category}</p>
        </div>
        <div class="sidebar-group">
          <p class="sidebar-label">Related objects</p>
          <div class="keyword-list">
            {mapping.relatedObjects.map((object) => <span>{object}</span>)}
          </div>
        </div>
        <div class="sidebar-group">
          <p class="sidebar-label">Source boundary</p>
          <p class="sidebar-copy">{hasOfficialSource ? "Official sources consulted where current regulatory or standards context is referenced." : "GAIC author-analytical source only; no external legal or standards claims added."}</p>
        </div>
        <div class="sidebar-group">
          <p class="sidebar-label">Primary audience</p>
          <div class="keyword-list">
            {mapping.primaryAudience.map((audience) => <span>{audience}</span>)}
          </div>
        </div>
      </aside>

      <div class="governance-article">
        <section class="registry-chassis definition-panel" id="mapping-summary">
          <div class="registry-annotation" style="margin-bottom: 1rem;">
            <span class="registry-key">SUMMARY</span>
          </div>
          <p>{mapping.summary}</p>
        </section>

        <section class="governance-section">
          <h2>Boundary statement</h2>
          <p>{mapping.boundary}</p>
        </section>

        <section class="governance-section">
          <h2>Lifecycle governance lens</h2>
          <p>{mapping.lifecycleLens}</p>
        </section>

        <section class="governance-section">
          <h2>Key governance questions</h2>
          <ol class="question-list">
            {mapping.keyQuestions.map((question) => <li>{question}</li>)}
          </ol>
        </section>

        <section class="governance-section">
          <h2>Related lifecycle objects</h2>
          <div class="mro-list">
            {mapping.relatedObjects.map((object) => <span>{object}</span>)}
          </div>
        </section>

        <section class="governance-section">
          <h2>RCCS-M / ALCS relevance</h2>
          <p>{mapping.rccsAlcs}</p>
        </section>

        <section class="governance-section">
          <h2>Enterprise use</h2>
          <p>{mapping.enterpriseUse}</p>
        </section>

        <section class="governance-section">
          <h2>Source boundary</h2>
          <p>{mapping.sourceBoundary}</p>
          {mapping.sourceRefs.length > 0 && (
            <div class="source-list">
              {mapping.sourceRefs.map((source) => (
                <a href={source.url}>
                  <strong>{source.label}</strong>
                  <span>{source.scope}</span>
                </a>
              ))}
            </div>
          )}
        </section>

        {gaicSourceTrace && <GAICSourceTrace trace={gaicSourceTrace} />}

        <section class="relation-grid" aria-label={`${mapping.title} related links`}>
          <article class="registry-chassis relation-panel">
            <div class="registry-annotation" style="margin-bottom: 0.9rem;">
              <span class="registry-key">RELATED_LINKS</span>
            </div>
            <h2>Related concepts and source routes</h2>
            <div class="term-link-grid">
              {relatedLinks.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          </article>
        </section>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .governance-hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.2rem;
    margin-top: 1.4rem;
  }

  .governance-hero-link {
    text-decoration: none;
  }

  .governance-hero-link:hover .registry-value {
    color: var(--color-action);
  }

  .governance-detail-shell {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    max-width: 1080px;
  }

  /* ReadingGuide is a child component with its own Astro scope. Keep it on
     a full-width row instead of allowing grid auto-placement to narrow it to
     the reference rail. */
  .governance-detail-shell > :global(.reading-guide) {
    grid-column: 1 / -1;
    grid-row: 1;
    min-width: 0;
  }

  .governance-sidebar {
    grid-column: 1;
    grid-row: 2;
    position: sticky;
    top: 7rem;
    padding: var(--registry-card-padding);
  }

  .sidebar-title {
    margin: 0;
    color: var(--current-text);
    font-size: 1.25rem;
    font-weight: 760;
    line-height: var(--type-card-title-line-height);
    letter-spacing: var(--type-card-title-letter-spacing);
    word-spacing: var(--type-card-title-word-spacing);
  }

  .sidebar-group {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--current-line);
  }

  .sidebar-label {
    margin: 0 0 0.75rem;
    color: var(--current-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sidebar-copy {
    margin: 0;
    color: var(--current-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .keyword-list,
  .mro-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .keyword-list span,
  .mro-list span {
    display: inline-flex;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--current-line);
    color: var(--current-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.25;
  }

  .governance-article {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    gap: 2.5rem;
  }

  .definition-panel {
    padding: var(--registry-panel-padding);
    border-left: 3px solid var(--color-rule);
  }

  .definition-panel p,
  .governance-section p {
    margin: 0;
    color: var(--current-muted);
    font-size: 1.05rem;
    line-height: 1.72;
  }

  .definition-panel p {
    color: var(--current-text);
  }

  .governance-section {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--current-line);
  }

  .governance-section h2,
  .relation-panel h2 {
    margin: 0 0 0.9rem;
    color: var(--current-text);
    font-size: 1.45rem;
    line-height: var(--type-card-title-line-height);
    letter-spacing: var(--type-card-title-letter-spacing);
    word-spacing: var(--type-card-title-word-spacing);
  }

  .question-list {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding-left: 1.35rem;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .source-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .source-list a {
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem;
    border: 1px solid var(--current-line);
    color: var(--color-action);
    text-decoration: none;
  }

  .source-list strong {
    color: var(--current-text);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .source-list span {
    color: var(--current-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .relation-grid {
    display: grid;
    gap: 1.25rem;
  }

  .relation-panel {
    padding: var(--registry-card-padding);
  }

  .term-link-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .term-link-grid a {
    display: inline-flex;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--current-line);
    color: var(--color-action);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .term-link-grid a:hover,
  .source-list a:hover strong {
    color: var(--color-action);
  }

  @media (max-width: 900px) {
    .governance-detail-shell {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .governance-detail-shell > :global(.reading-guide),
    .governance-sidebar,
    .governance-article {
      grid-column: auto;
      grid-row: auto;
    }

    .governance-sidebar {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .definition-panel,
    .governance-sidebar,
    .relation-panel {
      padding: var(--registry-card-padding);
    }
  }
</style>
