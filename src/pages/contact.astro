---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegistryPageHero from "../components/RegistryPageHero.astro";
import { contactContent, pageRegistry, socialLinks, siteConfig } from "../data/site";
import { absoluteUrl, createBreadcrumbJsonLd } from "../data/schema";

const canonicalPath = "/contact/";
const contactUrl = absoluteUrl(canonicalPath);
const contactPageJsonLd = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "ContactPage"],
  "@id": `${contactUrl}#webpage`,
  url: contactUrl,
  name: pageRegistry.contact.title,
  description: pageRegistry.contact.lead,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  mainEntity: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  breadcrumb: {
    "@id": `${contactUrl}#breadcrumb`
  }
};
const contactBreadcrumbJsonLd = createBreadcrumbJsonLd(contactUrl, [
  { name: "Home", path: "/" },
  { name: "Contact", path: canonicalPath }
]);
---

<BaseLayout
  title="Contact"
  description={pageRegistry.contact.lead}
  canonicalPath={canonicalPath}
  jsonLd={[contactPageJsonLd, contactBreadcrumbJsonLd]}
>
      <RegistryPageHero
    title={pageRegistry.contact.title}
    objectType={pageRegistry.contact.objectType}
    objectValue={pageRegistry.contact.objectValue}
    lead={pageRegistry.contact.lead}
  />

  <div class="zone-b page-body page-body--standard">
    <section class="shell shell--narrow page-stack page-stack--tight">
      <p class="contact-intro">{contactContent.intro}</p>

      <section class="contact-routes" aria-label="Conversation routes">
        {contactContent.routes.map((route, index) => (
          <article class="registry-chassis contact-route" id={route.key === "IMAGE_PUBLICATION_LICENSING" ? "image-licensing" : route.key.toLowerCase()}>
            <div class="contact-route__header">
              <span class="contact-route__index">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <div class="registry-annotation"><span class="registry-key">{route.key}</span></div>
                <h2>{route.title}</h2>
              </div>
            </div>
            <p>{route.body}</p>
            <dl class="contact-route__detail">
              <div><dt>Bring</dt><dd>{route.ask}</dd></div>
              <div><dt>Likely first output</dt><dd>{route.outcome}</dd></div>
            </dl>
          </article>
        ))}
      </section>

      <!-- Primary: Email -->
      <article class="registry-chassis contact-block">
        <div class="registry-annotation" style="margin-bottom: 1.25rem;">
          <span class="registry-key">PRIMARY_CHANNEL</span>
        </div>
        <a href={`mailto:${siteConfig.author.email}`} class="email-cta" data-analytics-event="contact_open">
          {siteConfig.author.email}
        </a>
        <p class="contact-note">Use the route above to give the message enough context. Direct contact does not imply a commitment, endorsement, licensing grant, or delivery agreement.</p>
      </article>

      <!-- Social channels -->
      <article class="registry-chassis contact-block">
        <div class="registry-annotation" style="margin-bottom: 1.25rem;">
          <span class="registry-key">SOCIAL_CHANNELS</span>
        </div>
        <div class="channel-grid">
          {socialLinks.map(link => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="channel-row" data-analytics-event="outbound_source_click">
              <span class="channel-key">{link.platform.toUpperCase()}</span>
              <span class="channel-value">{link.label}</span>
            </a>
          ))}
        </div>
      </article>

    </section>
  </div>
</BaseLayout>

<style>
  .contact-intro {
    max-width: 62ch;
    margin: 0 0 2rem;
    color: var(--current-muted);
    font-size: 1.02rem;
    line-height: 1.68;
  }
  .contact-routes {
    display: grid;
    gap: 1px;
    margin-bottom: 2.5rem;
    background: var(--current-line);
  }
  .contact-route {
    padding: var(--registry-panel-padding);
    background: var(--current-surface);
  }
  .contact-route__header {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
  }
  .contact-route__index {
    padding-top: 0.2rem;
    color: var(--color-meta);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .contact-route h2 {
    margin: 0.55rem 0 0;
    color: var(--current-text);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    line-height: 1.22;
    letter-spacing: 0;
    word-spacing: 0;
  }
  .contact-route > p {
    max-width: 64ch;
    margin: 1rem 0 0 3.4rem;
    color: var(--current-muted);
    line-height: 1.62;
  }
  .contact-route__detail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 0 3.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--current-line);
  }
  .contact-route__detail div { min-width: 0; }
  .contact-route__detail dt {
    color: var(--color-meta);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .contact-route__detail dd {
    margin: 0.35rem 0 0;
    color: var(--current-muted);
    font-size: 0.88rem;
    line-height: 1.52;
  }
  .contact-block {
    padding: var(--registry-panel-padding);
  }
  .email-cta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-action);
    text-decoration: none;
    letter-spacing: 0.02em;
    padding: 0.8rem 1.5rem;
    border: 1px solid var(--color-action);
    border-radius: 2px;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .email-cta:hover {
    background: var(--color-action);
    color: white;
  }
  .contact-note {
    margin: 1.5rem 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--current-muted);
    max-width: 55ch;
  }
  .channel-grid {
    display: grid;
    gap: 0;
  }
  .channel-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 2rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--current-line);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .channel-row:first-child {
    border-top: 1px solid var(--current-line);
  }
  .channel-row:hover {
    background: var(--color-action-soft);
  }
  .channel-key {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-meta);
  }
  .channel-value {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--current-muted);
  }
  @media (max-width: 768px) {
    .contact-route { padding: var(--registry-card-padding); }
    .contact-route > p,
    .contact-route__detail { margin-left: 0; }
    .contact-route__detail { grid-template-columns: 1fr; }
    .contact-block {
      padding: var(--registry-card-padding);
    }
    .email-cta {
      font-size: 0.95rem;
      padding: 0.65rem 1.1rem;
    }
    .channel-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding: 0.7rem 0;
    }
  }
</style>
