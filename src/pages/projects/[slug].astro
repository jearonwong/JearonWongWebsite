---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegistryPageHero from "../../components/RegistryPageHero.astro";
import SocialShare from "../../components/SocialShare.astro";
import {
  getConceptBySlug,
  getProjectBySlug,
  getProjectGraphPosition,
  getTheoryClusterName,
  homepageActions,
  siteConfig,
  siteSemanticBaseline
} from "../../data/site";
import { absoluteUrl, createBreadcrumbJsonLd } from "../../data/schema";

export async function getStaticPaths() {
  return ["mplp", "cognitive-os", "solocrew", "validation-lab"].map((slug) => ({
    params: { slug }
  }));
}

const { slug } = Astro.params;
const project = slug ? getProjectBySlug(slug) : undefined;

if (!project) {
  throw new Error(`Unknown project record: ${slug}`);
}

const adjacentProofs = (project.adjacentProofs ?? []).reduce<
  Array<NonNullable<ReturnType<typeof getProjectBySlug>>>
>((acc, relatedSlug) => {
  const adjacent = getProjectBySlug(relatedSlug);
  if (adjacent) acc.push(adjacent);
  return acc;
}, []);
const relatedConcepts = (project.relatedConcepts ?? [])
  .map((conceptSlug) => getConceptBySlug(conceptSlug))
  .filter((concept): concept is NonNullable<typeof concept> => Boolean(concept));
const graphPosition = getProjectGraphPosition(project.slug);
const previousProof = graphPosition.previous;
const nextProof = graphPosition.next;
const projectMetaDescription = project.shareDescription ?? `${project.summary} ${project.proves}`;
const projectUrl = new URL(`/projects/${project.slug}/`, siteConfig.siteUrl).toString();
const projectKeywords = Array.from(new Set([
  project.name,
  project.status,
  project.proofRole,
  "AI Agent Lifecycle",
  "Agentic Delivery",
  "Agentic Lifecycle Governance",
  "AI agent governance",
  "MPLP",
  ...(project.relatedIdeas ?? []),
  ...relatedConcepts.map((concept) => concept.term)
]));
const projectBreadcrumbJsonLd = createBreadcrumbJsonLd(projectUrl, [
  { name: "Home", path: "/" },
  { name: "Projects", path: "/projects/" },
  { name: project.name, path: `/projects/${project.slug}/` }
]);
const projectWebPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${projectUrl}#webpage`,
  url: projectUrl,
  name: project.name,
  description: projectMetaDescription,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  breadcrumb: {
    "@id": `${projectUrl}#breadcrumb`
  },
  mainEntity: {
    "@id": `${projectUrl}#project`
  }
};
const projectJsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${projectUrl}#project`,
  name: project.name,
  description: projectMetaDescription,
  url: projectUrl,
  mainEntityOfPage: {
    "@id": `${projectUrl}#webpage`
  },
  isPartOf: {
    "@type": "CreativeWork",
    name: "Agentic Delivery protocol path and proof path",
    description: siteSemanticBaseline.referencePathDefinition,
    url: absoluteUrl("/projects/")
  },
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  publisher: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  keywords: projectKeywords,
  about: projectKeywords.map((keyword) => ({
    "@type": "Thing",
    name: keyword
  })),
  relatedLink: [
    absoluteUrl("/lifecycle/"),
    absoluteUrl("/concepts/agentic-lifecycle-governance/"),
    absoluteUrl("/research/global-ai-compliance-white-paper-2026/"),
    ...relatedConcepts.map((concept) => absoluteUrl(`/concepts/${concept.slug}/`))
  ],
  sameAs: project.evidence?.website ? [project.evidence.website] : undefined,
  codeRepository: project.evidence?.repo
};
---

<BaseLayout
  title={`${project.name} | ${project.status}`}
  description={projectMetaDescription}
  shareTitle={`${project.name} — ${project.status}`}
  shareDescription={project.shareDescription ?? projectMetaDescription}
  canonicalPath={`/projects/${project.slug}/`}
  jsonLd={[projectWebPageJsonLd, projectJsonLd, projectBreadcrumbJsonLd]}
  keywords={projectKeywords}
  ogImagePath="/social/jearonwong-og.png"
  ogImageAlt={`${project.name} — ${project.status} in the Agentic Delivery protocol path and proof path`}
>
  <RegistryPageHero
    title={project.name}
    objectType="PROOF_ROLE"
    objectValue={project.proofRole}
    lead={project.summary}
  >
    <div class="project-hero-links">
      <a href="/projects/" class="registry-annotation hero-link">
        <span class="registry-key">BACK_TO</span>: <span class="registry-value">PROJECTS</span>
      </a>
      <a href={homepageActions.thesis.href} class="registry-annotation hero-link">
        <span class="registry-key">MAINLINE</span>: <span class="registry-value">AI AGENT LIFECYCLE</span>
      </a>
    </div>
  </RegistryPageHero>

  <div class="zone-b page-body page-body--standard">
    <article class="shell proof-shell">
      <section class="proof-grid proof-grid--top">
        <article class="registry-chassis proof-panel">
          <div class="registry-annotation" style="margin-bottom: 0.9rem;">
            <span class="registry-key">WHAT_THIS_IS</span>
          </div>
          <h2 class="proof-panel-title">{project.name} is a proof object in the site thesis chain.</h2>
          <p class="proof-panel-body">{project.whatItIs}</p>
        </article>

        <article class="registry-chassis proof-panel">
          <div class="registry-annotation" style="margin-bottom: 0.9rem;">
            <span class="registry-key">PROBLEM_ADDRESSED</span>
          </div>
          <h2 class="proof-panel-title">The problem it addresses is lifecycle weakness after the demo.</h2>
          <p class="proof-panel-body">{project.problem}</p>
        </article>
      </section>

      <section class="registry-chassis proof-claim">
        <div class="registry-annotation" style="margin-bottom: 1rem;">
          <span class="registry-key">WHAT_THIS_PROVES</span>: <span class="registry-value">{project.proofRole}</span>
        </div>
        <p class="proof-claim-text">{project.proves}</p>
      </section>

      <section class="proof-grid">
        <article class="registry-chassis proof-panel">
          <div class="registry-annotation" style="margin-bottom: 0.9rem;">
            <span class="registry-key">RELATED_IDEAS</span>
          </div>
          <div class="link-stack">
            {(project.relatedIdeas ?? []).map((ideaSlug) => (
              <a href={`/theories/#${ideaSlug}`} class="chain-link">
                {getTheoryClusterName(ideaSlug)}
              </a>
            ))}
          </div>
        </article>

        {relatedConcepts.length > 0 && (
          <article class="registry-chassis proof-panel">
            <div class="registry-annotation" style="margin-bottom: 0.9rem;">
              <span class="registry-key">RELATED_CONCEPTS</span>
            </div>
            <div class="link-stack">
              {relatedConcepts.map((concept) => (
                <a href={`/concepts/${concept.slug}/`} class="chain-link">
                  {concept.term}
                </a>
              ))}
            </div>
          </article>
        )}

        <article class="registry-chassis proof-panel">
          <div class="registry-annotation" style="margin-bottom: 0.9rem;">
            <span class="registry-key">ADJACENT_PROOFS</span>
          </div>
          <div class="link-stack">
            {adjacentProofs.map((adjacent) => (
              <a href={`/projects/${adjacent.slug}/`} class="chain-link">
                {adjacent.name}
              </a>
            ))}
          </div>
        </article>

        {project.relatedEssays && (
          <article class="registry-chassis proof-panel">
            <div class="registry-annotation" style="margin-bottom: 0.9rem;">
              <span class="registry-key">RELATED_ESSAYS</span>
            </div>
            <div class="link-stack">
              {project.relatedEssays.map((essay) => (
                <a href={essay.href} class="chain-link">
                  {essay.label}
                </a>
              ))}
            </div>
          </article>
        )}
      </section>

      <section class="registry-chassis next-step-panel">
        <div class="registry-annotation" style="margin-bottom: 0.9rem;">
          <span class="registry-key">WHERE_TO_GO_NEXT</span>
        </div>
        <div class="link-stack">
          <a href="/lifecycle/" class="chain-link">Return to the AI Agent Lifecycle mainline</a>
          <a href="/essays/" class="chain-link">Read the essay sequence</a>
          <a href="/projects/" class="chain-link">Back to the proof room</a>
          {previousProof && (
            <a href={`/projects/${previousProof.slug}/`} class="chain-link">
              Previous proof: {previousProof.name}
            </a>
          )}
          {nextProof && (
            <a href={`/projects/${nextProof.slug}/`} class="chain-link">
              Next proof: {nextProof.name}
            </a>
          )}
        </div>
        {(previousProof || nextProof) && (
          <p class="next-step-note">
            The proof graph is easier to read in sequence: lifecycle protocol, runtime path, delivery proof path, then evidence adjudication.
          </p>
        )}
      </section>

      <SocialShare
        title={`${project.name} — ${project.status}`}
        description={projectMetaDescription}
        url={projectUrl}
      />
    </article>
  </div>
</BaseLayout>

<style>
  .project-hero-links {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.2rem;
  }

  .hero-link {
    text-decoration: none;
  }

  .hero-link:hover .registry-value {
    color: var(--accent-signal);
  }

  .proof-shell {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .proof-grid--top {
    align-items: stretch;
  }

  .proof-panel {
    padding: var(--registry-card-padding);
  }

  .proof-panel-title {
    margin: 0 0 0.9rem;
    font-size: 1.4rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--current-text);
  }

  .proof-panel-body {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--current-muted);
  }

  .proof-claim {
    padding: var(--registry-panel-padding);
    border-left: 3px solid var(--accent-proof);
  }

  .proof-claim-text {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--current-text);
    max-width: 64ch;
  }

  .next-step-panel {
    padding: var(--registry-card-padding);
  }

  .link-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
  }

  .chain-link {
    color: var(--accent-signal);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .chain-link:hover {
    color: var(--current-text);
  }

  .next-step-note {
    margin: 1rem 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--current-muted);
  }

  @media (max-width: 900px) {
    .proof-grid {
      grid-template-columns: 1fr;
    }

    .proof-panel,
    .proof-claim,
    .next-step-panel {
      padding: var(--registry-card-padding);
    }

    .proof-panel-title {
      font-size: 1.22rem;
    }

    .proof-panel-body,
    .proof-claim-text,
    .chain-link {
      font-size: 0.95rem;
    }

    .next-step-note {
      font-size: 0.9rem;
    }
  }
</style>
