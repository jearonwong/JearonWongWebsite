---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegistryPageHero from "../components/RegistryPageHero.astro";
import { absoluteUrl, createBreadcrumbJsonLd } from "../data/schema";
import { siteConfig } from "../data/site";

const canonicalPath = "/privacy/";
const privacyUrl = absoluteUrl(canonicalPath);
const lastUpdatedIso = "2026-05-28";
const lastUpdatedLabel = "May 28, 2026";
const privacyDescription =
  "Privacy Policy for JearonWong.com, a public headquarters for research papers, essays, project pages, and accountable AI agent lifecycle work.";
const privacyJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${privacyUrl}#webpage`,
  url: privacyUrl,
  name: "Privacy Policy",
  description: privacyDescription,
  datePublished: lastUpdatedIso,
  dateModified: lastUpdatedIso,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  mainEntity: {
    "@id": `${siteConfig.siteUrl}#person`
  }
};
const breadcrumbJsonLd = createBreadcrumbJsonLd(privacyUrl, [
  { name: "Home", path: "/" },
  { name: "Privacy Policy", path: canonicalPath }
]);
---

<BaseLayout
  title="Privacy Policy"
  description={privacyDescription}
  canonicalPath={canonicalPath}
  jsonLd={[privacyJsonLd, breadcrumbJsonLd]}
>
  <RegistryPageHero
    title="Privacy Policy"
    objectType="SITE_RECORD"
    objectValue="PRIVACY POLICY"
    lead="A restrained privacy record for JearonWong.com and its public research, essay, project, and contact surfaces."
  />

  <div class="zone-b page-body page-body--standard">
    <section class="shell shell--reading page-stack page-stack--tight">
      <article class="registry-chassis policy-block">
        <div class="registry-annotation">
          <span class="registry-key">LAST_UPDATED</span>: <span class="registry-value">{lastUpdatedLabel}</span>
        </div>
        <div class="policy-copy">
          <h2>Scope</h2>
          <p>
            JearonWong.com is a public headquarters for research papers, essays, project pages, concepts,
            and contact or outreach paths connected to AI Agent Lifecycle, Agentic Delivery, and MPLP.
          </p>
          <p>
            Public research artifacts on this site may be read in the browser or downloaded as files.
            Accessing those materials may create ordinary server, hosting, browser, or download records.
          </p>
        </div>
      </article>

      <article class="registry-chassis policy-block">
        <div class="policy-copy">
          <h2>Information You Choose To Send</h2>
          <p>
            If you contact Jearon Wong by email or through an external profile linked from this site, the
            information you send may be used to read, route, and respond to that message.
          </p>
          <p>
            Do not submit sensitive personal data, confidential business information, privileged material,
            secrets, or regulated records through public site surfaces unless a future private process
            explicitly says otherwise.
          </p>
        </div>
      </article>

      <article class="registry-chassis policy-block">
        <div class="policy-copy">
          <h2>Analytics, Cookies, And Hosting</h2>
          <p>
            The site may rely on ordinary hosting, content delivery, security, browser, and platform logs.
            If privacy-preserving analytics or cookie-based tools are enabled in the future, they should be
            treated as limited operational measurement rather than identity profiling.
          </p>
          <p>
            External links, social profiles, embedded subscription paths, and third-party platforms are
            governed by their own privacy practices once you leave this site.
          </p>
        </div>
      </article>

      <article class="registry-chassis policy-block">
        <div class="policy-copy">
          <h2>Research Artifact Boundary</h2>
          <p>
            White papers and related artifacts are public research publications. Downloading or citing them
            does not create a confidential relationship, advisory relationship, certification, endorsement,
            audit opinion, insurance opinion, or legal opinion.
          </p>
          <p>
            This policy may be updated as the site evolves. Material changes should be reflected by the
            last updated date on this page.
          </p>
        </div>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .policy-block {
    padding: var(--registry-reading-panel-padding);
  }

  .policy-copy {
    display: grid;
    gap: 0.95rem;
  }

  .policy-copy h2 {
    margin: 0;
    color: var(--current-text);
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    letter-spacing: 0;
  }

  .policy-copy p {
    margin: 0;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.7;
  }
</style>
