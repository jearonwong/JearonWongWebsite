---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import RegistryPageHero from "../components/RegistryPageHero.astro";
import { aiAgentLifecycleColumn, contentRouteRoles, newsletterPromise, pageRegistry, siteConfig } from "../data/site";
import { absoluteUrl, createBreadcrumbJsonLd } from "../data/schema";

const essays = await getCollection("essays", ({ data }) => data.status === "published");
const lifecycleEssays = essays
  .filter((essay) => essay.data.series === aiAgentLifecycleColumn.seriesTitle)
  .sort((left, right) => right.data.publishDate.getTime() - left.data.publishDate.getTime());
const latestEssay = lifecycleEssays[0] ?? essays.find((essay) => essay.id === aiAgentLifecycleColumn.firstPublishedEssay.slug);
const latestEssayCover = latestEssay?.data.images?.[0]?.url ?? aiAgentLifecycleColumn.coverImage;
const latestEssayCoverAlt = latestEssay?.data.images?.[0]?.alt ?? aiAgentLifecycleColumn.coverImageAlt;
const canonicalPath = "/newsletter/";
const newsletterUrl = absoluteUrl(canonicalPath);
const newsletterPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${newsletterUrl}#webpage`,
  url: newsletterUrl,
  name: pageRegistry.newsletter.title,
  description: pageRegistry.newsletter.lead,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  about: newsletterPromise.topics.map((topic) => ({
    "@type": "Thing",
    name: topic
  })),
  breadcrumb: {
    "@id": `${newsletterUrl}#breadcrumb`
  },
  potentialAction: {
    "@type": "SubscribeAction",
    target: siteConfig.newsletterEndpoint
  }
};
const newsletterBreadcrumbJsonLd = createBreadcrumbJsonLd(newsletterUrl, [
  { name: "Home", path: "/" },
  { name: "Newsletter", path: canonicalPath }
]);
---

<BaseLayout
  title="Newsletter"
  description={pageRegistry.newsletter.lead}
  canonicalPath={canonicalPath}
  jsonLd={[newsletterPageJsonLd, newsletterBreadcrumbJsonLd]}
>
  <RegistryPageHero
    title={pageRegistry.newsletter.title}
    objectType={pageRegistry.newsletter.objectType}
    objectValue={pageRegistry.newsletter.objectValue}
    lead={pageRegistry.newsletter.lead}
  />

  <div class="zone-b page-body page-body--standard">
    <section class="shell shell--reading page-stack page-stack--tight">

      <!-- Subscribe form -->
      <article class="registry-chassis subscribe-block">
        <div class="registry-annotation" style="margin-bottom: 1.25rem;">
          <span class="registry-key">SUBSCRIBE</span>
        </div>
        <div class="registry-annotation route-question">
          <span class="registry-key">PAGE_QUESTION</span>: <span class="registry-value">{contentRouteRoles.newsletter.question}</span>
        </div>
        <p class="subscribe-desc">
          {newsletterPromise.headline}
        </p>
        <p class="subscribe-desc subscribe-desc--secondary">
          {newsletterPromise.cadence}
        </p>
        <ul class="topic-list" aria-label="Newsletter topics">
          {newsletterPromise.topics.map((topic) => (
            <li>{topic}</li>
          ))}
        </ul>
        <div class="column-note">
          <div class="registry-annotation" style="margin-bottom: 0.65rem;">
            <span class="registry-key">COLUMN_SIGNAL</span>: <span class="registry-value">{aiAgentLifecycleColumn.seriesTitle.toUpperCase()}</span>
          </div>
          <p>
            The essay sequence now connects the AI Agent Lifecycle origin argument to model governance, Missing Regulatory Objects, RCCS-M, ALCS, and lifecycle responsibility compliance.
          </p>
          {latestEssay && (
            <a href={`/essays/${latestEssay.id}/`} class="current-article-link">
              <img
                src={latestEssayCover}
                alt={latestEssayCoverAlt}
                width={latestEssay.data.images?.[0]?.width ?? 1200}
                height={latestEssay.data.images?.[0]?.height ?? 630}
                loading="lazy"
                decoding="async"
              />
              <span>
                <strong>{latestEssay.data.title}</strong>
                <small>{latestEssay.data.description}</small>
              </span>
            </a>
          )}
          <a href={aiAgentLifecycleColumn.href} class="column-link" data-analytics-event="newsletter_open">Open the AI Agent Lifecycle field definition</a>
          <a href="/concepts/" class="column-link column-link--secondary">Open the Concepts map behind the series</a>
        </div>
        <form
          action={siteConfig.newsletterEndpoint}
          method="post"
          target="popupwindow"
          class="subscribe-form"
          data-subscribe-form
          aria-describedby="subscription-status subscription-boundary"
          data-analytics-event="newsletter_submit"
        >
          <label for="bd-email" class="visually-hidden">Email address</label>
          <input
            type="email"
            name="email"
            id="bd-email"
            placeholder="your@email.com"
            required
            autocomplete="email"
            inputmode="email"
            spellcheck="false"
            class="subscribe-input"
          />
          <button type="submit" class="subscribe-btn">Subscribe</button>
        </form>
        <p id="subscription-status" class="subscription-status" role="status" aria-live="polite" data-state="ready">
          Ready to submit. Buttondown will open its confirmation step.
        </p>
        <div class="registry-annotation" style="margin-top: 1.5rem;">
          <span class="registry-key">FREQUENCY</span>: <span class="registry-value">WHEN THERE IS SUBSTANCE TO REPORT</span>
        </div>
        <p id="subscription-boundary" class="subscribe-boundary">{newsletterPromise.boundary}</p>
        <div class="subscription-ledger">
          <div><span>SUBMISSION_FLOW</span><strong>Buttondown receives the form and handles confirmation.</strong></div>
          <div><span>READER_CONTROL</span><strong>Every issue includes an unsubscribe link managed by Buttondown.</strong></div>
          <div><span>SUCCESS_SIGNAL</span><strong>This page does not claim delivery until the external form confirms it.</strong></div>
        </div>
      </article>

      <!-- RSS alternative -->
      <article class="registry-chassis rss-block">
        <div class="registry-annotation" style="margin-bottom: 1rem;">
          <span class="registry-key">ALTERNATIVE</span>
        </div>
        <p class="rss-desc">Prefer RSS? Subscribe via your reader:</p>
        <a href="/rss.xml" class="rss-link">RSS FEED</a>
      </article>

    </section>
  </div>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  .subscribe-block {
    padding: var(--registry-panel-padding);
  }
  .route-question {
    margin-bottom: 1.25rem;
  }
  .subscribe-desc {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--current-muted);
    max-width: 50ch;
  }
  .subscribe-desc--secondary {
    margin-bottom: 1.5rem;
    font-size: 0.98rem;
  }
  .topic-list {
    display: grid;
    gap: 0.65rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }
  .topic-list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--current-muted);
  }
  .topic-list li::before {
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.36rem;
    height: 0.36rem;
    content: "";
    background: var(--color-meta);
    border-radius: 999px;
  }
  .column-note {
    margin: 0 0 2rem;
    padding: 1rem;
    border: 1px solid var(--current-line);
  }
  .column-note p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--current-muted);
  }
  .current-article-link {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    margin-top: 1rem;
    color: var(--current-text);
    text-decoration: none;
  }
  .current-article-link img {
    width: 100%;
    height: auto;
    border: 1px solid var(--current-line);
    background: #111111;
  }
  .current-article-link span {
    display: grid;
    gap: 0.25rem;
  }
  .current-article-link strong {
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .current-article-link small {
    color: var(--current-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }
  .current-article-link:hover strong {
    color: var(--color-action);
  }
  .column-link {
    display: inline-flex;
    margin-top: 0.85rem;
    margin-right: 1rem;
    color: var(--color-action);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .column-link:hover {
    color: var(--current-text);
  }
  .column-link--secondary {
    color: var(--current-text);
  }
  .subscribe-form {
    display: flex;
    gap: 0;
  }
  .subscribe-input {
    flex: 1;
    padding: 0.8rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-right: none;
    border-radius: 2px 0 0 2px;
    background: white;
    color: #111;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .subscribe-input:focus {
    border-color: var(--color-action);
  }
  .subscribe-input::placeholder {
    color: #94a3b8;
  }
  .subscribe-btn {
    padding: 0.8rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--color-action);
    color: white;
    border: 1px solid var(--color-action);
    border-radius: 0 2px 2px 0;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .subscribe-btn:hover {
    opacity: 0.85;
  }
  .subscribe-boundary {
    margin: 0.8rem 0 0;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--current-muted);
  }
  .subscription-status {
    margin: 0.75rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--color-meta);
  }
  .subscription-status[data-state="submitted"] {
    color: var(--color-action);
  }
  .subscription-status[data-state="error"] {
    color: var(--color-danger, #a33a32);
  }
  .subscription-ledger {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--current-line);
  }
  .subscription-ledger > div {
    display: grid;
    gap: 0.25rem;
  }
  .subscription-ledger span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--color-meta);
  }
  .subscription-ledger strong {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--current-muted);
  }
  .rss-block {
    padding: var(--registry-card-padding);
  }
  .rss-desc {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    color: var(--current-muted);
  }
  .rss-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--current-text);
    border: 1px solid var(--current-border);
    border-radius: 2px;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  .rss-link:hover {
    border-color: var(--color-action);
    color: var(--color-action);
  }
  @media (max-width: 640px) {
    .subscribe-block, .rss-block {
      padding: var(--registry-card-padding);
    }
    .subscribe-form {
      flex-direction: column;
      gap: 0.6rem;
    }
    .subscribe-input {
      border-right: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 2px;
    }
    .subscribe-btn {
      border-radius: 2px;
    }
    .current-article-link {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const subscribeForms = document.querySelectorAll<HTMLFormElement>("[data-subscribe-form]");

  subscribeForms.forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>("[data-state]");
    const emailInput = form.querySelector<HTMLInputElement>("input[type='email']");
    if (!status || !emailInput) return;

    const updateStatus = (message: string, state: "ready" | "submitted" | "error") => {
      status.textContent = message;
      status.dataset.state = state;
    };

    form.addEventListener("invalid", () => {
      emailInput.setAttribute("aria-invalid", "true");
      updateStatus("Unable to submit: enter a valid email address.", "error");
    }, true);

    emailInput.addEventListener("input", () => {
      emailInput.removeAttribute("aria-invalid");
      if (status.dataset.state === "error") {
        updateStatus("Ready to submit. Buttondown will open its confirmation step.", "ready");
      }
    });

    form.addEventListener("submit", () => {
      updateStatus("Submitted to Buttondown. Complete the confirmation step in the opened window.", "submitted");
    });
  });
</script>
