---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PortraitAnchor from "../components/PortraitAnchor.astro";
import ReadingFlowDiagram from "../components/ReadingFlowDiagram.astro";
import {
  homepageContent,
  homepageActions,
  siteConfig,
  projects,
  siteSemanticBaseline
} from "../data/site";
import { absoluteUrl, createBreadcrumbJsonLd, siteEntityTerms } from "../data/schema";
import { whitepaperPublications } from "../data/whitepaperPublications";

const allEssays = (await getCollection("essays", ({ data }) => data.status === "published"))
  .sort((left, right) => right.data.publishDate.getTime() - left.data.publishDate.getTime());
const latestEssay = allEssays[0];
const research = whitepaperPublications[0];
const protocolProject = projects.find((project) => project.slug === "mplp");
const proofProjects = projects.filter((project) => project.slug !== "mplp").slice(0, 3);
const lifecycleReadingPath = allEssays
  .filter((essay) => essay.data.series === "Define The AI Agent Lifecycle" && Number.isFinite(essay.data.seriesOrder))
  .sort((left, right) => (left.data.seriesOrder ?? 0) - (right.data.seriesOrder ?? 0))
  .slice(0, 4);


const canonicalPath = "/";
const homepageUrl = absoluteUrl(canonicalPath);
const homepageDescription =
  "Jearon Wong, Protocol Architect for the Agent Era, defines AI Agent Lifecycle, Agentic Delivery, and MPLP for accountable AI agent work from intent to outcome.";
const homepageDatePublished = "2026-04-23";
const homepageDateModified = siteConfig.homepageLastModified;
const homepageKeywords = [
  "Jearon Wong",
  "Protocol Architect for the Agent Era",
  "AI Agent Lifecycle",
  "Agentic Lifecycle Governance",
  "AI Agent Governance",
  "Agentic Delivery",
  "MPLP",
  "Missing Regulatory Objects",
  "RCCS-M",
  "ALCS"
];
const homepageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${homepageUrl}#webpage`,
  url: homepageUrl,
  name: siteConfig.title,
  headline: "Jearon Wong — Protocol Architect for the Agent Era",
  description: homepageDescription,
  datePublished: homepageDatePublished,
  dateModified: homepageDateModified,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  publisher: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  about: siteEntityTerms.map((term) => ({
    "@type": "Thing",
    name: term
  })),
  mainEntity: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  hasPart: [
    {
      "@type": "CollectionPage",
      name: "Concepts for AI Agent Lifecycle",
      url: absoluteUrl("/concepts/")
    },
    {
      "@type": "WebPage",
      name: "Concepts Map / Entity Mesh",
      url: absoluteUrl("/concepts/map/")
    },
    {
      "@type": "TechArticle",
      name: "Global AI Compliance White Paper 2026",
      url: absoluteUrl("/research/global-ai-compliance-white-paper-2026/")
    },
    {
      "@type": "TechArticle",
      name: "Agentic AI Auditability & Assurance White Paper 2026",
      url: absoluteUrl("/research/agentic-ai-auditability-assurance-white-paper-2026/")
    },
    {
      "@type": "TechArticle",
      name: "Agentic AI Insurability & Risk Transfer White Paper 2026",
      url: absoluteUrl("/research/agentic-ai-insurability-risk-transfer-white-paper-2026/")
    },
    {
      "@type": "CollectionPage",
      name: "Systems Discussed in the Global AI Compliance White Paper 2026",
      url: absoluteUrl("/research/global-ai-compliance-white-paper-2026/systems/")
    },
    {
      "@type": "WebPage",
      name: "Agentic Lifecycle Governance",
      url: absoluteUrl("/concepts/agentic-lifecycle-governance/")
    },
    {
      "@type": "WebPage",
      name: "Deterministic Delivery",
      url: absoluteUrl("/concepts/deterministic-delivery/")
    },
    {
      "@type": "CollectionPage",
      name: "Applied Agentic Governance Playbooks",
      url: absoluteUrl("/playbooks/")
    },
    {
      "@type": "CollectionPage",
      name: "Extended Ecosystem Lifecycle Governance Mapping",
      url: absoluteUrl("/mapping/extended-ecosystem/")
    },
    {
      "@type": "CollectionPage",
      name: "AI Agent Governance and Lifecycle Responsibility",
      url: absoluteUrl("/governance/")
    }
  ]
};
const profilePageJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${homepageUrl}#profile`,
  url: homepageUrl,
  name: "Jearon Wong",
  description: homepageDescription,
  datePublished: homepageDatePublished,
  dateModified: homepageDateModified,
  mainEntity: {
    "@id": `${siteConfig.siteUrl}#person`
  }
};
const homepageBreadcrumbJsonLd = createBreadcrumbJsonLd(homepageUrl, [
  { name: "Home", path: "/" }
]);
---

<BaseLayout
  title={siteConfig.title}
  description={homepageDescription}
  canonicalPath={canonicalPath}
  shareTitle={siteSemanticBaseline.identityAnchor}
  shareDescription={homepageDescription}
  twitterTitle={siteSemanticBaseline.identityAnchor}
  twitterDescription={homepageDescription}
  jsonLd={[homepageJsonLd, profilePageJsonLd, homepageBreadcrumbJsonLd]}
  keywords={homepageKeywords}
  ogImagePath="/social/jearonwong-og.png"
  ogImageAlt={`${siteSemanticBaseline.identityAnchor}: AI Agent Lifecycle and accountable delivery.`}
>
  <!-- Research Ledger hero: the thesis stays visible before the records. -->
  <header class="ledger-banner homepage-ledger-banner">
    <div class="ledger-hero">
      <div class="homepage-hero__heading">
        <span class="prototype-label">PERSONAL RESEARCH LEDGER</span>
        <h1>{homepageContent.hero.authorAnchor}</h1>
        <p class="homepage-hero__role">{homepageContent.hero.role}</p>
      </div>
      <div class="homepage-hero__portrait">
        <PortraitAnchor />
      </div>
      <div class="homepage-hero__support">
        <p class="ledger-hero__lead">{siteSemanticBaseline.fieldDefinitionStatement}</p>
        <p class="homepage-hero__thesis">{siteSemanticBaseline.problemStatement}</p>
        <p class="ledger-hero__support">{siteSemanticBaseline.mplpProtocolRelation}</p>
        <div class="prototype-button-row homepage-hero-actions">
          <a class="prototype-button prototype-button--solid" href={homepageActions.thesis.href}>{homepageActions.thesis.label}</a>
          <a class="prototype-button prototype-button--ghost" href="/about/">About Jearon Wong</a>
        </div>
      </div>
      <aside class="ledger-hero__rail" aria-label="Ledger orientation">
        <p>The author defines the field. The ledger records the arguments, protocol path, and proof that follow it.</p>
        <dl>
          <dt>Author</dt><dd>{siteConfig.author.name}</dd>
          <dt>Field</dt><dd>AI Agent Lifecycle</dd>
          <dt>Category</dt><dd>Agentic Delivery</dd>
          <dt>Protocol</dt><dd>MPLP</dd>
          <dt>Proof surfaces</dt><dd>{proofProjects.length} active paths</dd>
        </dl>
      </aside>
    </div>
  </header>

  <div class="prototype-shell ledger-body homepage-ledger-body">
    <nav class="ledger-rail" aria-label="Ledger sections">
      <a href="#thesis">01 / Thesis</a>
      <a href="#current-signal">02 / Current signal</a>
      <a href="#protocol-path">03 / Protocol path</a>
      <a href="#proof-path">04 / Proof path</a>
      <a href="#research">05 / Selected research</a>
      <a href="#start-here">06 / Start here</a>
    </nav>

    <div class="ledger-main">
      <section class="ledger-section" id="thesis">
        <div class="ledger-section__heading">
          <h2>The thesis</h2>
          <span class="ledger-section__count">Field definition</span>
        </div>
        <article class="ledger-feature">
          <div>
            <h3><a href={homepageActions.thesis.href}>AI Agent Lifecycle</a></h3>
            <p>{siteSemanticBaseline.fieldDefinitionStatement}</p>
            <p class="ledger-feature__support">{siteSemanticBaseline.agenticDeliveryDefinition}</p>
          </div>
          <div class="ledger-feature__meta">
            <div class="ledger-meta-row"><span>Problem</span><span>{siteSemanticBaseline.problemStatement}</span></div>
            <div class="ledger-meta-row"><span>Protocol</span><span>MPLP / {siteSemanticBaseline.projectRoles.mplp}</span></div>
            <div class="ledger-meta-row"><span>Proof</span><span>{siteSemanticBaseline.projectRoles.cognitiveOS} · {siteSemanticBaseline.projectRoles.soloCrew} · {siteSemanticBaseline.projectRoles.validationLab}</span></div>
          </div>
        </article>
      </section>

      <ReadingFlowDiagram
        variant="projects"
        title="The public argument follows one path."
        description={siteSemanticBaseline.referencePathDefinition}
      />

      <section class="ledger-section" id="current-signal">
        <div class="ledger-section__heading">
          <h2>Current signal</h2>
          <span class="ledger-section__count">Latest published record</span>
        </div>
        {latestEssay && (
          <article class="ledger-feature">
            <div>
              <h3><a href={`/essays/${latestEssay.id}/`}>{latestEssay.data.title}</a></h3>
              <p>{latestEssay.data.description}</p>
            </div>
            <div class="ledger-feature__meta">
              <div class="ledger-meta-row"><span>Class</span><span>{latestEssay.data.publicationClass}</span></div>
              <div class="ledger-meta-row"><span>Track</span><span>{latestEssay.data.editorialTrack ?? latestEssay.data.track ?? latestEssay.data.cluster}</span></div>
              <div class="ledger-meta-row"><span>Date</span><span>{latestEssay.data.publishDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" })}</span></div>
            </div>
          </article>
        )}
      </section>

      <section class="ledger-section" id="protocol-path">
        <div class="ledger-section__heading">
          <h2>Protocol path</h2>
          <span class="ledger-section__count">Open, vendor-neutral protocol</span>
        </div>
        {protocolProject && (
          <article class="ledger-feature">
            <div>
              <h3><a href={`/projects/${protocolProject.slug}/`}>{protocolProject.name}</a></h3>
              <p>{siteSemanticBaseline.mplpFormalDefinition}</p>
              <p class="ledger-feature__support">{siteSemanticBaseline.mplpProtocolRelation}</p>
            </div>
            <div class="ledger-feature__meta">
              <div class="ledger-meta-row"><span>Role</span><span>{siteSemanticBaseline.projectRoles.mplp}</span></div>
              <div class="ledger-meta-row"><span>Scope</span><span>Cross-model, cross-runtime lifecycle semantics</span></div>
              <div class="ledger-meta-row"><span>Boundary</span><span>Protocol foundation, not a complete runtime or certification</span></div>
            </div>
          </article>
        )}
      </section>

      <section class="ledger-section" id="proof-path">
        <div class="ledger-section__heading">
          <h2>Proof path</h2>
          <span class="ledger-section__count">{proofProjects.length} role-separated records</span>
        </div>
        <p class="ledger-section__intro">{homepageContent.proofPath.description}</p>
        {proofProjects.map((project, index) => (
          <article class="ledger-record">
            <span class="ledger-record__index">{String(index + 1).padStart(2, "0")}</span>
            <div class="ledger-record__title">
              <a href={`/projects/${project.slug}/`}>{project.name}</a>
              <span class="ledger-record__role">{project.proofRole}</span>
            </div>
            <div class="ledger-record__description">{project.summary} {project.deliveryState}.</div>
            <span class="ledger-record__arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </section>

      <section class="ledger-section" id="research">
        <div class="ledger-section__heading">
          <h2>Selected research</h2>
          <span class="ledger-section__count">{whitepaperPublications.length} public editions</span>
        </div>
        {research && (
          <article class="ledger-feature">
            <div>
              <h3><a href={research.canonicalPath}>{research.title}</a></h3>
              <p>{research.oneLinePositioning}</p>
              <p class="ledger-feature__support">{research.citationUse}</p>
            </div>
            <div class="ledger-feature__meta">
              <div class="ledger-meta-row"><span>Edition</span><span>{research.versionLabel}</span></div>
              <div class="ledger-meta-row"><span>Role</span><span>{research.artifactRole}</span></div>
              <div class="ledger-meta-row"><span>Route</span><span>Research ledger</span></div>
            </div>
          </article>
        )}
      </section>

      <section class="ledger-section" id="start-here">
        <div class="ledger-section__heading">
          <h2>Start here</h2>
          <span class="ledger-section__count">3 routes + 1 sequence</span>
        </div>
        {homepageContent.readerRoutes.slice(0, 3).map((route) => (
          <article class="ledger-record">
            <span class="ledger-record__kind">{route.eyebrow}</span>
            <div class="ledger-record__title"><a href={route.href}>{route.title}</a></div>
            <div class="ledger-record__description">{route.body}</div>
            <span class="ledger-record__arrow" aria-hidden="true">↗</span>
          </article>
        ))}
        {lifecycleReadingPath.length > 0 && (
          <article class="ledger-record ledger-reading-path">
            <span class="ledger-record__kind">Sequence</span>
            <div class="ledger-reading-path__links">
              {lifecycleReadingPath.map((essay, index) => (
                <span class="ledger-reading-path__item">
                  {index > 0 && <span aria-hidden="true"> / </span>}
                  <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
                </span>
              ))}
            </div>
            <div class="ledger-record__description">Define The AI Agent Lifecycle</div>
            <span class="ledger-record__arrow" aria-hidden="true">↗</span>
          </article>
        )}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero-wrapper {
    position: relative;
    overflow: hidden;
    min-height: auto;
  }
  .hero-section {
    min-height: min(88svh, 820px);
    display: flex;
    align-items: center;
    padding-top: clamp(6.75rem, 7.2vw, 7.85rem);
    padding-bottom: clamp(4.75rem, 6vw, 6rem);
  }
  .hero-content {
    max-width: 43rem;
  }
  .hero-eyebrow {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.42rem;
    margin-bottom: clamp(1.2rem, 1.8vw, 1.6rem);
    color: var(--text-registry-muted);
    font-size: 0.75rem;
    line-height: 1.55;
    letter-spacing: 0.075em;
    max-width: min(100%, 48ch);
  }
  .hero-eyebrow span {
    max-width: 100%;
    white-space: normal;
    overflow-wrap: break-word;
  }
  .hero-eyebrow-separator {
    color: var(--color-meta-dark);
  }
  .hero-subclaim {
    margin: 0 0 1.45rem;
    max-width: 39rem;
    color: rgba(241, 245, 249, 0.9);
    font-size: clamp(1.35rem, 1.9vw, 1.74rem);
    font-weight: 640;
    letter-spacing: 0;
    line-height: 1.18;
  }
  .hero-body {
    max-width: 42ch;
    margin: 0 0 1.8rem;
    color: var(--color-meta-dark);
    font-size: clamp(1rem, 1.16vw, 1.08rem);
    line-height: 1.64;
    font-weight: 400;
  }
  .hero-author-anchor {
    display: grid;
    gap: 0.28rem;
    width: fit-content;
    margin-bottom: 1.65rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .hero-author-name {
    font-weight: 740;
    color: var(--text-registry-primary);
    letter-spacing: 0;
    font-size: 1.08rem;
  }
  .hero-role-line {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.065em;
    color: var(--color-meta-dark);
    font-weight: 600;
    line-height: 1.45;
    max-width: 44ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* -- Reader routes -- */
  .reader-routes-band {
    padding: clamp(3rem, 6vw, 5.5rem) 0 clamp(3.5rem, 6vw, 6rem);
    border-bottom: 1px solid var(--current-line);
  }
  .reader-roles-band {
    padding: clamp(2.6rem, 5vw, 4.4rem) 0;
    border-bottom: 1px solid var(--current-line);
  }
  .reader-roles-band h2 {
    max-width: 20ch;
    margin: 0.8rem 0 1.6rem;
    font-size: clamp(1.7rem, 3vw, 2.45rem);
    line-height: var(--type-section-title-line-height);
    letter-spacing: var(--type-section-title-letter-spacing);
    word-spacing: var(--type-section-title-word-spacing);
  }
  .reader-role-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--current-line);
    border: 1px solid var(--current-line);
  }
  .reader-role-card {
    display: grid;
    gap: 0.7rem;
    min-height: 10rem;
    padding: 1rem;
    background: var(--current-surface);
    color: inherit;
    text-decoration: none;
  }
  .reader-role-card:hover {
    background: var(--color-action-soft);
  }
  .reader-role-card span,
  .reader-role-card em {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-style: normal;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-meta);
  }
  .reader-role-card strong {
    font-size: 1rem;
    line-height: 1.4;
    color: var(--current-text);
  }
  .reader-role-card em {
    align-self: end;
    color: var(--current-muted);
  }

  .reader-routes-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    margin-bottom: 2.25rem;
  }

  .reader-routes-header h2 {
    max-width: 17ch;
    margin: 0.8rem 0 0;
    color: var(--current-text);
    font-size: clamp(2rem, 4vw, 3.3rem);
    line-height: var(--type-section-title-line-height);
    letter-spacing: var(--type-section-title-letter-spacing);
    word-spacing: var(--type-section-title-word-spacing);
  }

  .reader-routes-header p {
    max-width: 42ch;
    margin: 0;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .reader-route-list {
    border-top: 1px solid var(--current-line);
  }

  .reader-route-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(10rem, 0.38fr);
    gap: 1.25rem;
    align-items: center;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--current-line);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease, padding-inline 0.2s ease;
  }

  .reader-route-row:hover {
    padding-inline: 0.8rem;
    background: var(--color-action-soft);
  }

  .reader-route-index,
  .reader-route-eyebrow,
  .reader-route-action {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .reader-route-index {
    color: var(--color-meta);
  }

  .reader-route-copy {
    display: grid;
    gap: 0.28rem;
    min-width: 0;
  }

  .reader-route-eyebrow {
    color: var(--color-meta);
  }

  .reader-route-copy strong {
    color: var(--current-text);
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .reader-route-copy > span:last-child {
    max-width: 62ch;
    color: var(--current-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .reader-route-action {
    justify-self: end;
    color: var(--color-action);
    text-align: right;
  }

  .reader-route-action span {
    display: inline-block;
    margin-left: 0.35rem;
    transition: transform 0.2s ease;
  }

  .reader-route-row:hover .reader-route-action span {
    transform: translateX(3px);
  }

  /* -- Research Series -- */
  .research-series-band {
    padding: clamp(2.5rem, 5vw, 4.75rem) 0;
    background:
      linear-gradient(rgba(17, 17, 17, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 17, 17, 0.025) 1px, transparent 1px),
      #f8fafc;
    background-size: 40px 40px;
    border-top: 1px solid rgba(17, 17, 17, 0.08);
    border-bottom: 1px solid rgba(17, 17, 17, 0.08);
  }

  .research-series-panel {
    display: grid;
    gap: clamp(1.4rem, 3vw, 2.2rem);
    padding: var(--registry-panel-padding);
    background: #ffffff;
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-left: 4px solid var(--color-rule);
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.06);
  }

  .research-series-label {
    margin-bottom: 1rem;
  }

  .research-series-panel h2 {
    max-width: 20ch;
    margin: 0;
    color: #111111;
    font-size: clamp(2rem, 4vw, 3.35rem);
    line-height: var(--type-section-title-line-height);
    letter-spacing: var(--type-section-title-letter-spacing);
    word-spacing: var(--type-section-title-word-spacing);
  }

  .research-series-thesis {
    max-width: 48rem;
    margin: 1rem 0 0;
    color: #111111;
    font-size: clamp(1.08rem, 1.55vw, 1.28rem);
    font-weight: 650;
    line-height: 1.5;
  }

  .research-series-stack {
    position: relative;
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .research-series-stack::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 clamp(3.4rem, 6vw, 5.2rem);
    width: 1px;
    background: linear-gradient(180deg, rgba(17, 17, 17, 0.16), rgba(17, 17, 17, 0.04));
  }

  .research-series-item {
    position: relative;
    min-width: 0;
  }

  .research-series-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(6.2rem, 0.22fr) minmax(0, 1fr);
    gap: clamp(1rem, 2.8vw, 2rem);
    align-items: start;
    min-width: 0;
    padding: clamp(1.15rem, 2.5vw, 1.8rem);
    background: #ffffff;
    border: 1px solid rgba(17, 17, 17, 0.12);
  }

  .research-series-item--foundation .research-series-card {
    background: #fbfdff;
    border-left: 4px solid var(--color-rule);
  }

  .research-series-marker {
    display: grid;
    gap: 0.45rem;
    align-content: start;
    min-width: 0;
  }

  .research-series-number {
    display: inline-flex;
    width: 3.1rem;
    height: 3.1rem;
    align-items: center;
    justify-content: center;
    background: #111111;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .research-series-item--foundation .research-series-number {
    background: #111418;
    color: #ffffff;
  }

  .research-series-role {
    max-width: 12rem;
    color: #111111;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .research-series-role::before {
    content: "/ ";
    color: rgba(17, 17, 17, 0.45);
  }

  .research-series-copy {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .research-series-card-label {
    color: var(--color-meta);
  }

  .research-series-card h3 {
    margin: 0;
    color: #111111;
    font-size: clamp(1.35rem, 2.2vw, 2rem);
    line-height: var(--type-card-title-line-height);
    letter-spacing: var(--type-card-title-letter-spacing);
    word-spacing: var(--type-card-title-word-spacing);
  }

  .research-series-card p {
    max-width: 58ch;
    margin: 0;
    color: #525252;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .research-series-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .research-series-meta span {
    border: 1px solid rgba(17, 17, 17, 0.14);
    padding: 0.42rem 0.55rem;
    font-family: var(--font-mono);
    color: #525252;
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .research-series-actions,
  .research-series-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .research-series-count {
    align-self: center;
    margin-right: auto;
    color: #525252;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .research-series-actions .button {
    text-align: center;
    text-decoration: none;
    white-space: normal;
  }

  .research-series-actions .button-primary {
    background: #111111;
    border-color: #111111;
    color: #ffffff;
  }

  .research-series-actions .button-primary:hover {
    background: #000000;
    border-color: #000000;
  }

  .research-series-actions .button-outline {
    background: transparent;
    border-color: rgba(17, 17, 17, 0.18);
    color: #111111;
  }

  .research-series-actions .button-outline:hover {
    border-color: var(--color-action);
    color: var(--color-action);
  }

  .research-series-actions .button-disabled,
  .research-series-actions .button-disabled:hover {
    cursor: not-allowed;
    opacity: 0.62;
    border-color: rgba(17, 17, 17, 0.18);
    color: #525252;
  }

  /* ── Sections ── */
  .section-header h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.35rem);
    line-height: var(--type-section-title-line-height);
    letter-spacing: var(--type-section-title-letter-spacing);
    word-spacing: var(--type-section-title-word-spacing);
    font-weight: 800;
    margin-bottom: 0.6rem;
  }
  .section-desc {
    font-size: 1rem;
    color: var(--current-muted);
    line-height: 1.6;
    max-width: min(100%, 58rem);
    margin-bottom: 0.25rem;
  }
  .section-link {
    display: inline-flex;
    align-items: center;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-action);
    text-decoration: none;
  }
  .section-link:hover {
    color: var(--color-action);
  }
  .section-header {
    margin-bottom: 3.5rem;
  }

  .lifecycle-category-bridge {
    padding-top: 7rem;
    padding-bottom: 2rem;
  }

  .lifecycle-bridge-panel {
    padding: var(--registry-panel-padding);
    border-left: 2px solid var(--color-rule);
  }

  .lifecycle-bridge-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2.5rem;
    align-items: start;
  }

  .lifecycle-bridge-grid h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    line-height: var(--type-section-title-line-height);
    letter-spacing: var(--type-section-title-letter-spacing);
    word-spacing: var(--type-section-title-word-spacing);
    color: var(--current-text);
  }

  .lifecycle-bridge-copy p {
    margin: 0;
    max-width: 54rem;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .lifecycle-bridge-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }

  /* ── Core Thesis ── */
  .core-thesis-band {
    padding: var(--space-page-y) 0;
    border-top: 1px solid var(--border-registry);
    border-bottom: 1px solid var(--border-registry);
  }

  .core-thesis-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 4rem;
    align-items: center;
  }

  .core-thesis-eyebrow {
    margin-bottom: 1rem;
  }

  .core-thesis-copy h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: var(--type-section-title-line-height);
    letter-spacing: var(--type-section-title-letter-spacing);
    word-spacing: var(--type-section-title-word-spacing);
    margin: 0 0 1.35rem;
    font-weight: 800;
  }

  .core-thesis-copy p {
    max-width: 42rem;
    margin: 0;
    color: var(--text-registry-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .core-thesis-copy p + p {
    margin-top: 1rem;
  }

  .core-thesis-copy strong {
    color: var(--text-registry-primary);
  }

  .thesis-compare {
    padding: var(--registry-card-padding);
    background-color: rgba(10, 10, 10, 0.54);
  }

  .compare-track {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .compare-track + .compare-track {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-registry);
  }

  .compare-label {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-meta);
  }

  .compare-track--delivery .compare-label {
    color: var(--color-meta);
  }

  .compare-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    min-width: 0;
  }

  .compare-flow--delivery {
    display: grid;
    gap: 0.62rem;
  }

  .compare-flow-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .compare-flow-row--continuation {
    padding-left: 0;
  }

  .compare-step {
    padding: 0.42rem 0.62rem;
    border: 1px solid var(--border-registry);
    background: rgba(255, 255, 255, 0.035);
    color: var(--text-registry-primary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
    text-align: center;
  }

  .compare-arrow {
    color: var(--text-registry-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  /* ── Card Grid ── */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.1rem;
    align-items: stretch;
  }
  .card-grid :global(.evidence-record) {
    height: 100%;
  }

  /* ── Reading Path ── */
  .reading-path-list {
    display: grid;
    gap: 1rem;
  }

  .reading-path-card {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1.25rem;
    background: var(--current-surface);
    border: 1px solid var(--current-border);
    border-left: 4px solid var(--color-rule);
    border-radius: var(--radius-module);
    padding: var(--registry-card-padding);
  }

  .reading-path-index {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-meta);
  }

  .reading-path-content h3 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    letter-spacing: var(--type-card-title-letter-spacing);
    line-height: var(--type-card-title-line-height);
    word-spacing: var(--type-card-title-word-spacing);
  }

  .reading-path-content h3 a {
    color: inherit;
    text-decoration: none;
  }

  .reading-path-content h3 a:hover {
    color: var(--color-action);
  }

  .reading-path-content p {
    color: var(--current-muted);
    line-height: 1.6;
    max-width: 60ch;
    margin: 0;
  }

  /* ── Writing Tracks ── */
  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0;
  }
  .track-item {
    padding: 1.5rem 1.5rem 1.5rem 0;
    border-bottom: 1px solid var(--current-line);
  }
  .track-name {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-meta);
    margin-bottom: 0.5rem;
  }
  .track-desc {
    font-size: 0.9rem;
    color: var(--current-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Quiet Close ── */
  .quiet-close {
    padding-bottom: 2rem;
  }
  .close-content h2 {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    line-height: var(--type-card-title-line-height);
    letter-spacing: var(--type-card-title-letter-spacing);
    word-spacing: var(--type-card-title-word-spacing);
  }
  .close-actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .close-social {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .social-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--current-muted);
    border: 1px solid var(--current-border);
    border-radius: 2px;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .social-pill:hover {
    border-color: var(--color-action);
    color: var(--color-action);
  }

  /* ── Layout ── */
  .split-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(380px, 0.45fr);
    gap: clamp(3rem, 4.5vw, 4.75rem);
    align-items: center;
    width: 100%;
  }
  .hero-visual {
    justify-self: end;
    align-self: center;
    width: min(100%, 33.5rem);
    padding-top: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .reader-role-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .split-layout {
      gap: 2.75rem;
      grid-template-columns: 1fr;
      align-items: start;
    }
    .hero-visual {
      justify-self: start;
      width: min(100%, 26rem);
      padding-top: 0;
    }
  }

  @media (max-width: 980px) {
    .card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (max-width: 900px) {
    .split-layout {
      grid-template-columns: 1fr;
      gap: 2.35rem;
    }
    .hero-section {
      min-height: auto;
      padding-top: 6.1rem;
      padding-bottom: 4.25rem;
    }
    .research-series-stack::before {
      left: 1.55rem;
    }
    .research-series-card {
      grid-template-columns: 4.2rem minmax(0, 1fr);
      gap: 1rem;
    }
    .research-series-number {
      width: 3rem;
      height: 3rem;
    }
    .research-series-role {
      font-size: 0.65rem;
    }

    .reader-routes-header {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .reader-routes-header h2 {
      max-width: 20ch;
    }

    .reader-route-row {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 0.85rem;
    }

    .reader-route-action {
      grid-column: 2;
      justify-self: start;
      text-align: left;
    }
  }

  @media (max-width: 768px) {
    .reader-role-grid {
      grid-template-columns: 1fr;
    }
    .hero-section {
      padding-top: 6rem;
      padding-bottom: 4rem;
    }
    .hero-eyebrow {
      gap: 0.34rem;
      margin-bottom: 1rem;
      font-size: 0.68rem;
    }
    .hero-subclaim {
      font-size: clamp(1.08rem, 5vw, 1.24rem);
      line-height: 1.24;
      max-width: 27ch;
      margin-bottom: 1.2rem;
    }
    .hero-body {
      font-size: 1rem;
      max-width: 34ch;
      margin-bottom: 1.45rem;
    }
    .hero-role-line {
      max-width: 31ch;
    }
    .hero-author-anchor {
      margin-bottom: 1.35rem;
      padding-top: 0.85rem;
    }
    .hero-visual {
      width: min(100%, 21.25rem);
    }
    .hero-ctas {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.55rem;
      width: min(100%, 22rem);
      max-width: calc(100vw - 2rem);
    }
    .hero-ctas .button {
      width: 100%;
      min-height: 2.65rem;
      padding-inline: 0.7rem;
      font-size: 0.82rem;
      text-align: center;
      white-space: normal;
    }
    .section-header {
      margin-bottom: 2.5rem;
    }
    .research-series-panel,
    .research-series-card {
      padding: var(--registry-card-padding);
    }
    .research-series-stack::before {
      display: none;
    }
    .research-series-card {
      grid-template-columns: 1fr;
    }
    .research-series-marker {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
    }
    .research-series-actions .button {
      width: 100%;
    }
    .lifecycle-category-bridge {
      padding-top: var(--space-section-y-mobile);
      padding-bottom: var(--space-3);
    }
    .lifecycle-bridge-panel {
      padding: var(--registry-card-padding);
    }
    .lifecycle-bridge-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .core-thesis-band {
      padding: var(--space-section-y-mobile) 0;
    }
    .core-thesis-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .thesis-compare {
      padding: var(--registry-card-padding);
    }
    .compare-track {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
    .compare-label {
      margin-top: 0;
      margin-bottom: 0;
    }
    .tracks-grid {
      grid-template-columns: 1fr;
    }
    .reading-path-card {
      padding: var(--registry-card-padding);
    }
  }

  @media (max-width: 620px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
    .compare-flow--delivery {
      gap: 0.5rem;
    }
    .compare-track--delivery .compare-flow-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }
    .compare-track--delivery .compare-arrow {
      display: none;
    }
    .compare-track--delivery .compare-step {
      width: 100%;
      min-height: 2rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .compare-flow-row--continuation .compare-step:last-child {
      grid-column: 1 / -1;
    }
    .reading-path-card {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }

  .homepage-ledger-banner .ledger-hero h1 {
    width: 100%;
    max-width: none;
    margin: 0.85rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.65rem, 6.3vw, 5.5rem);
    font-weight: 650;
    letter-spacing: var(--type-hero-display-letter-spacing);
    line-height: var(--type-hero-display-line-height);
    word-spacing: var(--type-hero-display-word-spacing);
    text-wrap: balance;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .homepage-ledger-banner .ledger-hero {
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.6fr) minmax(13.5rem, 0.55fr);
    grid-template-areas:
      "heading portrait rail"
      "support portrait rail";
    column-gap: clamp(1.5rem, 3.4vw, 3rem);
    row-gap: 1.5rem;
    align-items: start;
    padding-top: clamp(2.75rem, 4.5vw, 3.75rem);
    padding-bottom: clamp(3rem, 5vw, 4rem);
  }

  .homepage-hero__heading { grid-area: heading; min-width: 0; }
  .homepage-hero__support { grid-area: support; min-width: 0; }
  .homepage-hero__portrait {
    grid-area: portrait;
    align-self: center;
    justify-self: end;
    width: min(100%, 18.5rem);
    min-width: 0;
  }
  .homepage-ledger-banner .ledger-hero__rail {
    grid-area: rail;
    align-self: center;
  }

  .homepage-hero__role {
    margin: 0.7rem 0 0;
    color: #c2cad3;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: 520;
    line-height: 1.25;
  }

  .homepage-hero__thesis {
    margin: 1.2rem 0 0;
    color: #f4f7fb;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .ledger-hero__support {
    max-width: 44ch;
    margin: 1.35rem 0 0;
    color: #8f9baa;
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .homepage-hero-actions {
    margin-top: 2rem;
  }

  @media (max-width: 1080px) {
    .homepage-ledger-banner .ledger-hero {
      display: grid;
      grid-template-areas:
        "heading portrait"
        "support portrait"
        "rail rail";
      grid-template-columns: minmax(0, 1fr) minmax(11rem, 0.4fr);
      column-gap: clamp(1.5rem, 4vw, 2.5rem);
      padding-bottom: 2.75rem;
    }

    .homepage-hero__support {
      margin-top: 0;
    }

    .homepage-hero__portrait {
      width: min(100%, 14.5rem);
    }

    .homepage-ledger-banner .ledger-hero h1 {
      font-size: clamp(3.25rem, 9vw, 4.9rem);
      font-weight: 650;
      line-height: var(--type-hero-display-line-height-mobile);
      letter-spacing: var(--type-hero-display-letter-spacing);
      word-spacing: var(--type-hero-display-word-spacing);
    }

    .homepage-ledger-banner .ledger-hero__rail {
      margin-top: 0;
      border-top: 1px solid rgba(244, 247, 251, 0.26);
      border-left: 0;
      padding-top: 1.25rem;
      padding-left: 0;
    }

    .homepage-ledger-banner .ledger-hero__rail p {
      max-width: 46ch;
      margin-bottom: 0;
    }

    .homepage-ledger-banner .ledger-hero__rail dl {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .homepage-ledger-banner .ledger-hero {
      display: grid;
      grid-template-areas:
        "heading portrait"
        "support support";
      grid-template-columns: minmax(0, 1fr) minmax(6.5rem, 8rem);
      column-gap: 1rem;
      row-gap: 1.5rem;
      padding-top: 2.75rem;
      padding-bottom: 3.25rem;
    }

    .homepage-ledger-banner .ledger-hero h1 {
      font-size: clamp(2.8rem, 13vw, 4.1rem);
      line-height: var(--type-hero-display-line-height-mobile);
      letter-spacing: var(--type-hero-display-letter-spacing-mobile);
      word-spacing: var(--type-hero-display-word-spacing-mobile);
    }

    .homepage-hero__portrait {
      align-self: start;
      width: min(100%, 8rem);
    }

    .homepage-hero__role {
      font-size: clamp(1.02rem, 4.8vw, 1.25rem);
    }

    .homepage-hero-actions {
      margin-top: 1.5rem;
    }

    .homepage-ledger-banner .ledger-hero__rail {
      display: none;
    }
  }

  .homepage-ledger-banner .prototype-button--solid {
    background: #f4f7fb;
    border-color: #f4f7fb;
    color: #15191e;
  }

  .homepage-ledger-banner .prototype-button--solid:hover {
    background: var(--color-action);
    border-color: var(--color-action);
    color: #ffffff;
  }

  .ledger-section__intro {
    max-width: 62ch;
    margin: -0.2rem 0 1.6rem;
    color: #5c6671;
    line-height: 1.65;
  }

  .ledger-feature__support {
    max-width: 52ch;
    margin: 1rem 0 0;
    color: #66717c;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .ledger-record__role {
    display: block;
    margin-top: 0.35rem;
    color: var(--prototype-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
