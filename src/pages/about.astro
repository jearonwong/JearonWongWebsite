---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegistryPageHero from "../components/RegistryPageHero.astro";
import { aboutSpecs, contentRouteRoles, pageRegistry, siteThesis, socialLinks, siteConfig } from "../data/site";
import { absoluteUrl, createBreadcrumbJsonLd, siteEntityTerms } from "../data/schema";

const canonicalPath = "/about/";
const aboutUrl = absoluteUrl(canonicalPath);
const aboutDescription =
  "Jearon Wong — Protocol Architect for the Agent Era. Identity page for AI Agent Lifecycle, Agentic Lifecycle Governance, MPLP, GAIC, and accountable AI agent delivery.";
const aboutKeywords = [
  "Jearon Wong",
  "Protocol Architect for the Agent Era",
  "AI Agent Lifecycle",
  "Agentic Lifecycle Governance",
  "Global AI Compliance White Paper 2026",
  "Agentic AI Auditability & Assurance White Paper 2026",
  "Agentic AI Insurability & Risk Transfer White Paper 2026",
  "MPLP",
  "AI agent governance"
];
const knownFor = [
  {
    label: "Protocol Architect for the Agent Era",
    href: "/about/",
    body: "The public identity anchor for the AI Agent Lifecycle, Agentic Delivery, and lifecycle responsibility body of work."
  },
  {
    label: "MPLP",
    href: "/projects/mplp/",
    body: "One protocol path for expressing lifecycle responsibility semantics in agentic and multi-agent work."
  },
  {
    label: "Global AI Compliance White Paper 2026",
    href: "/research/global-ai-compliance-white-paper-2026/",
    body: "The technical report that formalizes Missing Regulatory Objects, RCCS-T, RCCS-M, ALCS, and Agentic Lifecycle Governance."
  },
  {
    label: "Agentic AI Auditability & Assurance White Paper 2026",
    href: "/research/agentic-ai-auditability-assurance-white-paper-2026/",
    body: "The public research candidate extending the series into agentic AI auditability, audit evidence chains, AARM, and MRO-to-audit-evidence mapping."
  },
  {
    label: "Agentic AI Insurability & Risk Transfer White Paper 2026",
    href: "/research/agentic-ai-insurability-risk-transfer-white-paper-2026/",
    body: "The insurability and risk-transfer white paper is staged as a public research candidate."
  }
];
const authoredAndDefined = [
  { label: "Agentic Lifecycle Governance", href: "/concepts/agentic-lifecycle-governance/", relation: "defines / develops" },
  { label: "Missing Regulatory Objects", href: "/concepts/missing-regulatory-objects/", relation: "introduces / formalizes" },
  { label: "RCCS-M", href: "/concepts/rccs-m/", relation: "defines as MRO-adjusted coverage model" },
  { label: "ALCS", href: "/concepts/alcs/", relation: "defines as lifecycle conformance model" },
  { label: "Agentic AI Auditability", href: "/research/agentic-ai-auditability-assurance-white-paper-2026/", relation: "develops through AIAAWP" },
  { label: "AARM", href: "/research/agentic-ai-auditability-assurance-white-paper-2026/agentic-ai-auditability-assurance-white-paper-2026.html#13-agentic-auditability-readiness-model", relation: "formalizes as auditability readiness model" },
  { label: "Agentic AI Insurability", href: "/research/agentic-ai-insurability-risk-transfer-white-paper-2026/", relation: "develops through AIIRWP" },
  { label: "AIO / AIRM", href: "/research/agentic-ai-insurability-risk-transfer-white-paper-2026/", relation: "formalized through AIIRWP public candidate" },
  { label: "Deterministic Delivery", href: "/concepts/deterministic-delivery/", relation: "develops as engineering discipline" },
  { label: "Agentic Delivery", href: "/concepts/agentic-delivery/", relation: "names as delivery category" }
];
const projectProofPaths = [
  { label: "MPLP", href: "/projects/mplp/", role: "protocol path" },
  { label: "Validation Lab", href: "/projects/validation-lab/", role: "non-certifying evidence adjudication surface" },
  { label: "Cognitive OS", href: "/projects/cognitive-os/", role: "runtime path" },
  { label: "SoloCrew", href: "/projects/solocrew/", role: "delivery proof path" }
];
const evidenceLinks = [
  { label: "Evidence Registry / Citation Kit", href: "/evidence/" },
  { label: "Concepts Map / Entity Mesh", href: "/concepts/map/" },
  { label: "GAIC responsive HTML full text", href: "/research/global-ai-compliance-white-paper-2026/global-ai-compliance-white-paper-2026.html" },
  { label: "AIAAWP white paper hub", href: "/research/agentic-ai-auditability-assurance-white-paper-2026/" },
  { label: "AIIRWP public research candidate", href: "/research/agentic-ai-insurability-risk-transfer-white-paper-2026/" },
  { label: "GAIC systems mapping", href: "/research/global-ai-compliance-white-paper-2026/systems/" },
  { label: "Entity graph JSON artifact", href: "/entity/jearonwong-mplp-gaic-entity-graph.json" }
];
const profilePageJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${aboutUrl}#profile`,
  url: aboutUrl,
  name: "Jearon Wong — Protocol Architect for the Agent Era",
  description: aboutDescription,
  mainEntity: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  about: siteEntityTerms.map((term) => ({
    "@type": "Thing",
    name: term
  }))
};
const aboutPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${aboutUrl}#webpage`,
  url: aboutUrl,
  name: pageRegistry.about.title,
  description: aboutDescription,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  mainEntity: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  relatedLink: [
    absoluteUrl("/research/global-ai-compliance-white-paper-2026/"),
    absoluteUrl("/research/agentic-ai-auditability-assurance-white-paper-2026/"),
    absoluteUrl("/research/agentic-ai-insurability-risk-transfer-white-paper-2026/"),
    absoluteUrl("/concepts/agentic-lifecycle-governance/"),
    absoluteUrl("/projects/mplp/"),
    absoluteUrl("/projects/")
  ]
};
const breadcrumbJsonLd = createBreadcrumbJsonLd(aboutUrl, [
  { name: "Home", path: "/" },
  { name: "About", path: canonicalPath }
]);
---

<BaseLayout
  title="About"
  description={aboutDescription}
  canonicalPath={canonicalPath}
  shareTitle="Jearon Wong — Protocol Architect for the Agent Era"
  shareDescription={aboutDescription}
  jsonLd={[aboutPageJsonLd, profilePageJsonLd, breadcrumbJsonLd]}
  keywords={aboutKeywords}
  ogImagePath="/social/og-about.png"
  ogImageAlt="Jearon Wong — Protocol Architect for the Agent Era"
>
  <RegistryPageHero
    title={pageRegistry.about.title}
    subtitle={pageRegistry.about.subtitle}
    objectType={pageRegistry.about.objectType}
    objectValue={pageRegistry.about.objectValue}
    lead={pageRegistry.about.lead}
  />

  <div class="zone-b page-body page-body--standard">
    <section class="shell">
      <div class="registry-chassis spec-sheet">
        <div class="spec-grid">
          {aboutSpecs.map((item) => (
            <div class="spec-line">
              <p class="spec-label">{item.label}</p>
              <p class="spec-value">{item.value}</p>
            </div>
          ))}
        </div>

        <div class="spec-narrative">
          <div class="registry-annotation" style="margin-bottom: 1rem;">
            <span class="registry-key">OPERATIONAL_CONTEXT</span>: <span class="registry-value">PUBLIC_HEADQUARTERS</span>
          </div>
          <div class="registry-annotation route-question">
            <span class="registry-key">PAGE_QUESTION</span>: <span class="registry-value">{contentRouteRoles.about.question}</span>
          </div>
          <div class="prose">
            <p>
              This is not a generic portfolio. It is a public thesis room for {siteThesis.conceptDefinition}
            </p>
            <p>
              Jearon Wong's work starts from a judgment: AI agents can execute, but execution is not delivery.
            </p>
            <p>
              His work develops AI Agent Lifecycle, Agentic Delivery, and MPLP as a protocol path for accountable agent work.
            </p>
          </div>
          <div class="identity-routes">
            <a href="/research/global-ai-compliance-white-paper-2026/">Global AI Compliance White Paper 2026</a>
            <a href="/research/agentic-ai-auditability-assurance-white-paper-2026/">AIAAWP 2026</a>
            <a href="/research/agentic-ai-insurability-risk-transfer-white-paper-2026/">AIIRWP 2026</a>
            <a href="/concepts/agentic-lifecycle-governance/">Agentic Lifecycle Governance</a>
            <a href="/projects/mplp/">MPLP protocol path</a>
            <a href="/evidence/">Evidence Registry</a>
            <a href="/concepts/map/">Concepts Map</a>
            <a href="/projects/">Projects proof path</a>
          </div>
        </div>

        <section class="entity-authority-section" aria-labelledby="known-for-title">
          <div class="registry-annotation">
            <span class="registry-key">ENTITY_ROLE</span>: <span class="registry-value">CANONICAL_PERSON_SURFACE</span>
          </div>
          <h2 id="known-for-title">Known for.</h2>
          <div class="entity-card-grid">
            {knownFor.map((item) => (
              <a href={item.href} class="entity-card">
                <strong>{item.label}</strong>
                <span>{item.body}</span>
              </a>
            ))}
          </div>
        </section>

        <section class="entity-authority-section" aria-labelledby="defined-title">
          <div class="registry-annotation">
            <span class="registry-key">AUTHORED_AND_DEFINED</span>
          </div>
          <h2 id="defined-title">Authored, created, and defined surfaces.</h2>
          <div class="relation-ledger">
            {authoredAndDefined.map((item) => (
              <a href={item.href} class="relation-row">
                <span>{item.relation}</span>
                <strong>{item.label}</strong>
              </a>
            ))}
          </div>
        </section>

        <section class="entity-authority-section" aria-labelledby="projects-title">
          <div class="registry-annotation">
            <span class="registry-key">RELATED_FRAMEWORKS_AND_PROJECTS</span>
          </div>
          <h2 id="projects-title">Protocol path and proof surfaces.</h2>
          <div class="relation-ledger">
            {projectProofPaths.map((item) => (
              <a href={item.href} class="relation-row">
                <span>{item.role}</span>
                <strong>{item.label}</strong>
              </a>
            ))}
          </div>
        </section>

        <section class="entity-authority-section entity-authority-section--boundary" aria-labelledby="boundary-title">
          <div>
            <div class="registry-annotation">
              <span class="registry-key">BOUNDARY</span>: <span class="registry-value">RESTRAINED_AUTHORITY</span>
            </div>
            <h2 id="boundary-title">Boundary.</h2>
            <p>
              This page is the owned-canonical identity surface for Jearon Wong. It does not claim official
              standard status, regulator approval, vendor endorsement, legal compliance proof, external adoption,
              answer-engine citation, indexing outcome, or procurement guidance.
            </p>
          </div>
          <div class="boundary-link-list" aria-label="Evidence and canonical links">
            {evidenceLinks.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </section>

        <div class="external-verification">
          <div class="registry-annotation" style="margin-bottom: 1.25rem;">
            <span class="registry-key">EXTERNAL_VERIFICATION</span>
          </div>
          <div class="verification-grid">
            {socialLinks.map(link => (
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="verification-row">
                <span class="verification-key">{link.platform.toUpperCase()}</span>
                <span class="verification-value">{link.label}</span>
              </a>
            ))}
            <a href={`mailto:${siteConfig.author.email}`} class="verification-row">
              <span class="verification-key">EMAIL</span>
              <span class="verification-value">{siteConfig.author.email}</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .spec-sheet {
    padding: var(--registry-panel-padding);
    background: var(--current-surface);
  }
  .spec-grid {
    display: grid;
    gap: 1.4rem;
  }
  .spec-line {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--current-line);
  }
  .spec-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    color: var(--accent-signal);
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .spec-value {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--current-text);
    font-weight: 600;
  }
  .spec-narrative {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--current-line);
  }
  .route-question {
    margin-bottom: 1rem;
  }
  .spec-narrative .prose {
    max-width: 64ch;
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--current-muted);
  }
  .spec-narrative .prose a {
    color: var(--accent-signal);
    text-decoration: none;
  }
  .spec-narrative .prose a:hover {
    color: var(--current-text);
  }
  .identity-routes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 1.35rem;
  }
  .identity-routes a {
    color: var(--accent-signal);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .identity-routes a:hover {
    color: var(--current-text);
  }
  .entity-authority-section {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--current-line);
  }
  .entity-authority-section h2 {
    margin: 0.85rem 0 1.15rem;
    color: var(--current-text);
    font-size: clamp(1.45rem, 2.6vw, 2.15rem);
    line-height: 1.12;
    letter-spacing: 0;
  }
  .entity-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .entity-card {
    display: grid;
    gap: 0.65rem;
    padding: var(--registry-compact-padding);
    border: 1px solid var(--current-border);
    color: var(--current-text);
    text-decoration: none;
  }
  .entity-card strong {
    font-size: 1rem;
    line-height: 1.35;
  }
  .entity-card span {
    color: var(--current-muted);
    font-size: 0.9rem;
    line-height: 1.58;
  }
  .entity-card:hover,
  .relation-row:hover,
  .boundary-link-list a:hover {
    border-color: var(--accent-signal);
  }
  .relation-ledger {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--current-line);
  }
  .relation-row {
    display: grid;
    grid-template-columns: minmax(210px, 0.34fr) minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--current-line);
    color: var(--current-text);
    text-decoration: none;
  }
  .relation-row span {
    color: var(--accent-signal);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .relation-row strong {
    font-size: 1rem;
    line-height: 1.45;
  }
  .entity-authority-section--boundary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.36fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: var(--registry-panel-padding);
    border: 1px solid var(--current-border);
    border-left: 3px solid var(--accent-signal);
  }
  .entity-authority-section--boundary p {
    max-width: var(--content-measure);
    margin: 0;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.68;
  }
  .boundary-link-list {
    display: grid;
    align-content: start;
    gap: 0.65rem;
  }
  .boundary-link-list a {
    padding: 0.72rem 0.85rem;
    border: 1px solid var(--current-border);
    color: var(--accent-signal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.35;
    text-decoration: none;
    text-transform: uppercase;
  }
  @media (max-width: 768px) {
    .spec-sheet {
      padding: var(--registry-card-padding);
    }
    .spec-line {
      grid-template-columns: 1fr;
      gap: 0.45rem;
      padding-bottom: 1rem;
    }
    .spec-value {
      font-size: 1.02rem;
    }
    .spec-narrative {
      margin-top: var(--space-5);
      padding-top: var(--space-5);
    }
    .spec-narrative .prose {
      font-size: 1rem;
      line-height: 1.65;
    }
    .entity-card-grid,
    .entity-authority-section--boundary {
      grid-template-columns: 1fr;
    }
    .relation-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }

  .external-verification {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--current-line);
  }
  .verification-grid {
    display: grid;
    gap: 0;
  }
  .verification-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--current-line);
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .verification-row:first-child {
    border-top: 1px solid var(--current-line);
  }
  .verification-row:hover {
    background: rgba(59, 130, 246, 0.03);
  }
  .verification-key {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-signal);
  }
  .verification-value {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--current-muted);
    letter-spacing: 0.02em;
  }
  @media (max-width: 768px) {
    .verification-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
      padding: var(--registry-supporting-card-padding);
    }
  }
</style>
