---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegistryPageHero from "../components/RegistryPageHero.astro";
import { aboutSpecs, contentRouteRoles, pageRegistry, siteThesis, socialLinks, siteConfig } from "../data/site";
import { absoluteUrl, createBreadcrumbJsonLd, siteEntityTerms } from "../data/schema";

const canonicalPath = "/about/";
const aboutUrl = absoluteUrl(canonicalPath);
const aboutDescription =
  "Jearon Wong — Protocol Architect for the Agent Era. Identity page for AI Agent Lifecycle, Agentic Lifecycle Governance, MPLP, GAIC, and accountable AI agent delivery.";
const aboutKeywords = [
  "Jearon Wong",
  "Protocol Architect for the Agent Era",
  "AI Agent Lifecycle",
  "Agentic Lifecycle Governance",
  "Global AI Compliance White Paper 2026",
  "MPLP",
  "AI agent governance"
];
const profilePageJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${aboutUrl}#profile`,
  url: aboutUrl,
  name: "Jearon Wong — Protocol Architect for the Agent Era",
  description: aboutDescription,
  mainEntity: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  about: siteEntityTerms.map((term) => ({
    "@type": "Thing",
    name: term
  }))
};
const aboutPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${aboutUrl}#webpage`,
  url: aboutUrl,
  name: pageRegistry.about.title,
  description: aboutDescription,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  mainEntity: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  relatedLink: [
    absoluteUrl("/research/global-ai-compliance-white-paper-2026/"),
    absoluteUrl("/concepts/agentic-lifecycle-governance/"),
    absoluteUrl("/projects/mplp/"),
    absoluteUrl("/projects/")
  ]
};
const breadcrumbJsonLd = createBreadcrumbJsonLd(aboutUrl, [
  { name: "Home", path: "/" },
  { name: "About", path: canonicalPath }
]);
---

<BaseLayout
  title="About"
  description={aboutDescription}
  canonicalPath={canonicalPath}
  shareTitle="Jearon Wong — Protocol Architect for the Agent Era"
  shareDescription={aboutDescription}
  jsonLd={[aboutPageJsonLd, profilePageJsonLd, breadcrumbJsonLd]}
  keywords={aboutKeywords}
  ogImagePath="/social/og-about.png"
  ogImageAlt="Jearon Wong — Protocol Architect for the Agent Era"
>
  <RegistryPageHero
    title={pageRegistry.about.title}
    subtitle={pageRegistry.about.subtitle}
    objectType={pageRegistry.about.objectType}
    objectValue={pageRegistry.about.objectValue}
    lead={pageRegistry.about.lead}
  />

  <div class="zone-b page-body page-body--standard">
    <section class="shell">
      <div class="registry-chassis spec-sheet">
        <div class="spec-grid">
          {aboutSpecs.map((item) => (
            <div class="spec-line">
              <p class="spec-label">{item.label}</p>
              <p class="spec-value">{item.value}</p>
            </div>
          ))}
        </div>

        <div class="spec-narrative">
          <div class="registry-annotation" style="margin-bottom: 1rem;">
            <span class="registry-key">OPERATIONAL_CONTEXT</span>: <span class="registry-value">PUBLIC_HEADQUARTERS</span>
          </div>
          <div class="registry-annotation route-question">
            <span class="registry-key">PAGE_QUESTION</span>: <span class="registry-value">{contentRouteRoles.about.question}</span>
          </div>
          <div class="prose">
            <p>
              This is not a generic portfolio. It is a public thesis room for {siteThesis.conceptDefinition}
            </p>
            <p>
              Jearon Wong's work starts from a judgment: AI agents can execute, but execution is not delivery.
            </p>
            <p>
              His work develops AI Agent Lifecycle, Agentic Delivery, and MPLP as a protocol path for accountable agent work.
            </p>
          </div>
          <div class="identity-routes">
            <a href="/research/global-ai-compliance-white-paper-2026/">Global AI Compliance White Paper 2026</a>
            <a href="/concepts/agentic-lifecycle-governance/">Agentic Lifecycle Governance</a>
            <a href="/projects/mplp/">MPLP protocol path</a>
            <a href="/projects/">Projects proof path</a>
          </div>
        </div>

        <div class="external-verification">
          <div class="registry-annotation" style="margin-bottom: 1.25rem;">
            <span class="registry-key">EXTERNAL_VERIFICATION</span>
          </div>
          <div class="verification-grid">
            {socialLinks.map(link => (
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="verification-row">
                <span class="verification-key">{link.platform.toUpperCase()}</span>
                <span class="verification-value">{link.label}</span>
              </a>
            ))}
            <a href={`mailto:${siteConfig.author.email}`} class="verification-row">
              <span class="verification-key">EMAIL</span>
              <span class="verification-value">{siteConfig.author.email}</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .spec-sheet {
    padding: var(--registry-panel-padding);
    background: var(--current-surface);
  }
  .spec-grid {
    display: grid;
    gap: 1.4rem;
  }
  .spec-line {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--current-line);
  }
  .spec-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    color: var(--accent-signal);
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .spec-value {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--current-text);
    font-weight: 600;
  }
  .spec-narrative {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--current-line);
  }
  .route-question {
    margin-bottom: 1rem;
  }
  .spec-narrative .prose {
    max-width: 64ch;
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--current-muted);
  }
  .spec-narrative .prose a {
    color: var(--accent-signal);
    text-decoration: none;
  }
  .spec-narrative .prose a:hover {
    color: var(--current-text);
  }
  .identity-routes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 1.35rem;
  }
  .identity-routes a {
    color: var(--accent-signal);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .identity-routes a:hover {
    color: var(--current-text);
  }
  @media (max-width: 768px) {
    .spec-sheet {
      padding: var(--registry-card-padding);
    }
    .spec-line {
      grid-template-columns: 1fr;
      gap: 0.45rem;
      padding-bottom: 1rem;
    }
    .spec-value {
      font-size: 1.02rem;
    }
    .spec-narrative {
      margin-top: var(--space-5);
      padding-top: var(--space-5);
    }
    .spec-narrative .prose {
      font-size: 1rem;
      line-height: 1.65;
    }
  }

  .external-verification {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--current-line);
  }
  .verification-grid {
    display: grid;
    gap: 0;
  }
  .verification-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--current-line);
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .verification-row:first-child {
    border-top: 1px solid var(--current-line);
  }
  .verification-row:hover {
    background: rgba(59, 130, 246, 0.03);
  }
  .verification-key {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-signal);
  }
  .verification-value {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--current-muted);
    letter-spacing: 0.02em;
  }
  @media (max-width: 768px) {
    .verification-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
      padding: var(--registry-supporting-card-padding);
    }
  }
</style>
