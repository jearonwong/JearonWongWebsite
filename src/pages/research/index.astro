---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegistryPageHero from "../../components/RegistryPageHero.astro";
import { pageRegistry, siteConfig } from "../../data/site";
import { absoluteUrl, createBreadcrumbJsonLd } from "../../data/schema";

const canonicalPath = "/research/";
const researchUrl = absoluteUrl(canonicalPath);
const researchJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${researchUrl}#webpage`,
  url: researchUrl,
  name: pageRegistry.research.title,
  description: pageRegistry.research.lead,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  mainEntity: {
    "@id": `${researchUrl}#research-list`
  }
};
const researchItemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${researchUrl}#research-list`,
  name: "Jearon Wong Research",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Global AI Compliance White Paper 2026",
      url: absoluteUrl("/research/global-ai-compliance-white-paper-2026/")
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Agentic AI Auditability & Assurance White Paper 2026",
      url: absoluteUrl("/research/agentic-ai-auditability-assurance-white-paper-2026/")
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Agentic AI Insurability & Risk Transfer White Paper 2026 — Under Editorial Review",
      url: absoluteUrl("/research/agentic-ai-insurability-risk-transfer-white-paper-2026/")
    }
  ]
};
const researchBreadcrumbJsonLd = createBreadcrumbJsonLd(researchUrl, [
  { name: "Home", path: "/" },
  { name: "Research", path: canonicalPath }
]);
---

<BaseLayout
  title={pageRegistry.research.title}
  description={pageRegistry.research.lead}
  canonicalPath={canonicalPath}
  jsonLd={[researchJsonLd, researchItemListJsonLd, researchBreadcrumbJsonLd]}
  ogImagePath="/social/jearonwong-og.png"
  ogImageAlt="Research — White Paper Ledger by Jearon Wong"
>
  <RegistryPageHero
    title={pageRegistry.research.title}
    objectType={pageRegistry.research.objectType}
    objectValue={pageRegistry.research.objectValue}
    lead={pageRegistry.research.lead}
  />

  <div class="zone-b page-body page-body--standard">
    <section class="shell research-ledger">
      <article class="registry-chassis research-release">
        <div class="registry-annotation release-tag">
          <span class="registry-key">PUBLICATION</span>: <span class="registry-value">WHITE PAPER</span>
        </div>
        <div class="release-grid">
          <div class="release-main">
            <h2><a href="/research/global-ai-compliance-white-paper-2026/">Global AI Compliance White Paper 2026</a></h2>
            <p>
              A 2026 public edition defining Missing Regulatory Objects, RCCS-T, RCCS-M, ALCS,
              and lifecycle responsibility for AI agent and multi-agent governance.
            </p>
          </div>
          <div class="release-meta" aria-label="White paper release metadata">
            <span>v0.3.2 Public Edition</span>
            <span>GACWP-2026-v0.3.2-FRC-R3</span>
            <span>485 pages</span>
          </div>
        </div>
        <div class="release-actions">
          <a href="/research/global-ai-compliance-white-paper-2026/" class="release-link">Open white paper hub</a>
          <a href="/research/global-ai-compliance-white-paper-2026/global-ai-compliance-white-paper-2026.pdf" class="release-link">Download PDF</a>
        </div>
      </article>
      <article class="registry-chassis research-release">
        <div class="registry-annotation release-tag">
          <span class="registry-key">PUBLICATION</span>: <span class="registry-value">PUBLIC_RESEARCH_CANDIDATE</span>
        </div>
        <div class="release-grid">
          <div class="release-main">
            <h2><a href="/research/agentic-ai-auditability-assurance-white-paper-2026/">Agentic AI Auditability &amp; Assurance White Paper 2026</a></h2>
            <p>
              A public research candidate defining agentic AI auditability, lifecycle evidence,
              audit evidence chains, AARM, and the MRO-to-audit-evidence mapping for enterprise AI
              governance.
            </p>
          </div>
          <div class="release-meta" aria-label="AIAAWP release metadata">
            <span>v0.1 Public Research Candidate</span>
            <span>AIAAWP-2026-v0.1-R4-CANDIDATE</span>
            <span>118 pages</span>
          </div>
        </div>
        <div class="release-actions">
          <a href="/research/agentic-ai-auditability-assurance-white-paper-2026/" class="release-link">Open white paper hub</a>
          <a href="/research/agentic-ai-auditability-assurance-white-paper-2026/agentic-ai-auditability-assurance-white-paper-2026.html" class="release-link">Read HTML</a>
          <a href="/research/agentic-ai-auditability-assurance-white-paper-2026/agentic-ai-auditability-assurance-white-paper-2026.pdf" class="release-link">Download PDF</a>
        </div>
      </article>
      <article class="registry-chassis research-release">
        <div class="registry-annotation release-tag">
          <span class="registry-key">PUBLICATION</span>: <span class="registry-value">UNDER_EDITORIAL_REVIEW</span>
        </div>
        <div class="release-grid">
          <div class="release-main">
            <h2><a href="/research/agentic-ai-insurability-risk-transfer-white-paper-2026/">Agentic AI Insurability &amp; Risk Transfer White Paper 2026</a></h2>
            <p>
              Under publication-quality reset. The previous staged body is no longer promoted as
              a release-quality white paper and is being treated as an internal evidence/source pack
              pending a publication-grade rewrite.
            </p>
          </div>
          <div class="release-meta" aria-label="AIIRWP release metadata">
            <span>03 / Insurability &amp; Risk Transfer</span>
            <span>Under editorial review</span>
            <span>Revision pending</span>
          </div>
        </div>
        <div class="release-actions">
          <a href="/research/agentic-ai-insurability-risk-transfer-white-paper-2026/" class="release-link">View editorial status</a>
        </div>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .research-ledger {
    display: grid;
    gap: var(--space-5);
  }

  .research-release {
    padding: var(--registry-panel-padding);
    border-left: 3px solid var(--accent-proof);
  }

  .release-tag {
    margin-bottom: 1rem;
  }

  .release-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.36fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .release-main h2 {
    margin: 0;
    font-size: clamp(1.65rem, 3vw, 2.3rem);
    line-height: 1.08;
    letter-spacing: 0;
    color: var(--current-text);
  }

  .release-main h2 a {
    color: inherit;
    text-decoration: none;
  }

  .release-main h2 a:hover {
    color: var(--accent-signal);
  }

  .release-main p {
    max-width: 68ch;
    margin: 1rem 0 0;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.66;
  }

  .release-meta {
    display: grid;
    gap: 0;
    border: 1px solid var(--current-line);
  }

  .release-meta span {
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--current-line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--current-muted);
  }

  .release-meta span:last-child {
    border-bottom: 0;
  }

  .release-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--current-line);
  }

  .release-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-signal);
    text-decoration: none;
  }

  .release-link:hover {
    color: var(--current-text);
  }

  @media (max-width: 820px) {
    .release-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
