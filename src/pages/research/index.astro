---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegistryPageHero from "../../components/RegistryPageHero.astro";
import ReadingGuide from "../../components/ReadingGuide.astro";
import ReadingFlowDiagram from "../../components/ReadingFlowDiagram.astro";
import SemanticEvidenceBand from "../../components/SemanticEvidenceBand.astro";
import { absoluteUrl, createBreadcrumbJsonLd } from "../../data/schema";
import { pageRegistry, siteConfig } from "../../data/site";
import { whitepaperPublications } from "../../data/whitepaperPublications";

const canonicalPath = "/research/";
const researchUrl = absoluteUrl(canonicalPath);
const researchJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${researchUrl}#webpage`,
  url: researchUrl,
  name: pageRegistry.research.title,
  description: pageRegistry.research.lead,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  mainEntity: {
    "@id": `${researchUrl}#research-list`
  }
};
const researchItemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${researchUrl}#research-list`,
  name: "Jearon Wong Research",
  itemListElement: whitepaperPublications.map((paper, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: paper.title,
    url: absoluteUrl(paper.canonicalPath)
  }))
};
const researchBreadcrumbJsonLd = createBreadcrumbJsonLd(researchUrl, [
  { name: "Home", path: "/" },
  { name: "Research", path: canonicalPath }
]);
const foundationNote =
  "The first three public research editions establish the compliance, auditability, and insurability foundation for agentic lifecycle evidence. The next phase is MPLP v2.0 object-model consolidation. The enterprise implementation white paper and practitioner guides are intentionally held until the protocol object model is ready.";
---

<BaseLayout
  title={pageRegistry.research.title}
  description={pageRegistry.research.lead}
  canonicalPath={canonicalPath}
  jsonLd={[researchJsonLd, researchItemListJsonLd, researchBreadcrumbJsonLd]}
  ogImagePath="/social/jearonwong-og.png"
  ogImageAlt="Research — White Paper Ledger by Jearon Wong"
>
  <RegistryPageHero
    title={pageRegistry.research.title}
    objectType={pageRegistry.research.objectType}
    objectValue={pageRegistry.research.objectValue}
    lead={pageRegistry.research.lead}
  />

  <div class="zone-b page-body page-body--standard">
    <section class="shell research-ledger">
      <ReadingGuide
        role="FORMAL_RESEARCH"
        answer={pageRegistry.research.lead}
        startHref={whitepaperPublications[0]?.canonicalPath ?? "/research/"}
        startLabel="Open the first research edition"
        nextLinks={[{ href: "/evidence/", label: "Open the evidence registry" }, { href: "/definitions/", label: "Check citation definitions" }]}
        sections={["Publication status", "Research editions", "Artifact integrity", "Citation and evidence"]}
      />
      <ReadingFlowDiagram
        variant="research"
        title="A research edition is a traceable publication record."
        description="Follow the question, edition identity, public artifacts, and citation path before relying on a research surface."
      />
      <SemanticEvidenceBand
        definition="Research is the formal publication layer for lifecycle governance, auditability, and risk-transfer analysis."
        boundary="Public research editions are authored technical reports; they are not legal advice, certification, assurance opinions, regulator approvals, or procurement guidance."
        evidence="Each paper exposes HTML/PDF artifacts, manifest, checksum, citation identity, and version status."
        citation="Use each paper's document ID, version, canonical URL, and artifact checksum when citing it."
        updated="2026-08-26"
        sourceLevel="AUTHORED_RESEARCH_PUBLICATION"
      />
      <div class="registry-chassis foundation-note" aria-label="Research foundation and next protocol phase">
        <div class="registry-annotation">
          <span class="registry-key">SERIES_POSITION</span>: <span class="registry-value">RESEARCH_FOUNDATION</span>
        </div>
        <p>{foundationNote}</p>
      </div>
      {whitepaperPublications.map((paper) => (
        <article class="registry-chassis research-release">
          <div class="release-grid">
            <div class="release-main">
              <div class="registry-annotation release-tag">
                <span class="registry-key">WHITE_PAPER</span>: <span class="registry-value">{paper.statusLabel}</span>
              </div>
              <h2><a href={paper.canonicalPath}>{paper.title}</a></h2>
              <p class="release-subtitle">{paper.subtitle}</p>
              <p>{paper.abstract}</p>
              <p class="artifact-note">{paper.artifactNote}</p>
              <div class="decision-metadata">
                <div><span>SUITABLE_FOR</span><strong>{paper.audience}</strong></div>
                <div><span>READING_TIME</span><strong>{paper.readingTimeMinutes} minutes</strong></div>
                <div><span>TECHNICAL_DEPTH</span><strong>{paper.technicalDepth}</strong></div>
                <div><span>CITATION_USE</span><strong>{paper.citationUse}</strong></div>
              </div>
            </div>
            <div class="release-meta" aria-label={`${paper.title} publication metadata`}>
              <span>{paper.publicStatus}</span>
              <span>{paper.versionLabel}</span>
              <span>{paper.documentId}</span>
              <span>{paper.pageCount} pages</span>
              <span>No public DOCX</span>
            </div>
          </div>
          <div class="release-actions">
            <a href={paper.canonicalPath} class="release-link">Open white paper hub</a>
            {paper.artifacts.map((artifact) => (
              <a href={artifact.href} class="release-link">{artifact.label}</a>
            ))}
          </div>
          <p class="release-boundary">
            {paper.publicStatus}; not certification, not external approval, and not public DOCX.
          </p>
          <p class="release-change"><strong>CHANGE_SUMMARY</strong>: {paper.changeSummary}</p>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .research-ledger {
    display: grid;
    gap: var(--space-5);
  }

  .foundation-note {
    padding: var(--registry-panel-padding);
    border-left: 3px solid var(--color-rule);
  }

  .foundation-note p {
    max-width: 78ch;
    margin: 0.9rem 0 0;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.66;
  }

  .research-release {
    padding: var(--registry-panel-padding);
    border-left: 3px solid var(--color-rule);
  }

  .release-tag {
    margin-bottom: 1rem;
  }

  .release-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.36fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .release-main h2 {
    margin: 0;
    font-size: clamp(1.65rem, 3vw, 2.3rem);
    line-height: var(--type-section-title-line-height);
    letter-spacing: var(--type-section-title-letter-spacing);
    word-spacing: var(--type-section-title-word-spacing);
    color: var(--current-text);
  }

  .release-main h2 a {
    color: inherit;
    text-decoration: none;
  }

  .release-main h2 a:hover {
    color: var(--color-action);
  }

  .release-main p {
    max-width: 72ch;
    margin: 1rem 0 0;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.66;
  }

  .release-main .release-subtitle {
    color: var(--current-text);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .artifact-note {
    font-family: var(--font-mono);
    font-size: 0.78rem !important;
  }
  .decision-metadata {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1.15rem;
  }
  .decision-metadata > div {
    display: grid;
    gap: 0.3rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--current-line);
  }
  .decision-metadata span,
  .release-change strong {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-meta);
  }
  .decision-metadata strong {
    font-size: 0.82rem;
    line-height: 1.45;
    font-weight: 600;
    color: var(--current-text);
  }
  .release-change {
    margin: 0.9rem 0 0;
    color: var(--current-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }
  @media (max-width: 640px) {
    .decision-metadata {
      grid-template-columns: 1fr;
    }
  }

  .release-meta {
    display: grid;
    gap: 0;
    border: 1px solid var(--current-line);
  }

  .release-meta span {
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--current-line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--current-muted);
  }

  .release-meta span:last-child {
    border-bottom: 0;
  }

  .release-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--current-line);
  }

  .release-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-action);
    text-decoration: none;
  }

  .release-link:hover {
    color: var(--current-text);
  }

  .release-boundary {
    margin: 1rem 0 0;
    color: var(--current-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .release-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
