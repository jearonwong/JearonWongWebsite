---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import RegistryPageHero from "../../../../components/RegistryPageHero.astro";
import { absoluteUrl, createBreadcrumbJsonLd } from "../../../../data/schema";
import {
  gaicSystemGroups,
  gaicSystems,
  getGAICSystemsByGroup
} from "../../../../data/gaicSystems";
import { siteConfig } from "../../../../data/site";

const canonicalPath = "/research/global-ai-compliance-white-paper-2026/systems/";
const extendedEcosystemPath = "/mapping/extended-ecosystem/";
const pageUrl = absoluteUrl(canonicalPath);
const whitePaperHub = "/research/global-ai-compliance-white-paper-2026/";
const metaDescription =
  "Source-qualified, non-ranking lifecycle governance mappings for systems discussed in the Global AI Compliance White Paper 2026.";
const keywords = [
  "Systems Discussed in the Global AI Compliance White Paper 2026",
  "GAIC-cited systems",
  "Agentic Lifecycle Governance",
  "Missing Regulatory Objects",
  "RCCS-M",
  "ALCS",
  "MPLP",
  "IBM watsonx.governance",
  "Microsoft Azure AI Foundry",
  "AWS Bedrock",
  "Google Vertex AI",
  "LangGraph",
  "OpenAI Agents SDK",
  "CrewAI"
];
const primaryLinks = [
  { href: whitePaperHub, label: "Read the White Paper" },
  { href: "/concepts/agentic-lifecycle-governance/", label: "Explore Agentic Lifecycle Governance" },
  { href: "/concepts/map/", label: "View Concepts Map" },
  { href: "/playbooks/", label: "View Applied Playbooks" },
  { href: extendedEcosystemPath, label: "View Extended Ecosystem Mapping" }
];
const conceptLinks = [
  { href: "/concepts/missing-regulatory-objects/", label: "MRO" },
  { href: "/concepts/rccs-m/", label: "RCCS-M" },
  { href: "/concepts/alcs/", label: "ALCS" },
  { href: "/concepts/lifecycle-evidence/", label: "Evidence Chain" },
  { href: "/concepts/authority-boundary/", label: "Authority Boundary" },
  { href: "/concepts/accepted-outcome/", label: "Accepted Outcome" }
];
const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Systems Discussed in the Global AI Compliance White Paper 2026",
  description: metaDescription,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  citation: absoluteUrl(whitePaperHub),
  mainEntity: {
    "@id": `${pageUrl}#systems-list`
  },
  breadcrumb: {
    "@id": `${pageUrl}#breadcrumb`
  }
};
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#systems-list`,
  name: "GAIC-Cited Systems",
  description: metaDescription,
  itemListElement: gaicSystems.map((system, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: system.name,
    item: absoluteUrl(`${canonicalPath}${system.slug}/`)
  }))
};
const definedTermSetJsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": `${pageUrl}#defined-term-set`,
  name: "GAIC-Cited Systems Semantic Mapping Layer",
  description:
    "Source-qualified lifecycle governance anchors for systems discussed in the Global AI Compliance White Paper 2026.",
  creator: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  isBasedOn: {
    "@type": "TechArticle",
    name: "Global AI Compliance White Paper 2026",
    url: absoluteUrl(whitePaperHub)
  },
  hasDefinedTerm: gaicSystems.map((system) => ({
    "@type": "DefinedTerm",
    name: system.name,
    description: system.summary,
    url: absoluteUrl(`${canonicalPath}${system.slug}/`)
  }))
};
const breadcrumbJsonLd = createBreadcrumbJsonLd(pageUrl, [
  { name: "Home", path: "/" },
  { name: "Research", path: "/research/" },
  { name: "Global AI Compliance White Paper 2026", path: whitePaperHub },
  { name: "Systems Discussed", path: canonicalPath }
]);
---

<BaseLayout
  title="Systems Discussed in the Global AI Compliance White Paper 2026"
  description={metaDescription}
  shareTitle="Systems Discussed in the Global AI Compliance White Paper 2026"
  shareDescription={metaDescription}
  twitterTitle="Systems Discussed in GAIC 2026"
  twitterDescription={metaDescription}
  canonicalPath={canonicalPath}
  jsonLd={[pageJsonLd, itemListJsonLd, definedTermSetJsonLd, breadcrumbJsonLd]}
  keywords={keywords}
  ogImagePath="/social/jearonwong-og.png"
  ogImageAlt="Systems Discussed in the Global AI Compliance White Paper 2026"
>
  <RegistryPageHero
    title="Systems Discussed in the Global AI Compliance White Paper 2026"
    objectType="GAIC_CITED_SYSTEMS"
    objectValue="SOURCE_QUALIFIED_MAPPINGS"
    lead="Source-qualified lifecycle governance mappings, not vendor rankings."
  >
    <div class="systems-hero-links">
      {primaryLinks.map((link) => (
        <a href={link.href} class="registry-annotation systems-hero-link">
          <span class="registry-key">LINK</span>: <span class="registry-value">{link.label}</span>
        </a>
      ))}
    </div>
  </RegistryPageHero>

  <div class="zone-b page-body page-body--standard">
    <main class="shell systems-shell">
      <section class="registry-chassis systems-intro" aria-labelledby="systems-intro-title">
        <div>
          <div class="registry-annotation">
            <span class="registry-key">BOUNDARY</span>: <span class="registry-value">NON_RANKING</span>
          </div>
          <h2 id="systems-intro-title">Source-qualified lifecycle governance mappings.</h2>
          <p>
            The Global AI Compliance White Paper 2026 uses selected systems and frameworks to examine
            lifecycle responsibility coverage for agentic and multi-agent systems. These references are
            source-qualified, provisional, and non-ranking. They are not procurement recommendations,
            certifications, legal compliance proofs, or regulator-approved assessments.
          </p>
        </div>
        <div class="systems-intro__links" aria-label="Primary GAIC links">
          {primaryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </section>

      {gaicSystemGroups.map((group) => (
        <section class="system-group" aria-labelledby={`${group.toLowerCase().replaceAll(" ", "-").replaceAll("/", "")}-title`}>
          <div class="registry-section-heading">
            <div class="registry-annotation">
              <span class="registry-key">SYSTEM_GROUP</span>
            </div>
            <h2 id={`${group.toLowerCase().replaceAll(" ", "-").replaceAll("/", "")}-title`}>{group}</h2>
          </div>
          <div class="system-card-grid">
            {getGAICSystemsByGroup(group).map((system) => (
              <article class="registry-chassis system-card">
                <div class="system-card__topline">
                  <span>{system.category}</span>
                  <span>Source-qualified</span>
                </div>
                <h3><a href={`${canonicalPath}${system.slug}/`}>{system.name}</a></h3>
                <p>{system.whitePaperContext}</p>
                <div class="system-card__question">
                  <strong>Lifecycle governance question</strong>
                  <span>{system.lifecycleQuestion}</span>
                </div>
                <div class="concept-chip-row" aria-label={`${system.name} related concepts`}>
                  {conceptLinks.map((link) => (
                    <a href={link.href}>{link.label}</a>
                  ))}
                </div>
                <a href={`${canonicalPath}${system.slug}/`} class="system-card__link">Open source-qualified mapping</a>
                <p class="system-card__boundary">Source-qualified, provisional, non-ranking, non-procurement.</p>
              </article>
            ))}
          </div>
        </section>
      ))}

      <section class="registry-chassis systems-boundary" aria-labelledby="systems-boundary-title">
        <div class="registry-annotation">
          <span class="registry-key">NON_CLAIM_DISCIPLINE</span>
        </div>
        <h2 id="systems-boundary-title">What this layer does not claim.</h2>
        <p>
          This layer does not rank vendors, recommend procurement, claim legal compliance proof,
          certify systems, imply regulator approval, or imply vendor endorsement. MPLP remains one
          protocol path for lifecycle responsibility semantics, not a required or exclusive route.
        </p>
        <p>
          For ecosystem search contexts outside the first-layer systems discussed in GAIC, use the
          <a href={extendedEcosystemPath}>Extended Ecosystem Lifecycle Governance Mapping</a>. That
          R3F layer is source-qualified and not GAIC-scored.
        </p>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .systems-hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.2rem;
    margin-top: 1.4rem;
  }

  .systems-hero-link {
    text-decoration: none;
  }

  .systems-hero-link:hover .registry-value {
    color: var(--accent-signal);
  }

  .systems-shell {
    display: grid;
    gap: var(--space-6);
  }

  .systems-intro,
  .systems-boundary {
    padding: var(--registry-panel-padding);
  }

  .systems-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.36fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    border-left: 3px solid var(--accent-proof);
  }

  .systems-intro h2,
  .systems-boundary h2,
  .registry-section-heading h2 {
    margin: 0.85rem 0 0;
    color: var(--current-text);
    font-size: clamp(1.55rem, 2.8vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .systems-intro p,
  .systems-boundary p,
  .registry-section-heading p {
    max-width: var(--lead-measure);
    margin: 0.9rem 0 0;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.68;
  }

  .systems-intro__links {
    display: grid;
    gap: 0;
    align-content: start;
    border-top: 1px solid var(--current-line);
  }

  .systems-intro__links a {
    padding: 0.82rem 0;
    border-bottom: 1px solid var(--current-line);
    color: var(--current-text);
    font-weight: 700;
    text-decoration: none;
  }

  .systems-intro__links a:hover {
    color: var(--accent-signal);
  }

  .system-group {
    display: grid;
    gap: 1.35rem;
  }

  .system-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .system-card {
    display: grid;
    gap: 0.95rem;
    align-content: start;
    padding: var(--registry-card-padding);
  }

  .system-card__topline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: space-between;
    color: var(--accent-signal);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .system-card h3 {
    margin: 0;
    color: var(--current-text);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.12;
    letter-spacing: 0;
  }

  .system-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .system-card p,
  .system-card__question span {
    margin: 0;
    color: var(--current-muted);
    font-size: 0.95rem;
    line-height: 1.62;
  }

  .system-card__question {
    display: grid;
    gap: 0.35rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--current-line);
  }

  .system-card__question strong {
    color: var(--current-text);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .concept-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .concept-chip-row a {
    padding: 0.35rem 0.48rem;
    border: 1px solid var(--current-border);
    color: var(--current-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .concept-chip-row a:hover,
  .system-card h3 a:hover,
  .system-card__link:hover {
    color: var(--accent-signal);
  }

  .system-card__link {
    color: var(--accent-signal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .system-card__boundary {
    color: var(--current-muted) !important;
    font-family: var(--font-mono);
    font-size: 0.68rem !important;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .systems-boundary {
    border-left: 3px solid var(--accent-caution);
  }

  @media (max-width: 860px) {
    .systems-intro,
    .system-card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
