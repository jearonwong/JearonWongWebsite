---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { siteConfig } from "../../../data/site";
import { createBreadcrumbJsonLd } from "../../../data/schema";

const assetBase = "/research/agentic-ai-insurability-risk-transfer-white-paper-2026";
const canonicalPath = "/research/agentic-ai-insurability-risk-transfer-white-paper-2026/";
const pageUrl = `${siteConfig.siteUrl}${canonicalPath}`;
const pdfUrl = `${siteConfig.siteUrl}${assetBase}/agentic-ai-insurability-risk-transfer-white-paper-2026.pdf`;
const htmlUrl = `${siteConfig.siteUrl}${assetBase}/agentic-ai-insurability-risk-transfer-white-paper-2026.html`;
const manifestUrl = `${siteConfig.siteUrl}${assetBase}/manifest.json`;
const checksumUrl = `${siteConfig.siteUrl}${assetBase}/checksums.sha256`;
const gaicHubPath = "/research/global-ai-compliance-white-paper-2026/";
const aiaawpHubPath = "/research/agentic-ai-auditability-assurance-white-paper-2026/";
const documentId = "AIIRWP-2026-v1.0-R3AA-PUBLIC-ROUTE";
const reportTitle = "Agentic AI Insurability & Risk Transfer White Paper 2026";
const reportSubtitle = "A Lifecycle Evidence Guide for Underwriting, Claims, and Enterprise Risk Transfer";
const reportVersion = "v1.0 Public Research Candidate Route Restored";
const releaseState =
  "Public research candidate route restored; not final, not sealed, not release-ready; public announcement not executed.";
const publicationMonth = "May 2026";
const metaDescription =
  "A public research candidate by Jearon Wong analyzing agentic AI insurability and risk transfer through lifecycle evidence, insured subject and risk object separation, underwriting reviewability, and claim reconstruction boundaries.";
const citationText =
  "Jearon Wong. Agentic AI Insurability & Risk Transfer White Paper 2026: A Lifecycle Evidence Guide for Underwriting, Claims, and Enterprise Risk Transfer. Technical Report AIIRWP-2026-v1.0-R3AA-PUBLIC-ROUTE, May 2026.";
const citationKeywords =
  "Agentic AI Insurability; AI risk transfer; insured legal subject; agentic risk object; underwriting reviewability; claim evidence chain; lifecycle evidence; Agentic Lifecycle Governance; AI Agent Lifecycle";
const citationMetaTags = [
  { name: "citation_title", content: `${reportTitle}: ${reportSubtitle}` },
  { name: "citation_author", content: "Wong, Jearon" },
  { name: "citation_publication_date", content: "2026/05" },
  { name: "citation_technical_report_number", content: documentId },
  { name: "citation_pdf_url", content: pdfUrl },
  { name: "citation_fulltext_html_url", content: htmlUrl },
  { name: "citation_language", content: "en" },
  { name: "citation_keywords", content: citationKeywords }
];
const shaRows = [
  {
    label: "HTML public research candidate",
    value: "c942f23613dd7c896745e9d6e6ebde4ecbe9f7f2a95d27eb80f8c841ade0eeae"
  },
  {
    label: "PDF public research candidate",
    value: "cfd5b1984aa111e0280a5f71774e3ee19bb9bec37410d58488ab29504f93c5e9"
  },
  {
    label: "Manifest",
    value: "90ad86ff3b7a2b7ecda556e7c85d590c7381095292d8d2852789d3d41aa4e919"
  }
];
const artifactLinks = [
  { href: `${assetBase}/agentic-ai-insurability-risk-transfer-white-paper-2026.html`, label: "Read HTML" },
  { href: `${assetBase}/agentic-ai-insurability-risk-transfer-white-paper-2026.pdf`, label: "Download PDF" },
  { href: `${assetBase}/manifest.json`, label: "View manifest" },
  { href: `${assetBase}/checksums.sha256`, label: "Verify checksums" }
];
const keyConcepts = [
  { label: "Agentic AI Insurability", href: `${assetBase}/agentic-ai-insurability-risk-transfer-white-paper-2026.html#executive-thesis` },
  { label: "Insured Legal Subject", href: `${assetBase}/agentic-ai-insurability-risk-transfer-white-paper-2026.html#1-the-ai-insurability-problem` },
  { label: "Agentic Risk Object", href: `${assetBase}/agentic-ai-insurability-risk-transfer-white-paper-2026.html#2-insured-subject-versus-agentic-risk-object` },
  { label: "Claim Evidence Chain", href: `${assetBase}/agentic-ai-insurability-risk-transfer-white-paper-2026.html#20-disputes-evidence-gaps-and-coverage-boundary-friction` },
  { label: "Underwriting-facing reviewability", href: `${assetBase}/agentic-ai-insurability-risk-transfer-white-paper-2026.html#14-underwriting-evidence-architecture-for-agentic-ai` },
  { label: "Agentic Lifecycle Governance", href: "/concepts/agentic-lifecycle-governance/" },
  { label: "Evidence Chain", href: "/concepts/lifecycle-evidence/" },
  { label: "Authority Boundary", href: "/concepts/authority-boundary/" },
  { label: "Accepted Outcome", href: "/concepts/accepted-outcome/" }
];
const seriesLinks = [
  {
    label: "Global AI Compliance White Paper 2026",
    href: gaicHubPath,
    body: "The lifecycle-governance foundation for Missing Regulatory Objects, RCCS-M, ALCS, and responsibility objects."
  },
  {
    label: "Agentic AI Auditability & Assurance White Paper 2026",
    href: aiaawpHubPath,
    body: "The auditability and assurance companion for lifecycle evidence and audit evidence chains."
  },
  {
    label: "AIIRWP 2026",
    href: canonicalPath,
    body: "The risk-transfer companion for insured subject separation, agentic risk objects, underwriting reviewability, and claim reconstruction boundaries."
  }
];
const nonGoals = [
  "Not legal advice.",
  "Not insurance advice.",
  "Not a coverage opinion.",
  "Not underwriting guidance.",
  "Not actuarial pricing guidance.",
  "Not premium recommendation.",
  "Not claim approval guidance.",
  "Not legal liability determination.",
  "Not certification.",
  "Not proof of insurability.",
  "Not insurer endorsement.",
  "Not a regulator-approved method.",
  "Not procurement recommendation.",
  "Not vendor ranking.",
  "Not a score.",
  "Not a standard.",
  "Not readiness certification.",
  "Not insurer-adopted method.",
  "Not final.",
  "Not sealed.",
  "Not release-ready."
];
const aboutTerms = [
  "Agentic AI Insurability",
  "AI Risk Transfer",
  "Insured Legal Subject",
  "Agentic Risk Object",
  "Claim Evidence Chain",
  "Lifecycle Evidence",
  "Underwriting Reviewability",
  "Agentic Lifecycle Governance",
  "AI Agent Lifecycle",
  "Authority Boundary",
  "Accepted Outcome",
  "MPLP"
];
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": ["TechArticle", "Report"],
  "@id": `${pageUrl}#whitepaper`,
  headline: reportTitle,
  alternativeHeadline: reportSubtitle,
  description: metaDescription,
  url: pageUrl,
  identifier: documentId,
  inLanguage: "en",
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  publisher: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  datePublished: "2026-05-27",
  dateModified: "2026-05-27",
  version: reportVersion,
  genre: "Technical report",
  creativeWorkStatus: "PublicationCandidate",
  citation: citationText,
  keywords: aboutTerms,
  isBasedOn: [
    {
      "@type": "CreativeWork",
      name: "Global AI Compliance White Paper 2026",
      url: `${siteConfig.siteUrl}${gaicHubPath}`
    },
    {
      "@type": "CreativeWork",
      name: "Agentic AI Auditability & Assurance White Paper 2026",
      url: `${siteConfig.siteUrl}${aiaawpHubPath}`
    }
  ],
  isPartOf: [
    {
      "@type": "CreativeWorkSeries",
      name: "Agentic Lifecycle Governance Industry Series"
    },
    {
      "@id": `${siteConfig.siteUrl}#website`
    }
  ],
  about: aboutTerms.map((term) => ({
    "@type": "Thing",
    name: term
  })),
  mentions: [
    "AI Agent Lifecycle",
    "Agentic Lifecycle Governance",
    "Insured Legal Subject",
    "Agentic Risk Object",
    "Claim Evidence Chain",
    "Underwriting Reviewability",
    "MPLP"
  ].map((term) => ({
    "@type": "Thing",
    name: term
  })),
  encoding: [
    {
      "@type": "MediaObject",
      encodingFormat: "text/html",
      contentUrl: htmlUrl,
      sha256: shaRows[0].value
    },
    {
      "@type": "MediaObject",
      encodingFormat: "application/pdf",
      contentUrl: pdfUrl,
      sha256: shaRows[1].value
    }
  ],
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`
  }
};
const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: reportTitle,
  description: metaDescription,
  breadcrumb: {
    "@id": `${pageUrl}#breadcrumb`
  },
  mainEntity: {
    "@id": `${pageUrl}#whitepaper`
  }
};
const breadcrumbJsonLd = createBreadcrumbJsonLd(pageUrl, [
  { name: "Home", path: "/" },
  { name: "Research", path: "/research/" },
  { name: reportTitle, path: canonicalPath }
]);
const artifactListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#artifacts`,
  name: "AIIRWP public research candidate artifacts",
  itemListElement: [
    { name: "Read HTML", url: htmlUrl },
    { name: "Download PDF", url: pdfUrl },
    { name: "Manifest", url: manifestUrl },
    { name: "Checksums", url: checksumUrl }
  ].map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    url: item.url
  }))
};
---

<BaseLayout
  title={reportTitle}
  description={metaDescription}
  shareTitle={reportTitle}
  shareDescription={metaDescription}
  twitterTitle={reportTitle}
  twitterDescription="Public research candidate route for AIIRWP v1.0; HTML/PDF plus manifest/checksum; no final/sealed/release-ready status."
  ogType="article"
  canonicalPath={canonicalPath}
  jsonLd={[articleJsonLd, pageJsonLd, breadcrumbJsonLd, artifactListJsonLd]}
  metaTags={citationMetaTags}
  keywords={citationKeywords}
  ogImagePath="/social/jearonwong-og.png"
  ogImageAlt="Agentic AI Insurability & Risk Transfer White Paper 2026"
>
  <div class="zone-a registry-grid release-hero-shell">
    <SiteHeader />
    <section class="shell release-hero">
      <div class="release-hero__copy">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/research/">Research</a>
        </nav>
        <div class="registry-annotation status-line">
          <span class="registry-key">STATUS</span>: <span class="registry-value">PUBLIC_RESEARCH_CANDIDATE_ROUTE_RESTORED</span>
        </div>
        <h1>{reportTitle}</h1>
        <p class="release-subtitle">{reportSubtitle}</p>
        <p class="release-thesis">
          {metaDescription}
        </p>
        <div class="artifact-actions" aria-label="AIIRWP public artifacts">
          {artifactLinks.map((item) => (
            <a class="artifact-link" href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>
      <aside class="release-meta-panel" aria-label="AIIRWP public research candidate status">
        <div class="registry-annotation">
          <span class="registry-key">PUBLIC_STATUS</span>: <span class="registry-value">ROUTE_RESTORED</span>
        </div>
        <div class="meta-line">
          <span>Version</span>
          <strong>{reportVersion}</strong>
        </div>
        <div class="meta-line">
          <span>Artifacts</span>
          <strong>HTML, PDF, manifest, and checksum are available. No public DOCX is authorized.</strong>
        </div>
        <div class="meta-line">
          <span>Boundary</span>
          <strong>{releaseState}</strong>
        </div>
      </aside>
    </section>
  </div>

  <div class="zone-b page-body page-body--standard">
    <article class="shell release-stack">
      <section class="release-section notice-section">
        <div class="registry-annotation section-tag">
          <span class="registry-key">BOUNDARY</span>: <span class="registry-value">NON_CLAIM</span>
        </div>
        <h2>Public research candidate route restored.</h2>
        <p class="section-lead">
          This page restores public access to the AIIRWP v1.0 research candidate and its HTML/PDF
          artifacts. The paper is an authored analytical research artifact for lifecycle evidence,
          underwriting-facing reviewability, claim reconstruction, and risk-transfer boundary analysis.
        </p>
        <ul class="non-goal-list">
          {nonGoals.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="release-section release-grid">
        <div>
          <div class="registry-annotation section-tag">
            <span class="registry-key">ARTIFACTS</span>
          </div>
          <h2>Read, download, and verify.</h2>
          <p class="section-lead">
            Public distribution is HTML and PDF, with manifest and checksum records for artifact
            verification. Source Markdown is not public in this wave.
          </p>
        </div>
        <div class="artifact-ledger">
          {artifactLinks.map((item, index) => (
            <a href={item.href}>
              <strong>{String(index + 1).padStart(2, "0")}</strong>
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="release-section release-grid">
        <div>
          <div class="registry-annotation section-tag">
            <span class="registry-key">CITATION</span>
          </div>
          <h2>Citation and version note.</h2>
          <p class="section-lead">{citationText}</p>
          <p class="section-lead">
            The prior AIIRWP v0.2 candidate remains rejected and withdrawn. It is historical
            traceability context only and is not the current source truth or citation source.
          </p>
        </div>
        <div class="integrity-panel">
          <div>
            <span>Document ID</span>
            <strong>{documentId}</strong>
          </div>
          <div>
            <span>Publication month</span>
            <strong>{publicationMonth}</strong>
          </div>
          {shaRows.map((row) => (
            <div>
              <span>{row.label}</span>
              <code>{row.value}</code>
            </div>
          ))}
        </div>
      </section>

      <section class="release-section release-grid">
        <div>
          <div class="registry-annotation section-tag">
            <span class="registry-key">CONCEPTS</span>
          </div>
          <h2>Risk-transfer analysis through lifecycle evidence.</h2>
          <p class="section-lead">
            AIIRWP connects the WP1 lifecycle-governance foundation and the WP2 auditability layer
            to risk-transfer reasoning, without turning evidence, reviewability, or governance into
            coverage, insurability, underwriting, pricing, or claim approval.
          </p>
        </div>
        <div class="concept-list">
          {keyConcepts.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      </section>

      <section class="release-section release-grid">
        <div>
          <div class="registry-annotation section-tag">
            <span class="registry-key">SERIES_CONTEXT</span>
          </div>
          <h2>Third paper in the lifecycle governance series.</h2>
          <p class="section-lead">
            The series relationship is preserved: GAIC defines the lifecycle-governance foundation,
            AIAAWP defines auditability and assurance evidence, and AIIRWP applies that evidence
            discipline to insurability and risk-transfer interpretation.
          </p>
        </div>
        <div class="series-ledger">
          {seriesLinks.map((item, index) => (
            <a href={item.href}>
              <strong>{String(index + 1).padStart(2, "0")}</strong>
              <span>{item.label}</span>
              <em>{item.body}</em>
            </a>
          ))}
        </div>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .release-hero-shell {
    min-height: 86svh;
    border-bottom: 1px solid var(--border-registry);
  }

  .release-hero {
    min-height: 86svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.38fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-top: clamp(7rem, 8vw, 8rem);
    padding-bottom: clamp(4rem, 6vw, 6rem);
  }

  .breadcrumb {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin-bottom: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-registry-muted);
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent-proof);
  }

  .status-line {
    margin-bottom: 1.1rem;
    color: var(--accent-proof);
  }

  .release-hero h1 {
    max-width: 14ch;
    margin: 0;
    color: var(--text-registry-primary);
    font-size: clamp(2.75rem, 7vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .release-subtitle {
    max-width: 48rem;
    margin: 1.25rem 0 0;
    color: var(--accent-proof);
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 1.1vw, 0.95rem);
    line-height: 1.55;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .release-thesis {
    max-width: 62rem;
    margin: 1.4rem 0 0;
    color: rgba(241, 245, 249, 0.8);
    font-size: clamp(1.06rem, 1.4vw, 1.2rem);
    line-height: 1.72;
  }

  .artifact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.7rem;
  }

  .artifact-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--accent-proof);
    color: var(--accent-proof);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .artifact-link:hover {
    background: var(--accent-proof);
    color: var(--bg-registry);
  }

  .release-meta-panel,
  .release-section {
    padding: var(--registry-panel-padding);
    border: 1px solid var(--border-registry);
    background: rgba(255, 255, 255, 0.035);
  }

  .release-meta-panel {
    display: grid;
    gap: 1.1rem;
  }

  .meta-line {
    display: grid;
    gap: 0.3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-registry);
  }

  .meta-line span,
  .integrity-panel span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-registry-muted);
  }

  .meta-line strong,
  .integrity-panel strong {
    color: var(--text-registry-primary);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .release-stack {
    display: grid;
    gap: var(--space-5);
  }

  .release-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(280px, 0.72fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .section-tag {
    margin-bottom: 0.9rem;
  }

  .release-section h2 {
    margin: 0;
    color: var(--current-text);
    font-size: clamp(1.7rem, 3vw, 2.45rem);
    line-height: 1.08;
  }

  .section-lead {
    margin: 1rem 0 0;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .notice-section {
    display: grid;
    gap: 1.1rem;
  }

  .non-goal-list {
    columns: 2;
    gap: 2rem;
    margin: 0;
    color: var(--current-muted);
    line-height: 1.7;
  }

  .artifact-ledger,
  .series-ledger,
  .integrity-panel,
  .concept-list {
    display: grid;
    border: 1px solid var(--current-line);
  }

  .artifact-ledger a,
  .series-ledger a,
  .concept-list a {
    display: grid;
    gap: 0.38rem;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--current-line);
  }

  .artifact-ledger a:last-child,
  .series-ledger a:last-child,
  .concept-list a:last-child {
    border-bottom: 0;
  }

  .artifact-ledger strong,
  .series-ledger strong,
  .series-ledger em {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--current-muted);
  }

  .artifact-ledger span,
  .series-ledger span,
  .concept-list a {
    color: var(--current-text);
    font-weight: 800;
  }

  .integrity-panel > div {
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
    border-bottom: 1px solid var(--current-line);
  }

  .integrity-panel > div:last-child {
    border-bottom: 0;
  }

  .integrity-panel code {
    overflow-wrap: anywhere;
    color: var(--current-text);
    font-size: 0.78rem;
  }

  @media (max-width: 900px) {
    .release-hero,
    .release-grid {
      grid-template-columns: 1fr;
    }

    .release-hero {
      min-height: auto;
    }

    .non-goal-list {
      columns: 1;
    }
  }
</style>
