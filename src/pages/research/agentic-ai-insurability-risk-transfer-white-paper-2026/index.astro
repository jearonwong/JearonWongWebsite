---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { siteConfig } from "../../../data/site";
import { createBreadcrumbJsonLd } from "../../../data/schema";

const canonicalPath = "/research/agentic-ai-insurability-risk-transfer-white-paper-2026/";
const pageUrl = `${siteConfig.siteUrl}${canonicalPath}`;
const gaicHubPath = "/research/global-ai-compliance-white-paper-2026/";
const aiaawpHubPath = "/research/agentic-ai-auditability-assurance-white-paper-2026/";
const reportTitle = "Agentic AI Insurability & Risk Transfer White Paper 2026";
const reportSubtitle = "A Lifecycle Evidence Guide for Underwriting, Claims, and Enterprise Risk Transfer";
const metaDescription =
  "The prior AIIRWP v0.2 public candidate has been withdrawn. WP3 is under a v1.0 rewrite and no current AIIRWP HTML, PDF, manifest, checksum, or DOCX artifact is promoted for citation.";
const statusNotes = [
  "Current public candidate withdrawn.",
  "WP3 v1.0 rewrite in progress.",
  "No current public AIIRWP HTML or PDF is promoted.",
  "No current public AIIRWP manifest or checksum is promoted.",
  "No public DOCX distribution.",
  "Not final.",
  "Not sealed.",
  "Not legal advice.",
  "Not insurance advice.",
  "Not a coverage opinion.",
  "Not an underwriting standard.",
  "Not claims approval guidance."
];
const nextSteps = [
  "Rebuild the source-of-truth registry for the whitepaper series.",
  "Run fresh WP3 v1.0 insurance-market source research.",
  "Define a v1.0 chapter architecture before drafting.",
  "Reconnect WP1 lifecycle governance and WP2 auditability only after the insurance-market argument is grounded."
];
const seriesLinks = [
  {
    label: "Global AI Compliance White Paper 2026",
    href: gaicHubPath,
    body: "The existing foundation white paper for lifecycle governance, Missing Regulatory Objects, RCCS-M, ALCS, and responsibility objects."
  },
  {
    label: "Agentic AI Auditability & Assurance White Paper 2026",
    href: aiaawpHubPath,
    body: "The existing auditability and assurance white paper for audit evidence chains, AARM, and MRO-to-audit-evidence mapping."
  },
  {
    label: "AIIRWP v1.0",
    href: canonicalPath,
    body: "The insurability and risk-transfer white paper is under rewrite. The withdrawn v0.2 candidate is not the current source of truth."
  }
];
const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: reportTitle,
  description: metaDescription,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  about: [
    "Agentic AI Insurability",
    "Risk Transfer",
    "Claim Evidence Chain",
    "Lifecycle Evidence"
  ].map((name) => ({
    "@type": "Thing",
    name
  })),
  creativeWorkStatus: "WithdrawnForRewrite",
  breadcrumb: {
    "@id": `${pageUrl}#breadcrumb`
  }
};
const breadcrumbJsonLd = createBreadcrumbJsonLd(pageUrl, [
  { name: "Home", path: "/" },
  { name: "Research", path: "/research/" },
  { name: reportTitle, path: canonicalPath }
]);
---

<BaseLayout
  title={`${reportTitle} — Under v1.0 Rewrite`}
  description={metaDescription}
  shareTitle={`${reportTitle} — Under v1.0 Rewrite`}
  shareDescription={metaDescription}
  twitterTitle={`${reportTitle} — Under v1.0 Rewrite`}
  twitterDescription={metaDescription}
  canonicalPath={canonicalPath}
  noindex={true}
  jsonLd={[pageJsonLd, breadcrumbJsonLd]}
  keywords={[
    "Agentic AI Insurability",
    "AI risk transfer",
    "claim evidence chain",
    "lifecycle evidence",
    "AIIRWP v1.0 rewrite"
  ]}
  ogImagePath="/social/jearonwong-og.png"
  ogImageAlt="Agentic AI Insurability & Risk Transfer White Paper 2026 under v1.0 rewrite"
>
  <div class="zone-a registry-grid hold-hero-shell">
    <SiteHeader />
    <section class="shell hold-hero">
      <div class="hold-hero__copy">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/research/">Research</a>
        </nav>
        <div class="registry-annotation status-line">
          <span class="registry-key">STATUS</span>: <span class="registry-value">WITHDRAWN_FOR_V1_REWRITE</span>
        </div>
        <h1>{reportTitle}</h1>
        <p class="release-subtitle">{reportSubtitle}</p>
        <p class="release-thesis">
          The prior AIIRWP v0.2 public candidate has been withdrawn by owner decision and is no longer
          promoted as a current public research candidate or citation source. WP3 is being reopened as
          AIIRWP v1.0.
        </p>
      </div>
      <aside class="hold-meta-panel" aria-label="AIIRWP rewrite status">
        <div class="registry-annotation">
          <span class="registry-key">PUBLIC_ACTION</span>: <span class="registry-value">EMERGENCY_HOLD</span>
        </div>
        <div class="meta-line">
          <span>Prior candidate</span>
          <strong>v0.2 rejected and withdrawn</strong>
        </div>
        <div class="meta-line">
          <span>Current direction</span>
          <strong>v1.0 rewrite in progress</strong>
        </div>
        <div class="meta-line">
          <span>Artifacts</span>
          <strong>No current public HTML, PDF, manifest, checksum, or DOCX is promoted.</strong>
        </div>
      </aside>
    </section>
  </div>

  <div class="zone-b page-body page-body--standard">
    <article class="shell hold-stack">
      <section class="hold-section hold-grid">
        <div>
          <div class="registry-annotation section-tag">
            <span class="registry-key">WHY_WITHDRAWN</span>
          </div>
          <h2>Current candidate withdrawn for v1.0 rewrite.</h2>
          <p class="section-lead">
            The v0.2 candidate did not meet the publication-grade depth required for the third
            white paper in the series. The rewrite must rebuild the insurance-market argument,
            clarify insured subject versus agentic risk object, connect underwriting and claims
            reasoning, and close the loop from WP1 and WP2.
          </p>
        </div>
        <ul class="status-list">
          {statusNotes.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="hold-section hold-grid">
        <div>
          <div class="registry-annotation section-tag">
            <span class="registry-key">SERIES_CONTEXT</span>
          </div>
          <h2>Series relationship preserved, artifact promotion removed.</h2>
          <p class="section-lead">
            WP1 and WP2 remain the current public foundations. WP3 remains the intended
            insurability and risk-transfer paper, but its current public body has been withdrawn
            until the v1.0 rewrite is accepted.
          </p>
        </div>
        <div class="series-ledger">
          {seriesLinks.map((item, index) => (
            <a href={item.href}>
              <strong>{String(index + 1).padStart(2, "0")}</strong>
              <span>{item.label}</span>
              <em>{item.body}</em>
            </a>
          ))}
        </div>
      </section>

      <section class="hold-section hold-grid">
        <div>
          <div class="registry-annotation section-tag">
            <span class="registry-key">NEXT_WORK</span>
          </div>
          <h2>v1.0 rewrite baseline.</h2>
          <p class="section-lead">
            The next WP3 work is source research and rewrite architecture, not public release
            execution and not polishing the withdrawn 27-page candidate.
          </p>
        </div>
        <ol class="next-list">
          {nextSteps.map((item) => <li>{item}</li>)}
        </ol>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .hold-hero-shell {
    min-height: 82svh;
    border-bottom: 1px solid var(--border-registry);
  }

  .hold-hero {
    min-height: 82svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.38fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-top: clamp(7rem, 8vw, 8rem);
    padding-bottom: clamp(4rem, 6vw, 6rem);
  }

  .breadcrumb {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin-bottom: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-registry-muted);
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent-proof);
  }

  .status-line {
    margin-bottom: 1.1rem;
    color: var(--accent-proof);
  }

  .hold-hero h1 {
    max-width: 14ch;
    margin: 0;
    color: var(--text-registry-primary);
    font-size: clamp(2.8rem, 7vw, 5.7rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .release-subtitle {
    max-width: 46rem;
    margin: 1.25rem 0 0;
    color: var(--accent-proof);
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 1.1vw, 0.95rem);
    line-height: 1.55;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .release-thesis {
    max-width: 58rem;
    margin: 1.4rem 0 0;
    color: rgba(241, 245, 249, 0.78);
    font-size: clamp(1.06rem, 1.4vw, 1.2rem);
    line-height: 1.72;
  }

  .hold-meta-panel,
  .hold-section {
    padding: var(--registry-panel-padding);
    border: 1px solid var(--border-registry);
    background: rgba(255, 255, 255, 0.035);
  }

  .hold-meta-panel {
    display: grid;
    gap: 1.1rem;
  }

  .meta-line {
    display: grid;
    gap: 0.3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-registry);
  }

  .meta-line span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-registry-muted);
  }

  .meta-line strong {
    color: var(--text-registry-primary);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .hold-stack {
    display: grid;
    gap: var(--space-5);
  }

  .hold-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(280px, 0.72fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .section-tag {
    margin-bottom: 0.9rem;
  }

  .hold-section h2 {
    margin: 0;
    color: var(--current-text);
    font-size: clamp(1.7rem, 3vw, 2.45rem);
    line-height: 1.08;
  }

  .section-lead {
    margin: 1rem 0 0;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .status-list,
  .next-list {
    margin: 0;
    display: grid;
    gap: 0.7rem;
    color: var(--current-muted);
    line-height: 1.55;
  }

  .series-ledger {
    display: grid;
    border: 1px solid var(--current-line);
  }

  .series-ledger a {
    display: grid;
    gap: 0.38rem;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--current-line);
  }

  .series-ledger a:last-child {
    border-bottom: 0;
  }

  .series-ledger strong,
  .series-ledger em {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--current-muted);
  }

  .series-ledger span {
    color: var(--current-text);
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .hold-hero,
    .hold-grid {
      grid-template-columns: 1fr;
    }

    .hold-hero {
      min-height: auto;
    }
  }
</style>
