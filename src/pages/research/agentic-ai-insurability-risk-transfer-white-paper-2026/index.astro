---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { siteConfig } from "../../../data/site";

const canonicalPath = "/research/agentic-ai-insurability-risk-transfer-white-paper-2026/";
const pageUrl = `${siteConfig.siteUrl}${canonicalPath}`;
const reportTitle = "Agentic AI Insurability & Risk Transfer White Paper 2026";
const reportSubtitle = "A Lifecycle Evidence Guide for Underwriting, Claims, and Enterprise Risk Transfer";
const metaDescription =
  "AIIRWP is under editorial review after a publication quality reset. The current staged artifact is not promoted as a release-quality white paper while the body is rewritten.";
const gaicHubPath = "/research/global-ai-compliance-white-paper-2026/";
const aiaawpHubPath = "/research/agentic-ai-auditability-assurance-white-paper-2026/";
const statusNotes = [
  "Current public artifact promotion is paused.",
  "HTML and PDF download CTAs are temporarily unavailable.",
  "The previous staged body is being treated as an internal evidence and source pack.",
  "A publication-grade rewrite must pass the Whitepaper Body Quality Gate before a new candidate is generated."
];
const rewritePrinciples = [
  "Industry pain and reader understanding must come before object models.",
  "Evidence supports the argument; evidence cannot replace the argument.",
  "AIO and AIRM must emerge from the problem, not appear as raw mapping inventory.",
  "Raw source markers, internal QA labels, and pipeline language must not appear in the public body.",
  "The rewritten paper must match the GAIC/AIAAWP publication tone and visual standard."
];
const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: reportTitle,
  description: metaDescription,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  creativeWorkStatus: "UnderEditorialReview",
  about: [
    { "@type": "Thing", name: "Agentic AI Insurability" },
    { "@type": "Thing", name: "Risk Transfer" },
    { "@type": "Thing", name: "Lifecycle Evidence" }
  ]
};
---

<BaseLayout
  title={reportTitle}
  description={metaDescription}
  shareTitle={`${reportTitle} — Under Editorial Review`}
  shareDescription={metaDescription}
  twitterTitle={`${reportTitle} — Under Editorial Review`}
  twitterDescription={metaDescription}
  canonicalPath={canonicalPath}
  noindex={true}
  jsonLd={[pageJsonLd]}
  keywords={[
    "Agentic AI Insurability",
    "AI risk transfer",
    "lifecycle evidence",
    "whitepaper editorial review",
    "Agentic Lifecycle Governance"
  ]}
  ogImagePath="/social/jearonwong-og.png"
  ogImageAlt="AIIRWP editorial review placeholder by Jearon Wong"
>
  <div class="zone-a registry-grid hold-hero-shell">
    <SiteHeader />
    <section class="shell hold-hero">
      <div class="hold-copy">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/research/">Research</a>
        </nav>
        <div class="registry-annotation hold-status">
          <span class="registry-key">STATUS</span>: <span class="registry-value">UNDER EDITORIAL REVIEW</span>
        </div>
        <h1>{reportTitle}</h1>
        <p class="hold-subtitle">{reportSubtitle}</p>
        <p class="hold-thesis">
          The AIIRWP public route is temporarily held for publication-quality reset. The previously
          staged artifact is being treated as an internal evidence and source pack, not as the
          release-quality public white paper body.
        </p>
      </div>
      <aside class="hold-panel" aria-label="Editorial review status">
        <strong>Publication hold</strong>
        <p>
          Public promotion and artifact CTAs are paused while the paper is rewritten around a
          coherent industry problem definition, explanatory argument, and evidence-backed thesis.
        </p>
      </aside>
    </section>
  </div>

  <div class="zone-b page-body page-body--standard">
    <article class="shell hold-stack">
      <section class="registry-chassis hold-section">
        <div class="registry-annotation">
          <span class="registry-key">R9_HOLD</span>: <span class="registry-value">PUBLICATION_QUALITY_RESET</span>
        </div>
        <h2>Why this route is held.</h2>
        <p>
          R7B verified that the route and artifacts were technically reachable. R9 corrects a different
          problem: the staged body did not read like a publication-grade industry white paper. It exposed
          internal source, evidence, QA, and mapping scaffolding that belongs in an evidence package, not
          in the reader-facing body.
        </p>
        <ul class="hold-list">
          {statusNotes.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="registry-chassis hold-section">
        <div class="registry-annotation">
          <span class="registry-key">R10_DIRECTION</span>: <span class="registry-value">PUBLICATION_GRADE_REWRITE</span>
        </div>
        <h2>Rewrite direction.</h2>
        <p>
          The next candidate must first explain the industry problem: why existing AI insurance logic is
          fragmented, why agentic workflows cross policy boundaries, and why claims reconstruction needs
          lifecycle evidence. AIO and AIRM should appear only after the reader understands the problem.
        </p>
        <ul class="hold-list">
          {rewritePrinciples.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="registry-chassis hold-section hold-grid">
        <div>
          <div class="registry-annotation">
            <span class="registry-key">SERIES_CONTEXT</span>
          </div>
          <h2>Series context remains.</h2>
          <p>
            GAIC remains the root lifecycle governance paper. AIAAWP remains the auditability and
            assurance interpretation. AIIRWP remains planned as the insurability and risk-transfer
            interpretation, but the current body is under revision.
          </p>
        </div>
        <div class="hold-links">
          <a href={gaicHubPath}>Global AI Compliance White Paper 2026</a>
          <a href={aiaawpHubPath}>Agentic AI Auditability & Assurance White Paper 2026</a>
          <a href="/research/">Research index</a>
          <a href="/evidence/">Evidence Registry</a>
        </div>
      </section>

      <section class="registry-chassis boundary-panel">
        <strong>Boundary statement</strong>
        <p>
          This page does not claim Final Seal, release execution, external adoption, indexing,
          SEO/GEO uplift, answer-engine recognition, insurer acceptance, coverage-ready status,
          underwriting-ready status, certification, endorsement, insurance advice, legal advice,
          coverage opinion, underwriting standard, actuarial pricing guidance, or claims approval
          guidance.
        </p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .hold-hero-shell {
    min-height: 82svh;
    border-bottom: 1px solid var(--border-registry);
  }

  .hold-hero {
    min-height: 82svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.38fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-top: clamp(7rem, 8vw, 8rem);
    padding-bottom: clamp(4rem, 6vw, 6rem);
  }

  .breadcrumb {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin-bottom: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-registry-muted);
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent-proof);
  }

  .hold-status {
    margin-bottom: 1.1rem;
    color: var(--accent-proof);
  }

  .hold-hero h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--text-registry-primary);
    font-size: clamp(3rem, 7vw, 6.2rem);
    line-height: 0.94;
    letter-spacing: 0;
  }

  .hold-subtitle {
    max-width: 45rem;
    margin: 1.25rem 0 0;
    color: var(--accent-proof);
    font-family: var(--font-mono);
    font-size: clamp(0.84rem, 1.15vw, 0.96rem);
    line-height: 1.55;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hold-thesis {
    max-width: 52rem;
    margin: 1.4rem 0 0;
    color: rgba(241, 245, 249, 0.78);
    font-size: clamp(1.08rem, 1.4vw, 1.22rem);
    line-height: 1.62;
  }

  .hold-panel,
  .boundary-panel {
    border: 1px solid rgba(148, 163, 184, 0.26);
    background: rgba(15, 23, 42, 0.56);
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }

  .hold-panel strong,
  .boundary-panel strong {
    display: block;
    color: var(--text-registry-primary);
    font-size: 1.05rem;
    margin-bottom: 0.8rem;
  }

  .hold-panel p,
  .boundary-panel p {
    margin: 0;
    color: var(--current-muted);
    line-height: 1.7;
  }

  .hold-stack {
    display: grid;
    gap: var(--space-5);
  }

  .hold-section {
    padding: var(--registry-panel-padding);
  }

  .hold-section h2 {
    margin: 0.9rem 0 1rem;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: 0;
    color: var(--current-text);
  }

  .hold-section p {
    max-width: 74ch;
    margin: 0;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .hold-list {
    display: grid;
    gap: 0.8rem;
    margin: 1.4rem 0 0;
    padding-left: 1.2rem;
    color: var(--current-muted);
    line-height: 1.65;
  }

  .hold-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.34fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .hold-links {
    display: grid;
    gap: 0.75rem;
  }

  .hold-links a {
    display: block;
    border: 1px solid var(--current-line);
    padding: 0.85rem 1rem;
    color: var(--accent-signal);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hold-links a:hover {
    color: var(--current-text);
    border-color: var(--accent-signal);
  }

  @media (max-width: 820px) {
    .hold-hero,
    .hold-grid {
      grid-template-columns: 1fr;
    }

    .hold-hero h1 {
      max-width: 12ch;
      font-size: clamp(2.7rem, 15vw, 4.2rem);
    }
  }
</style>
