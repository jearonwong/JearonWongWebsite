---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { siteConfig } from "../../../data/site";

const assetBase = "/research/agentic-ai-auditability-assurance-white-paper-2026";
const canonicalPath = "/research/agentic-ai-auditability-assurance-white-paper-2026/";
const pageUrl = `${siteConfig.siteUrl}${canonicalPath}`;
const pdfUrl = `${siteConfig.siteUrl}${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.pdf`;
const htmlUrl = `${siteConfig.siteUrl}${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.html`;
const manifestUrl = `${siteConfig.siteUrl}${assetBase}/manifest.json`;
const checksumUrl = `${siteConfig.siteUrl}${assetBase}/checksums.sha256`;
const gaicHubPath = "/research/global-ai-compliance-white-paper-2026/";
const documentId = "AIAAWP-2026-v0.1-R4-CANDIDATE";
const reportTitle = "Agentic AI Auditability & Assurance White Paper 2026";
const reportSubtitle = "A Lifecycle Evidence Guide for Audit, Assurance, and Enterprise AI Governance";
const reportVersion = "v0.1 Public Research Candidate";
const publicationMonth = "May 2026";
const metaDescription =
  "A public research candidate by Jearon Wong defining agentic AI auditability, lifecycle evidence, audit evidence chains, AARM, MRO-to-audit-evidence mapping, and enterprise AI governance boundaries.";
const citationText =
  "Jearon Wong. Agentic AI Auditability & Assurance White Paper 2026: A Lifecycle Evidence Guide for Audit, Assurance, and Enterprise AI Governance. Technical Report AIAAWP-2026-v0.1-R4-CANDIDATE, May 2026.";
const citationKeywords =
  "Agentic AI Auditability; AI Agent Auditability; Audit Evidence Chain; Agentic Audit Object; AARM; MRO; Agentic Lifecycle Governance; Enterprise AI Governance; Lifecycle Evidence";
const citationMetaTags = [
  { name: "citation_title", content: `${reportTitle}: ${reportSubtitle}` },
  { name: "citation_author", content: "Wong, Jearon" },
  { name: "citation_publication_date", content: "2026/05" },
  { name: "citation_technical_report_number", content: documentId },
  { name: "citation_pdf_url", content: pdfUrl },
  { name: "citation_fulltext_html_url", content: htmlUrl },
  { name: "citation_language", content: "en" },
  { name: "citation_keywords", content: citationKeywords }
];
const shaRows = [
  {
    label: "HTML web-reading candidate",
    value: "4c728e7f1202afc69622c1fc60a2eb5ee1daaed6e319c2060f01e001c53a82e4"
  },
  {
    label: "PDF visual candidate",
    value: "a034219994b245bcfbc359e97155557501d4baf814bbe6fe7a39d900f2d6f45c"
  },
  {
    label: "Manifest",
    value: "b738aed6db61864fd95b811201a744171527eae350e3cd83f8214b54b0c9bca0"
  }
];
const keyConcepts = [
  { label: "Agentic AI Auditability", href: `${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.html#executive-thesis` },
  { label: "Agentic Audit Object", href: `${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.html#agentic-audit-object-overview` },
  { label: "Audit Evidence Chain", href: `${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.html#4-why-logs-are-not-audit-evidence-chains` },
  { label: "AARM", href: `${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.html#13-agentic-auditability-readiness-model` },
  { label: "MRO-to-Audit-Evidence Mapping", href: `${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.html#6-mro-to-audit-evidence-mapping` },
  { label: "Lifecycle-responsibility-linked agent work", href: "/concepts/agentic-lifecycle-governance/" },
  { label: "Accepted Outcome", href: "/concepts/accepted-outcome/" },
  { label: "Tool-action evidence", href: `${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.html#5-the-agentic-audit-object-model` },
  { label: "Remediation Closure", href: `${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.html#11-exception-dispute-and-remediation-closure` },
  { label: "Privacy and selective disclosure", href: `${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.html#10-privacy-selective-disclosure-and-audit-evidence-minimization` }
];
const seriesLinks = [
  {
    label: "Global AI Compliance White Paper 2026",
    href: gaicHubPath,
    body: "Defines the broader compliance object layer, Missing Regulatory Objects, RCCS-M, ALCS, and lifecycle responsibility governance."
  },
  {
    label: "AIAAWP 2026",
    href: canonicalPath,
    body: "Stages the auditability and lifecycle evidence layer for author release decision and deployment verification."
  },
  {
    label: "Future Guide 1",
    href: "/playbooks/agentic-delivery-architecture-checklist/",
    body: "Will translate audit-ready AI agent systems into CIO/CTO implementation planning."
  },
  {
    label: "Future Guide 2",
    href: "/governance/",
    body: "Will translate agentic lifecycle governance into CCO operating-model planning."
  }
];
const nonGoals = [
  "Not an audit standard.",
  "Not certification.",
  "Not legal advice or legal compliance proof.",
  "Not an assurance opinion.",
  "Not regulator approval.",
  "Not Big Four or audit-body endorsement.",
  "Not procurement recommendation or vendor ranking.",
  "MPLP is an optional protocol path only."
];
const contextLinks = [
  { href: gaicHubPath, label: "GAIC main white paper hub" },
  { href: "/evidence/", label: "Evidence Registry / Citation Kit" },
  { href: "/definitions/", label: "Definitions index" },
  { href: "/concepts/map/", label: "Concepts Map / Entity Mesh" },
  { href: "/concepts/agentic-lifecycle-governance/", label: "Agentic Lifecycle Governance" },
  { href: "/concepts/missing-regulatory-objects/", label: "Missing Regulatory Objects" },
  { href: "/concepts/lifecycle-evidence/", label: "Evidence Chain" },
  { href: "/concepts/accepted-outcome/", label: "Accepted Outcome" },
  { href: "/projects/mplp/", label: "MPLP protocol path" },
  { href: "/projects/validation-lab/", label: "Validation Lab" },
  { href: "/governance/", label: "Regulatory and enterprise governance" },
  { href: "/playbooks/", label: "Applied playbooks" },
  { href: "/mapping/extended-ecosystem/", label: "Extended ecosystem mapping" }
];
const aboutTerms = [
  "Agentic AI Auditability",
  "AI Agent Auditability",
  "Audit Evidence Chain",
  "Agentic Audit Object",
  "Agentic Lifecycle Governance",
  "Global AI Compliance White Paper 2026",
  "Missing Regulatory Objects",
  "MRO-to-Audit-Evidence Mapping",
  "AARM",
  "Lifecycle Evidence",
  "Accepted Outcome",
  "Authority Boundary",
  "Enterprise AI Governance",
  "AI Agent Governance",
  "Auditability Readiness"
];
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": ["TechArticle", "Report"],
  "@id": `${pageUrl}#whitepaper`,
  headline: reportTitle,
  alternativeHeadline: reportSubtitle,
  description: metaDescription,
  url: pageUrl,
  identifier: documentId,
  inLanguage: "en",
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  publisher: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  datePublished: "2026-05-18",
  dateModified: "2026-05-18",
  version: reportVersion,
  genre: "Technical report",
  creativeWorkStatus: "PublicationCandidate",
  citation: citationText,
  keywords: aboutTerms,
  isBasedOn: {
    "@type": "CreativeWork",
    name: "Global AI Compliance White Paper 2026",
    url: `${siteConfig.siteUrl}${gaicHubPath}`
  },
  isPartOf: [
    {
      "@type": "CreativeWorkSeries",
      name: "Agentic Lifecycle Governance Industry Series"
    },
    {
      "@id": `${siteConfig.siteUrl}#website`
    }
  ],
  about: aboutTerms.map((term) => ({
    "@type": "Thing",
    name: term
  })),
  mentions: [
    "AARM",
    "MRO",
    "Audit Evidence Chain",
    "Agentic Audit Object",
    "Validation Lab",
    "MPLP",
    "Enterprise AI Governance"
  ].map((term) => ({
    "@type": "Thing",
    name: term
  })),
  encoding: [
    {
      "@type": "MediaObject",
      encodingFormat: "text/html",
      contentUrl: htmlUrl,
      sha256: shaRows[0].value
    },
    {
      "@type": "MediaObject",
      encodingFormat: "application/pdf",
      contentUrl: pdfUrl,
      sha256: shaRows[1].value
    }
  ],
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`
  }
};
const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: reportTitle,
  description: metaDescription,
  breadcrumb: {
    "@id": `${pageUrl}#breadcrumb`
  },
  mainEntity: {
    "@id": `${pageUrl}#whitepaper`
  }
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.siteUrl
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Research",
      item: `${siteConfig.siteUrl}/research/`
    },
    {
      "@type": "ListItem",
      position: 3,
      name: reportTitle,
      item: pageUrl
    }
  ]
};
const artifactListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#artifacts`,
  name: "AIAAWP public research candidate artifacts",
  itemListElement: [
    { name: "Read HTML", url: htmlUrl },
    { name: "Download PDF", url: pdfUrl },
    { name: "Manifest", url: manifestUrl },
    { name: "Checksums", url: checksumUrl }
  ].map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    url: item.url
  }))
};
const definedTermSetJsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": `${pageUrl}#defined-terms`,
  name: "AIAAWP 2026 Terms",
  description: "Key terms used by the Agentic AI Auditability & Assurance White Paper 2026.",
  hasDefinedTerm: aboutTerms.slice(0, 10).map((term) => ({
    "@type": "DefinedTerm",
    name: term,
    inDefinedTermSet: `${pageUrl}#defined-terms`
  }))
};
---

<BaseLayout
  title={reportTitle}
  description={metaDescription}
  shareTitle={reportTitle}
  shareDescription={metaDescription}
  twitterTitle={reportTitle}
  twitterDescription={metaDescription}
  canonicalPath={canonicalPath}
  ogType="article"
  jsonLd={[pageJsonLd, articleJsonLd, breadcrumbJsonLd, artifactListJsonLd, definedTermSetJsonLd]}
  keywords={aboutTerms}
  metaTags={citationMetaTags}
  ogImagePath="/social/jearonwong-og.png"
  ogImageAlt="Agentic AI Auditability & Assurance White Paper 2026 by Jearon Wong"
>
  <div class="zone-a registry-grid release-hero-shell">
    <SiteHeader />
    <section class="shell release-hero">
      <div class="release-hero__copy">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/research/">Research</a>
        </nav>
        <h1>{reportTitle}</h1>
        <p class="release-subtitle">{reportSubtitle}</p>
        <p class="release-thesis">
          This public research candidate defines auditability for AI agent and multi-agent work as
          lifecycle evidence: reconstructable authority, roles, tool actions, accepted outcomes,
          exceptions, remediation, and privacy-preserving disclosure boundaries.
        </p>
        <div class="hero-actions" aria-label="White paper actions">
          <a href={`${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.html`} class="button button-primary">Read HTML</a>
          <a href={`${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.pdf`} class="button button-outline">Download PDF</a>
          <a href="#cite" class="button button-outline">Cite this paper</a>
        </div>
      </div>
      <aside class="release-meta-panel" aria-label="Release metadata">
        <div class="registry-annotation">
          <span class="registry-key">STATUS</span>: <span class="registry-value">PUBLIC_RESEARCH_CANDIDATE</span>
        </div>
        <div class="meta-line">
          <span>Document ID</span>
          <strong>{documentId}</strong>
        </div>
        <div class="meta-line">
          <span>Release state</span>
          <strong>Publication staged; deployment verification required.</strong>
        </div>
        <div class="meta-line">
          <span>Artifact role model</span>
          <strong>Public distribution exposes HTML and PDF only.</strong>
        </div>
      </aside>
    </section>
  </div>

  <div class="zone-b page-body page-body--standard">
    <article class="shell release-stack">
      <section class="release-section release-grid">
        <div>
          <div class="registry-annotation section-tag">
            <span class="registry-key">SERIES</span>: <span class="registry-value">AGENTIC_LIFECYCLE_GOVERNANCE</span>
          </div>
          <h2>Part of the same white paper standard.</h2>
          <p class="section-lead">
            AIAAWP inherits the GAIC publication shell, responsive reading model,
            metadata discipline, checksum pattern, and boundary language. It builds on GAIC by turning
            lifecycle responsibility objects into audit evidence objects.
          </p>
        </div>
        <div class="series-ledger">
          {seriesLinks.map((item, index) => (
            <a href={item.href}>
              <strong>{String(index + 1).padStart(2, "0")}</strong>
              <span>{item.label}</span>
              <em>{item.body}</em>
            </a>
          ))}
        </div>
      </section>

      <section class="release-section release-grid">
        <div>
          <div class="registry-annotation section-tag">
            <span class="registry-key">KEY_CONCEPTS</span>
          </div>
          <h2>Key concepts covered.</h2>
          <p class="section-lead">
            The paper distinguishes raw logs from audit evidence chains and frames auditability as
            responsibility-linked evidence that can support readiness discussion without becoming a
            standard, legal conclusion, certification, or assurance opinion.
          </p>
        </div>
        <div class="concept-ledger">
          {keyConcepts.map((concept, index) => (
            <a href={concept.href}><strong>{String(index + 1).padStart(2, "0")}</strong>{concept.label}</a>
          ))}
        </div>
      </section>

      <section class="release-section" aria-labelledby="download-title">
        <div class="section-heading-row">
          <div>
            <div class="registry-annotation section-tag">
              <span class="registry-key">ARTIFACTS</span>
            </div>
            <h2 id="download-title">Read, download, and verify.</h2>
          </div>
          <a href={`${assetBase}/checksums.sha256`} class="section-side-link">View checksums</a>
        </div>
        <div class="artifact-grid">
          <a href={`${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.html`} class="artifact-card">
            <span class="artifact-kind">HTML</span>
            <strong>Read full HTML</strong>
            <span>Responsive web-reading visual authority</span>
          </a>
          <a href={`${assetBase}/agentic-ai-auditability-assurance-white-paper-2026.pdf`} class="artifact-card">
            <span class="artifact-kind">PDF</span>
            <strong>Download PDF</strong>
            <span>Fixed-layout visual authority</span>
          </a>
          <a href={`${assetBase}/manifest.json`} class="artifact-card">
            <span class="artifact-kind">JSON</span>
            <strong>Public staging manifest</strong>
            <span>Artifact role model and integrity record</span>
          </a>
          <a href={`${assetBase}/checksums.sha256`} class="artifact-card">
            <span class="artifact-kind">SHA256</span>
            <strong>Checksums</strong>
            <span>Public artifact hashes</span>
          </a>
        </div>
      </section>

      <section id="cite" class="release-section release-grid" aria-labelledby="citation-title">
        <div>
          <div class="registry-annotation section-tag">
            <span class="registry-key">CITATION_IDENTITY</span>
          </div>
          <h2 id="citation-title">Citation and artifact identity.</h2>
          <p class="citation-block">{citationText}</p>
          <dl class="identity-ledger" aria-label="Technical report identity">
            <div><dt>Title</dt><dd>{reportTitle}</dd></div>
            <div><dt>Subtitle</dt><dd>{reportSubtitle}</dd></div>
            <div><dt>Author</dt><dd>Jearon Wong</dd></div>
            <div><dt>Document ID</dt><dd>{documentId}</dd></div>
            <div><dt>Status</dt><dd>{reportVersion}; deployment verification required.</dd></div>
            <div><dt>Publication month</dt><dd>{publicationMonth}</dd></div>
            <div><dt>Canonical URL</dt><dd><a href={pageUrl}>{pageUrl}</a></dd></div>
            <div><dt>HTML full text</dt><dd><a href={htmlUrl}>{htmlUrl}</a></dd></div>
            <div><dt>PDF</dt><dd><a href={pdfUrl}>{pdfUrl}</a></dd></div>
            <div><dt>Manifest</dt><dd><a href={manifestUrl}>{manifestUrl}</a></dd></div>
            <div><dt>Checksums</dt><dd><a href={checksumUrl}>{checksumUrl}</a></dd></div>
          </dl>
        </div>
        <div class="boundary-panel">
          <strong>Boundary statement</strong>
          <p>
            This page stages a public research candidate. It does not claim production live verification,
            final release, sealed artifact status, legal compliance proof, audit standard status,
            certification, regulator approval, assurance opinion, procurement guidance, vendor ranking,
            or endorsement by any firm or professional body.
          </p>
        </div>
      </section>

      <section class="release-section release-grid" aria-labelledby="non-goals-title">
        <div>
          <div class="registry-annotation section-tag">
            <span class="registry-key">NON_GOALS</span>: <span class="registry-value">BOUNDARY_SAFE</span>
          </div>
          <h2 id="non-goals-title">What the paper does not do.</h2>
          <p class="section-lead">
            The candidate is meant for source-grounded research, readiness discussion, and later author
            release decision. Its boundary language is part of the publication standard.
          </p>
        </div>
        <ul class="non-goal-list">
          {nonGoals.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="release-section" aria-labelledby="integrity-title">
        <div class="section-heading-row">
          <div>
            <div class="registry-annotation section-tag">
              <span class="registry-key">INTEGRITY</span>
            </div>
            <h2 id="integrity-title">Artifact integrity.</h2>
          </div>
          <a href={`${assetBase}/manifest.json`} class="section-side-link">Open manifest</a>
        </div>
        <div class="integrity-grid">
          <div class="commit-ledger">
            <div><span>R5A SOP commit</span><strong>5c05972fe57189bd4d6ae35948429767c9de0735</strong></div>
            <div><span>Document ID</span><strong>{documentId}</strong></div>
            <div><span>Page count</span><strong>141</strong></div>
            <div><span>Next phase</span><strong>Deployment/live verification</strong></div>
          </div>
          <div class="checksum-table" aria-label="SHA256 checksums">
            {shaRows.map((row) => (
              <div class="checksum-row">
                <span>{row.label}</span>
                <code>{row.value}</code>
              </div>
            ))}
          </div>
        </div>
        <p class="integrity-note">
          Public artifacts were staged from the R5 internal final candidate package, then normalized only
          for public-copy status and metadata. The internal R5 candidate package remains unchanged.
        </p>
      </section>

      <section class="release-section release-grid" aria-labelledby="context-title">
        <div>
          <div class="registry-annotation section-tag">
            <span class="registry-key">CONTEXT</span>
          </div>
          <h2 id="context-title">Follow the surrounding graph.</h2>
          <p class="section-lead">
            AIAAWP belongs to the Agentic Lifecycle Governance Industry Series and should be read with
            GAIC, the Evidence Registry, and the concept graph rather than as a standalone design system.
          </p>
        </div>
        <div class="internal-link-grid">
          {contextLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .release-hero-shell {
    min-height: 100svh;
    border-bottom: 1px solid var(--border-registry);
  }

  .release-hero {
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.42fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-top: clamp(7rem, 8vw, 8rem);
    padding-bottom: clamp(4rem, 6vw, 6rem);
  }

  .breadcrumb {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    margin-bottom: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-registry-muted);
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent-proof);
  }

  .release-hero h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--text-registry-primary);
    font-size: clamp(3rem, 7vw, 6.45rem);
    line-height: 0.94;
    letter-spacing: 0;
  }

  .release-subtitle {
    max-width: 44rem;
    margin: 1.25rem 0 0;
    color: var(--accent-proof);
    font-family: var(--font-mono);
    font-size: clamp(0.84rem, 1.15vw, 0.96rem);
    line-height: 1.55;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .release-thesis {
    max-width: 50rem;
    margin: 1.4rem 0 0;
    color: rgba(241, 245, 249, 0.76);
    font-size: clamp(1.06rem, 1.65vw, 1.25rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .release-meta-panel {
    display: grid;
    gap: 1.1rem;
    padding: var(--registry-card-padding);
    border: 1px solid var(--border-registry);
    background: rgba(26, 26, 26, 0.84);
    backdrop-filter: blur(10px);
  }

  .meta-line {
    display: grid;
    gap: 0.35rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-registry);
  }

  .meta-line span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--text-registry-muted);
    text-transform: uppercase;
  }

  .meta-line strong {
    color: var(--text-registry-primary);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .release-stack {
    display: grid;
    gap: var(--space-8);
  }

  .release-section {
    display: grid;
    gap: 1.35rem;
  }

  .release-grid {
    grid-template-columns: minmax(0, 0.95fr) minmax(280px, 0.55fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .section-tag {
    margin-bottom: 0.85rem;
  }

  .release-section h2 {
    max-width: 17ch;
    margin: 0;
    color: var(--current-text);
    font-size: clamp(2rem, 4vw, 3.35rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .section-lead {
    max-width: 66ch;
    margin: 1rem 0 0;
    color: var(--current-muted);
    font-size: 1.04rem;
    line-height: 1.75;
  }

  .concept-ledger,
  .series-ledger,
  .internal-link-grid {
    display: grid;
    border-top: 1px solid var(--current-line);
  }

  .concept-ledger a,
