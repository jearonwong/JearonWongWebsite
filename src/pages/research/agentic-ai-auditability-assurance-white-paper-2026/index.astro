---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WhitePaperPublicationPage from "../../../components/WhitePaperPublicationPage.astro";
import {
  createWhitePaperCitationMetaTags,
  createWhitePaperJsonLd,
  getWhitePaperPublication
} from "../../../data/whitepaperPublications";

const paper = getWhitePaperPublication("wp2-aiaawp");
---

<BaseLayout
  title={paper.title}
  description={paper.abstract}
  shareTitle={paper.title}
  shareDescription={paper.abstract}
  twitterTitle={paper.title}
  twitterDescription={paper.oneLinePositioning}
  canonicalPath={paper.canonicalPath}
  ogType="article"
  jsonLd={createWhitePaperJsonLd(paper)}
  keywords={[...paper.keywords]}
  metaTags={createWhitePaperCitationMetaTags(paper)}
  ogImagePath="/social/jearonwong-og.png"
  ogImageAlt={`${paper.title} by Jearon Wong`}
>
  <WhitePaperPublicationPage paper={paper} />
</BaseLayout>
