---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RegistryPageHero from "../../../components/RegistryPageHero.astro";
import GAICSourceTrace from "../../../components/GAICSourceTrace.astro";
import { absoluteUrl, createBreadcrumbJsonLd } from "../../../data/schema";
import { getGaicP1SourceTraceByRoute } from "../../../data/gaicP1SourceTrace";
import {
  extendedEcosystemBoundary,
  extendedEcosystemIndexPath,
  extendedEcosystems,
  getExtendedEcosystemBySlug
} from "../../../data/extendedEcosystems";
import { siteConfig } from "../../../data/site";

export function getStaticPaths() {
  return extendedEcosystems.map((ecosystem) => ({
    params: { slug: ecosystem.slug }
  }));
}

const { slug } = Astro.params;
const ecosystem = slug ? getExtendedEcosystemBySlug(slug) : undefined;

if (!ecosystem) {
  throw new Error(`Unknown extended ecosystem mapping: ${slug}`);
}

const canonicalPath = ecosystem.canonicalRoute;
const pageUrl = absoluteUrl(canonicalPath);
const conceptCorePath = "/concepts/agentic-lifecycle-governance/";
const metaDescription = `${ecosystem.name} lifecycle governance mapping. ${ecosystem.distinctiveQuestion}`;
const gaicSourceTrace = getGaicP1SourceTraceByRoute(canonicalPath);
const relatedLinks = [
  { href: ecosystem.canonicalParent, label: "Extended ecosystem index" },
  { href: conceptCorePath, label: "Agentic Lifecycle Governance" },
  ...ecosystem.relatedLinks
].filter((link, index, links) => links.findIndex((candidate) => candidate.href === link.href) === index).slice(0, 6);
const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: `${ecosystem.name} Lifecycle Governance Mapping`,
  description: metaDescription,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  mainEntity: {
    "@id": `${pageUrl}#mapping`
  },
  citation: ecosystem.sourceRefs.map((source) => absoluteUrl(source.url)),
  breadcrumb: {
    "@id": `${pageUrl}#breadcrumb`
  }
};
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${pageUrl}#mapping`,
  headline: `${ecosystem.name}: lifecycle governance mapping`,
  description: metaDescription,
  url: pageUrl,
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  publisher: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  ...(ecosystem.publishedAt ? { datePublished: ecosystem.publishedAt } : {}),
  ...(ecosystem.updatedAt ? { dateModified: ecosystem.updatedAt } : {}),
  articleSection: "Extended ecosystem lifecycle governance mapping",
  keywords: ecosystem.keywords,
  audience: ecosystem.primaryAudience.map((audience) => ({
    "@type": "Audience",
    audienceType: audience
  })),
  about: ecosystem.keywords.map((keyword) => ({
    "@type": "Thing",
    name: keyword
  })),
  mentions: [
    {
      "@type": "Thing",
      name: ecosystem.name
    },
    {
      "@type": "Thing",
      name: "Agentic Lifecycle Governance"
    },
    {
      "@type": "Thing",
      name: "Missing Regulatory Objects"
    },
    {
      "@type": "Thing",
      name: "RCCS-M"
    },
    {
      "@type": "Thing",
      name: "ALCS"
    },
    {
      "@type": "Thing",
      name: "Harness Engineering"
    },
    ...(gaicSourceTrace
      ? gaicSourceTrace.sourceAnchors.map((anchor) => ({
          "@type": "Thing",
          name: anchor.label
        }))
      : [])
  ],
  isPartOf: {
    "@type": "CollectionPage",
    name: "Extended Ecosystem Lifecycle Governance Mapping",
    url: absoluteUrl(extendedEcosystemIndexPath)
  },
  isBasedOn: ecosystem.sourceRefs.map((source) => ({
    "@type": source.authority === "authored-research" ? "TechArticle" : "WebPage",
    name: source.label,
    url: absoluteUrl(source.url)
  }))
};
const breadcrumbJsonLd = createBreadcrumbJsonLd(pageUrl, [
  { name: "Home", path: "/" },
  { name: "Extended Ecosystem", path: extendedEcosystemIndexPath },
  { name: ecosystem.name, path: canonicalPath }
]);
---

<BaseLayout
  title={`${ecosystem.name} Lifecycle Governance Mapping`}
  metadataTitle={`${ecosystem.name} Mapping`}
  description={metaDescription}
  shareTitle={`${ecosystem.name} Mapping`}
  shareDescription={metaDescription}
  twitterTitle={`${ecosystem.name} Governance Mapping`}
  twitterDescription={metaDescription}
  canonicalPath={canonicalPath}
  noindex={ecosystem.indexability === "noindex"}
  ogType="article"
  jsonLd={[pageJsonLd, articleJsonLd, breadcrumbJsonLd]}
  keywords={ecosystem.keywords}
  ogImagePath="/social/jearonwong-og.png"
  ogImageAlt={`${ecosystem.name} lifecycle governance mapping by Jearon Wong`}
>
  <RegistryPageHero
    title={ecosystem.name}
    objectType="EXTENDED_ECOSYSTEM_MAPPING"
    objectValue={ecosystem.category.toUpperCase()}
    lead={ecosystem.summary}
  >
    <div class="ecosystem-hero-links">
      <a href={extendedEcosystemIndexPath} class="registry-annotation ecosystem-hero-link">
        <span class="registry-key">BACK_TO</span>: <span class="registry-value">EXTENDED ECOSYSTEM</span>
      </a>
      <a href={conceptCorePath} class="registry-annotation ecosystem-hero-link">
        <span class="registry-key">LENS</span>: <span class="registry-value">AGENTIC LIFECYCLE GOVERNANCE</span>
      </a>
      <a href="/playbooks/harness-engineering-for-ai-agents/" class="registry-annotation ecosystem-hero-link">
        <span class="registry-key">METHOD</span>: <span class="registry-value">HARNESS ENGINEERING</span>
      </a>
    </div>
  </RegistryPageHero>

  <div class="zone-b page-body page-body--standard">
    <article class="shell ecosystem-detail-shell">
      <aside class="registry-chassis ecosystem-sidebar" aria-label={`${ecosystem.name} source record`}>
        <div class="registry-annotation">
          <span class="registry-key">SOURCE_QUALIFIED</span>
        </div>
        <p class="sidebar-title">{ecosystem.name}</p>
        <div class="sidebar-group">
          <p class="sidebar-label">Category</p>
          <p>{ecosystem.category}</p>
        </div>
        <div class="sidebar-group">
          <p class="sidebar-label">Content role</p>
          <p>{ecosystem.contentRole}</p>
        </div>
        <div class="sidebar-group">
          <p class="sidebar-label">Indexability</p>
          <p>{ecosystem.indexability === "index" ? "Indexable mapping" : "Support route (noindex)"}</p>
        </div>
        <div class="sidebar-group">
          <p class="sidebar-label">Primary audience</p>
          <div class="sidebar-values">
            {ecosystem.primaryAudience.map((audience) => <span>{audience}</span>)}
          </div>
        </div>
        <div class="sidebar-group">
          <p class="sidebar-label">Source status</p>
          <p>{ecosystem.sourceStatus}</p>
        </div>
        <div class="sidebar-group">
          <p class="sidebar-label">Official sources</p>
          <div class="sidebar-links">
            {ecosystem.officialSources.map((source) => <a href={source.url}>{source.label}</a>)}
          </div>
        </div>
      </aside>

      <div class="ecosystem-article">
        <section class="registry-chassis mapping-proposition" aria-labelledby="proposition-title">
          <div class="registry-annotation">
            <span class="registry-key">MAPPING_PROPOSITION</span>
          </div>
          <h2 id="proposition-title">{ecosystem.distinctiveQuestion}</h2>
          <p>{ecosystem.scenario}</p>
          <div class="decision-artifact">
            <span class="decision-artifact__label">Decision artifact</span>
            <strong>{ecosystem.decisionArtifact}</strong>
          </div>
        </section>

        <section class="mapping-io-grid" aria-label={`${ecosystem.name} mapping inputs and outputs`}>
          <article class="registry-chassis mapping-io-panel">
            <div class="registry-annotation"><span class="registry-key">INPUTS</span></div>
            <ul>
              {ecosystem.inputs.map((input) => <li>{input}</li>)}
            </ul>
          </article>
          <article class="registry-chassis mapping-io-panel">
            <div class="registry-annotation"><span class="registry-key">OUTPUTS</span></div>
            <ul>
              {ecosystem.outputs.map((output) => <li>{output}</li>)}
            </ul>
          </article>
        </section>

        <section class="registry-chassis boundary-note" aria-labelledby="boundary-title">
          <div class="registry-annotation">
            <span class="registry-key">BOUNDARY_NOTE</span>
          </div>
          <h2 id="boundary-title">Independent lifecycle governance lens.</h2>
          <p>{ecosystem.boundary}</p>
          <p>{extendedEcosystemBoundary}</p>
        </section>

        <section class="ecosystem-section">
          <h2>Ecosystem context</h2>
          <p>{ecosystem.ecosystemContext}</p>
          <p class="source-caveat">{ecosystem.sourceBasis}</p>
        </section>

        <section class="ecosystem-section mapping-focus">
          <div class="registry-annotation"><span class="registry-key">MAPPING_FOCUS</span></div>
          <h2>What this mapping follows.</h2>
          <p>{ecosystem.mappingFocus}</p>
        </section>

        <section class="ecosystem-section">
          <h2>Lifecycle governance questions</h2>
          <ol class="question-list">
            {ecosystem.lifecycleQuestions.map((question) => (
              <li>{question}</li>
            ))}
          </ol>
        </section>

        <section class="mapping-risk-grid" aria-label={`${ecosystem.name} failure modes and required evidence`}>
          <article class="ecosystem-section mapping-list-panel">
            <h2>Failure modes to test</h2>
            <ul class="mapping-bullet-list">
              {ecosystem.failureModes.map((failure) => <li>{failure}</li>)}
            </ul>
          </article>
          <article class="ecosystem-section mapping-list-panel">
            <h2>Evidence to retain</h2>
            <ul class="mapping-bullet-list">
              {ecosystem.evidenceRequired.map((evidence) => <li>{evidence}</li>)}
            </ul>
          </article>
        </section>

        <section class="ecosystem-section">
          <h2>Related Missing Regulatory Objects</h2>
          <p>
            These concepts are governance lenses for the mapping. This page does not claim the
            ecosystem has or lacks a feature unless the statement is supported by an official source.
          </p>
          <div class="mro-list">
            {ecosystem.relatedMros.map((item) => <span>{item}</span>)}
          </div>
        </section>

        <section class="ecosystem-section">
          <h2>RCCS-M / ALCS relevance</h2>
          <p>{ecosystem.rccsAlcsRelevance}</p>
        </section>

        <section class="ecosystem-section">
          <h2>Harness Engineering relevance</h2>
          <p>{ecosystem.harnessRelevance}</p>
        </section>

        <section class="ecosystem-section">
          <h2>Protocol path</h2>
          <p>{ecosystem.protocolPath}</p>
        </section>

        {gaicSourceTrace && <GAICSourceTrace trace={gaicSourceTrace} />}

        <section class="ecosystem-section">
          <h2>Sources and authority</h2>
          <ul class="source-list">
            {ecosystem.sourceRefs.map((source) => (
              <li>
                <a href={source.url}>{source.label}</a>
                <span class="source-authority">{source.authority}</span>
                <span>{source.note}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="relation-grid" aria-label={`${ecosystem.name} related links`}>
          <article class="registry-chassis relation-panel">
            <div class="registry-annotation">
              <span class="registry-key">RELATED_LINKS</span>
            </div>
            <h2>Related source and concept routes</h2>
            <div class="term-link-grid">
              {relatedLinks.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          </article>
        </section>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .ecosystem-hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.2rem;
    margin-top: 1.4rem;
  }

  .ecosystem-hero-link {
    text-decoration: none;
  }

  .ecosystem-hero-link:hover .registry-value {
    color: var(--color-action);
  }

  .ecosystem-detail-shell {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    max-width: 1080px;
  }

  .ecosystem-sidebar {
    position: sticky;
    top: 7rem;
    padding: var(--registry-card-padding);
  }

  .sidebar-title {
    margin: 0;
    font-family: var(--font-display);
    color: var(--current-text);
    font-size: 1.25rem;
    font-weight: 760;
    line-height: var(--type-card-title-line-height);
    letter-spacing: var(--type-card-title-letter-spacing);
    word-spacing: var(--type-card-title-word-spacing);
  }

  .sidebar-group {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--current-line);
  }

  .sidebar-label {
    margin: 0 0 0.75rem;
    color: var(--current-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sidebar-group p {
    margin: 0;
    color: var(--current-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .sidebar-links,
  .mro-list,
  .sidebar-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .sidebar-values span {
    color: var(--current-muted);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .sidebar-links a {
    color: var(--color-action);
    font-size: 0.86rem;
    line-height: 1.35;
    text-decoration: none;
  }

  .ecosystem-article {
    display: grid;
    gap: 2.5rem;
  }

  .mapping-proposition {
    padding: var(--registry-panel-padding);
    border-left: 3px solid var(--color-rule);
  }

  .mapping-proposition h2 {
    max-width: 48rem;
    margin: 0.8rem 0 0.9rem;
    color: var(--current-text);
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    line-height: var(--type-section-title-line-height);
    letter-spacing: var(--type-section-title-letter-spacing);
    word-spacing: var(--type-section-title-word-spacing);
  }

  .mapping-proposition > p {
    max-width: 50rem;
    margin: 0;
    color: var(--current-muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .decision-artifact {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--current-line);
  }

  .decision-artifact__label,
  .mapping-io-panel .registry-key {
    color: var(--color-meta);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .decision-artifact strong {
    color: var(--current-text);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .mapping-io-grid,
  .mapping-risk-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .mapping-io-panel {
    padding: var(--registry-card-padding);
  }

  .mapping-io-panel ul,
  .mapping-bullet-list {
    display: grid;
    gap: 0.65rem;
    margin: 0.95rem 0 0;
    padding-left: 1.1rem;
  }

  .mapping-io-panel li,
  .mapping-bullet-list li {
    color: var(--current-muted);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .mapping-list-panel {
    min-width: 0;
  }

  .boundary-note,
  .relation-panel {
    padding: var(--registry-panel-padding);
  }

  .boundary-note {
    border-left: 3px solid var(--color-rule);
  }

  .boundary-note h2,
  .ecosystem-section h2,
  .relation-panel h2 {
    margin: 0 0 0.9rem;
    color: var(--current-text);
    font-size: 1.45rem;
    line-height: var(--type-card-title-line-height);
    letter-spacing: var(--type-card-title-letter-spacing);
    word-spacing: var(--type-card-title-word-spacing);
  }

  .boundary-note p,
  .ecosystem-section p {
    margin: 0;
    color: var(--current-muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .boundary-note p + p,
  .ecosystem-section p + p {
    margin-top: 0.85rem;
  }

  .ecosystem-section {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--current-line);
  }

  .source-caveat {
    color: var(--current-text) !important;
  }

  .question-list {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding-left: 1.35rem;
  }

  .question-list li {
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.6;
    padding-left: 0.2rem;
  }

  .mro-list span {
    display: inline-flex;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--current-line);
    color: var(--current-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.25;
  }

  .source-list {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .source-list li {
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--current-line);
  }

  .source-list a {
    color: var(--color-action);
    font-weight: 760;
    text-decoration: none;
  }

  .source-list span {
    color: var(--current-muted);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .source-list .source-authority {
    color: var(--color-meta);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .relation-grid {
    display: grid;
  }

  .term-link-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
  }

  .term-link-grid a {
    color: var(--color-action);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .sidebar-links a:hover,
  .source-list a:hover,
  .term-link-grid a:hover {
    color: var(--current-text);
  }

  @media (max-width: 920px) {
    .ecosystem-detail-shell {
      grid-template-columns: 1fr;
    }

    .ecosystem-sidebar {
      position: static;
    }

    .mapping-io-grid,
    .mapping-risk-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .ecosystem-detail-shell {
      gap: 2rem;
    }

    .ecosystem-sidebar,
    .boundary-note,
    .relation-panel {
      padding: var(--registry-card-padding);
    }

    .boundary-note p,
    .ecosystem-section p,
    .mapping-proposition > p {
      font-size: 0.98rem;
      line-height: 1.68;
    }

    .mapping-proposition h2 {
      font-size: 1.45rem;
      line-height: var(--type-section-title-line-height-mobile);
      letter-spacing: var(--type-section-title-letter-spacing);
      word-spacing: normal;
    }
  }
</style>
