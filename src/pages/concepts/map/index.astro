    url: `${pageUrl}#${group.name.toLowerCase().replaceAll(" ", "-").replaceAll("/", "-")}`
  }))
};
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#entity-mesh`,
  name: "GAIC and Agentic Lifecycle Governance Entity Mesh",
  description: metaDescription,
  itemListElement: mapNodes.map((node, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: node.label,
    item: node.href ? absoluteUrl(node.href) : pageUrl
  }))
};
const definedTermSetJsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": `${pageUrl}#defined-term-set`,
  name: "Agentic Lifecycle Governance Entity Mesh",
  description: metaDescription,
  creator: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  hasDefinedTerm: mapNodes.map((node) => ({
    "@type": "DefinedTerm",
    name: node.label,
    description: node.description,
    url: absoluteUrl(node.href)
  }))
};
const layerGroupJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#layer-groups`,
  name: "Concepts Map Extractable Layer Groups",
  description: "Server-rendered layer groups for the JearonWong.com AI agent lifecycle entity mesh.",
  itemListElement: extractableLayerGroups.map((group, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: group.name,
    description: group.description,
    item: `${pageUrl}#${group.name.toLowerCase().replaceAll(" ", "-").replaceAll("/", "-")}`
  }))
};
const breadcrumbJsonLd = createBreadcrumbJsonLd(pageUrl, [
  { name: "Home", path: "/" },
  { name: "Concepts", path: "/concepts/" },
  { name: "Concepts Map", path: canonicalPath }
]);
---

<BaseLayout
  title="Concepts Map / Entity Mesh"
  description={metaDescription}
  shareTitle="Concepts Map / Entity Mesh"
  shareDescription={metaDescription}
  twitterTitle="Concepts Map / Entity Mesh"
  twitterDescription={metaDescription}
  canonicalPath={canonicalPath}
  jsonLd={[pageJsonLd, itemListJsonLd, definedTermSetJsonLd, layerGroupJsonLd, breadcrumbJsonLd]}
  keywords={keywords}
  ogImagePath="/social/og-concepts.png"
  ogImageAlt="Concepts Map / Entity Mesh by Jearon Wong"
>
  <RegistryPageHero
    title="Concepts Map / Entity Mesh"
    objectType="GEO_NAVIGATION"
    objectValue="VISIBLE_ENTITY_MESH"
    lead="A visible semantic navigation surface connecting Jearon Wong, Agentic Lifecycle Governance, the Global AI Compliance White Paper 2026, Missing Regulatory Objects, RCCS-M, ALCS, MPLP, deterministic delivery, agent architecture governance, regulatory and enterprise governance mappings, applied playbooks, and extended ecosystem mappings."
  >
    <div class="map-hero-links">
      {primaryLinks.map((link) => (
        <a href={link.href} class="registry-annotation map-hero-link">
          <span class="registry-key">LINK</span>: <span class="registry-value">{link.label}</span>
        </a>
      ))}
    </div>
  </RegistryPageHero>

  <div class="zone-b page-body page-body--standard">
    <main class="shell map-shell">
      <section class="map-opening registry-chassis" aria-labelledby="map-opening-title">
        <div>
          <div class="registry-annotation">
            <span class="registry-key">MAP_PURPOSE</span>: <span class="registry-value">HUMAN_AND_MACHINE_NAVIGATION</span>
          </div>
          <h2 id="map-opening-title">The concept system in one navigable surface.</h2>
          <p>
            This map is a navigation layer, not a standard, certification, legal interpretation, or regulator-approved taxonomy.
            It helps readers and crawlers follow the public relationship from author identity to research authority,
            lifecycle responsibility objects, measurement models, protocol path, deterministic delivery, agent architecture governance, applied playbooks, and extended ecosystem mappings.
          </p>
        </div>
        <div class="map-opening__links" aria-label="Primary entity links">
          {primaryLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      </section>

      <section class="semantic-chain registry-chassis" aria-labelledby="semantic-chain-title">
        <div class="registry-annotation">
          <span class="registry-key">CANONICAL_CHAIN</span>: <span class="registry-value">IDENTITY_TO_APPLICATION</span>
        </div>
        <h2 id="semantic-chain-title">Canonical semantic chain.</h2>
        <ol>
          {semanticChain.map((node) => (
            <li>
              <a href={node.href}>{node.label}</a>
            </li>
          ))}
        </ol>
      </section>

      <section class="extractable-layers registry-chassis" aria-labelledby="extractable-layers-title">
        <div class="registry-section-heading">
          <div class="registry-annotation">
            <span class="registry-key">EXTRACTABLE_LAYERS</span>: <span class="registry-value">SERVER_RENDERED</span>
          </div>
          <h2 id="extractable-layers-title">Extractable layer index.</h2>
          <p>These server-rendered groups mirror the entity mesh for crawlers and answer-engine extraction.</p>
        </div>
        <div class="layer-card-grid">
          {extractableLayerGroups.map((group) => (
            <article id={group.name.toLowerCase().replaceAll(" ", "-").replaceAll("/", "-")} class="layer-card">
              <h3>{group.name}</h3>
              <p>{group.description}</p>
              <div class="layer-card__links">
                {group.links.map((link) => <a href={link.href}>{link.label}</a>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="explicit-relations registry-chassis" aria-labelledby="explicit-relations-title">
        <div class="registry-section-heading">
          <div class="registry-annotation">
            <span class="registry-key">ENTITY_RELATIONSHIPS</span>: <span class="registry-value">VISIBLE_EDGES</span>
          </div>
          <h2 id="explicit-relations-title">Explicit entity relationships.</h2>
          <p>
            These visible edges are the safe relationship vocabulary for the site. They avoid endorsement,
            adoption, certification, ranking, procurement, and legal-compliance claims.
          </p>
        </div>
        <div class="relationship-table">
          {explicitEntityRelationships.map((edge) => (
            <a href={edge.href} class="relationship-row">
              <span>{edge.source}</span>
              <strong>{edge.relation}</strong>
              <span>{edge.target}</span>
              <em>{edge.status}</em>
            </a>
          ))}
        </div>
      </section>

      <section class="entity-map registry-chassis" aria-labelledby="entity-map-title">
        <div class="registry-section-heading">
          <div class="registry-annotation">
            <span class="registry-key">VISIBLE_MESH</span>: <span class="registry-value">CANONICAL_NODES</span>
          </div>
          <h2 id="entity-map-title">Entity mesh.</h2>
          <p>Routed nodes link to their canonical pages. The text list below is the accessibility equivalent of the visual map.</p>
        </div>

        <div class="mesh-flow" aria-hidden="true">
          <div class="mesh-row mesh-row--identity">
            <a href="/about/" class="mesh-node">Jearon Wong</a>
            <span class="mesh-arrow">-&gt;</span>
            <a href="/about/" class="mesh-node mesh-node--wide">Protocol Architect for the Agent Era</a>
          </div>
          <div class="mesh-row mesh-row--category">
            <a href="/concepts/ai-agent-lifecycle/" class="mesh-node">AI Agent Lifecycle</a>
            <span class="mesh-arrow">-&gt;</span>
            <a href="/concepts/agentic-delivery/" class="mesh-node">Agentic Delivery</a>
            <span class="mesh-arrow">-&gt;</span>
            <a href="/concepts/agentic-lifecycle-governance/" class="mesh-node mesh-node--strong">Agentic Lifecycle Governance</a>
          </div>
          <div class="mesh-row mesh-row--authority">
            <a href="/research/global-ai-compliance-white-paper-2026/" class="mesh-node mesh-node--authority">Global AI Compliance White Paper 2026</a>
            <span class="mesh-arrow">-&gt;</span>
            <a href="/research/global-ai-compliance-white-paper-2026/systems/" class="mesh-node mesh-node--authority">Systems Discussed in GAIC</a>
            <span class="mesh-arrow">-&gt;</span>
            <a href={extendedEcosystemPath} class="mesh-node mesh-node--authority">Extended Ecosystem Mapping</a>
            <span class="mesh-arrow">-&gt;</span>
            <a href="/governance/" class="mesh-node mesh-node--authority">Regulatory Governance</a>
          </div>
          <div class="mesh-row mesh-row--governance">
            <a href="/concepts/missing-regulatory-objects/" class="mesh-node mesh-node--strong">Missing Regulatory Objects</a>
            <span class="mesh-arrow">-&gt;</span>
            <a href="/concepts/lifecycle-responsibility-objects/" class="mesh-node">Lifecycle Responsibility Objects</a>
            <span class="mesh-branch" aria-hidden="true"></span>
            <a href="/concepts/rccs-m/" class="mesh-node">RCCS-M</a>
            <a href="/concepts/alcs/" class="mesh-node">ALCS</a>
          </div>
          <div class="mesh-row mesh-row--primitive">
            <a href="/concepts/authority-boundary/" class="mesh-node">Authority Boundary</a>
            <a href="/concepts/accepted-outcome/" class="mesh-node">Accepted Outcome</a>
            <a href="/concepts/lifecycle-evidence/" class="mesh-node">Evidence Chain</a>
            <a href="/concepts/confirmation-boundary/" class="mesh-node">Confirmation Boundary</a>
          </div>
          <div class="mesh-row mesh-row--engineering">
            <a href="/concepts/deterministic-delivery/" class="mesh-node mesh-node--strong">Deterministic Delivery</a>
            <a href="/concepts/rollbackable-agent-workflows/" class="mesh-node">Rollbackable Agent Workflows</a>
            <a href="/concepts/verifiable-ai-agents/" class="mesh-node">Verifiable AI Agents</a>
            <a href="/concepts/configurable-agent-governance/" class="mesh-node">Configurable Agent Governance</a>
            <a href="/concepts/agent-architecture-governance/" class="mesh-node mesh-node--protocol">Agent Architecture Governance</a>
          </div>
          <div class="mesh-row mesh-row--applied">
            <a href="/projects/mplp/" class="mesh-node mesh-node--protocol">MPLP</a>
            <span class="mesh-arrow">-&gt;</span>
            <a href="/playbooks/harness-engineering-for-ai-agents/" class="mesh-node">Harness Engineering</a>
            <span class="mesh-arrow">-&gt;</span>
            <a href="/playbooks/prompt-engineering-vs-harness-engineering/" class="mesh-node">Prompt vs Harness</a>
            <span class="mesh-arrow">-&gt;</span>
            <a href="/playbooks/agentic-delivery-architecture-checklist/" class="mesh-node">Architecture Checklist</a>
            <span class="mesh-arrow">-&gt;</span>
            <a href="/playbooks/" class="mesh-node mesh-node--strong">Applied Playbooks</a>
          </div>
          <div class="mesh-row mesh-row--governance">
            <a href="/governance/ai-agent-compliance/" class="mesh-node">AI Agent Compliance</a>
            <a href="/governance/enterprise-agent-governance/" class="mesh-node">Enterprise Agent Governance</a>
            <a href="/governance/eu-ai-act-agentic-systems/" class="mesh-node">EU AI Act Mapping</a>
            <a href="/governance/gdpr-agentic-ai-evidence/" class="mesh-node">GDPR Evidence</a>
            <a href="/governance/ai-agent-evidence-retention/" class="mesh-node">Evidence Retention</a>
            <a href="/governance/incident-dispute-remediation-closure/" class="mesh-node">Incident Closure</a>
          </div>
        </div>

        <ol class="map-text-equivalent" aria-label="Text equivalent of entity mesh">
          {mapNodes.map((node) => (
            <li>
              <a href={node.href}>{node.label}</a>
              <span>{node.layer}</span>
              <p>{node.description}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="relation-grid" aria-labelledby="relation-groups-title">
        <div class="registry-section-heading">
          <div class="registry-annotation">
            <span class="registry-key">RELATION_GROUPS</span>
          </div>
          <h2 id="relation-groups-title">Relation groups.</h2>
          <p>These groups describe the intended reading path without inventing external authority signals.</p>
        </div>
        <div class="relation-card-grid">
          {relationGroups.map((group, index) => (
            <article class="registry-chassis relation-card">
              <div class="registry-annotation">
                <span class="registry-key">GROUP_{String(index + 1).padStart(2, "0")}</span>
              </div>
              <h3>{group.name}</h3>
              <p class="relation-card__relation">{group.relation}</p>
              <p>{group.body}</p>
              <div class="relation-card__nodes">
                {group.nodes.map((node) => <span>{node}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="registry-chassis boundary-panel" aria-labelledby="map-boundary-title">
        <div class="registry-annotation">
          <span class="registry-key">BOUNDARY</span>: <span class="registry-value">NON_CLAIM</span>
        </div>
        <h2 id="map-boundary-title">Boundary statement.</h2>
        <p>
          This map is an author-maintained semantic navigation surface. It is not legal advice,
          legal compliance proof, certification, regulator-approved guidance, vendor ranking,
          procurement recommendation, or evidence of search ranking improvement.
        </p>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .map-hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.2rem;
    margin-top: 1.4rem;
  }

  .map-hero-link {
    text-decoration: none;
  }

  .map-hero-link:hover .registry-value {
    color: var(--accent-signal);
  }

  .map-shell {
    display: grid;
    gap: var(--space-6);
  }

  .map-opening,
  .semantic-chain,
  .extractable-layers,
  .explicit-relations,
  .entity-map,
  .boundary-panel {
    padding: var(--registry-panel-padding);
  }

  .map-opening {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.36fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    border-left: 3px solid var(--accent-proof);
  }

  .map-opening h2,
  .semantic-chain h2,
  .extractable-layers h2,
  .explicit-relations h2,
  .entity-map h2,
  .boundary-panel h2,
  .registry-section-heading h2 {
    margin: 0.85rem 0 0;
    color: var(--current-text);
    font-size: clamp(1.55rem, 2.8vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .map-opening p,
  .semantic-chain p,
  .extractable-layers .registry-section-heading p,
  .explicit-relations .registry-section-heading p,
  .entity-map .registry-section-heading p,
  .boundary-panel p,
  .registry-section-heading p {
    max-width: var(--lead-measure);
    margin: 0.9rem 0 0;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.68;
  }

  .semantic-chain {
    display: grid;
    gap: 1.25rem;
    border-left: 3px solid var(--accent-signal);
  }

  .semantic-chain ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .semantic-chain li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .semantic-chain li:not(:last-child)::after {
    content: "->";
    color: var(--current-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .semantic-chain a {
    display: inline-flex;
    align-items: center;
    min-height: 2.15rem;
    padding: 0.48rem 0.68rem;
    border: 1px solid var(--current-border);
    color: var(--current-text);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .semantic-chain a:hover {
    border-color: var(--accent-signal);
    color: var(--accent-signal);
  }

  .extractable-layers {
    border-left: 3px solid var(--accent-proof);
  }

  .explicit-relations {
    border-left: 3px solid var(--accent-signal);
  }

  .relationship-table {
    display: grid;
    gap: 0;
    margin-top: 1.35rem;
    border-top: 1px solid var(--current-line);
  }

  .relationship-row {
    display: grid;
    grid-template-columns: minmax(150px, 0.22fr) minmax(150px, 0.22fr) minmax(0, 1fr) minmax(150px, 0.2fr);
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--current-line);
    color: var(--current-text);
    text-decoration: none;
  }

  .relationship-row span,
  .relationship-row em {
    color: var(--current-muted);
    font-size: 0.9rem;
    font-style: normal;
    line-height: 1.5;
  }

  .relationship-row strong {
    color: var(--accent-signal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .layer-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.4rem;
  }

  .layer-card {
    padding: 1rem;
    border: 1px solid var(--current-border);
    background: color-mix(in srgb, var(--current-panel) 86%, transparent);
  }

  .layer-card h3 {
    margin: 0;
    color: var(--current-text);
    font-size: 1rem;
    line-height: 1.3;
  }

  .layer-card p {
    margin: 0.55rem 0 0;
    color: var(--current-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .layer-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.85rem;
  }

  .layer-card__links a {
    padding: 0.36rem 0.48rem;
    border: 1px solid var(--current-border);
    color: var(--accent-signal);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 800;
    line-height: 1.25;
    text-decoration: none;
    text-transform: uppercase;
  }

  .map-opening__links {
    display: grid;
    gap: 0;
    align-content: start;
    border-top: 1px solid var(--current-line);
  }

  .map-opening__links a {
    padding: 0.82rem 0;
    border-bottom: 1px solid var(--current-line);
    color: var(--current-text);
    font-weight: 700;
    text-decoration: none;
  }

  .map-opening__links a:hover {
    color: var(--accent-signal);
  }

  .entity-map {
    display: grid;
    gap: 2rem;
  }

  .mesh-flow {
    display: grid;
    gap: 0.85rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow-x: auto;
  }

  .mesh-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    min-width: 0;
  }

  .mesh-row--governance,
  .mesh-row--primitive,
  .mesh-row--engineering {
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mesh-node {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    max-width: min(100%, 24rem);
    padding: 0.55rem 0.78rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(241, 245, 249, 0.92);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: 0.04em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mesh-node:hover {
    border-color: var(--accent-proof);
    color: #ffffff;
  }

  .mesh-node--wide {
    min-width: min(100%, 18rem);
  }

  .mesh-node--strong {
    border-color: rgba(34, 211, 238, 0.48);
  }

  .mesh-node--authority {
    border-color: rgba(245, 158, 11, 0.48);
    color: #f8fafc;
  }

  .mesh-node--protocol {
    border-color: rgba(59, 130, 246, 0.54);
  }

  .mesh-arrow {
    color: rgba(148, 163, 184, 0.84);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .mesh-branch {
    flex-basis: 100%;
    height: 0;
  }

  .map-text-equivalent {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--current-line);
  }

  .map-text-equivalent li {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--current-line);
  }

  .map-text-equivalent a {
    color: var(--current-text);
    font-weight: 750;
    text-decoration: none;
  }

  .map-text-equivalent a:hover {
    color: var(--accent-signal);
  }

  .map-text-equivalent span {
    color: var(--accent-signal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .map-text-equivalent p {
    margin: 0;
    color: var(--current-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .relation-grid {
    display: grid;
    gap: 1.5rem;
  }

  .relation-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .relation-card {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: var(--registry-card-padding);
  }

  .relation-card h3 {
    margin: 0;
    color: var(--current-text);
    font-size: 1.25rem;
    line-height: 1.18;
    letter-spacing: 0;
  }

  .relation-card p {
    margin: 0;
    color: var(--current-muted);
    font-size: 0.95rem;
    line-height: 1.62;
  }

  .relation-card__relation {
    color: var(--current-text) !important;
    font-family: var(--font-mono);
    font-size: 0.76rem !important;
    font-weight: 800;
    letter-spacing: 0.03em;
  }

  .relation-card__nodes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-top: 0.4rem;
  }

  .relation-card__nodes span {
    padding: 0.35rem 0.48rem;
    border: 1px solid var(--current-border);
    color: var(--current-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .boundary-panel {
    border-left: 3px solid var(--accent-caution);
  }

  @media (max-width: 860px) {
    .map-opening,
    .relation-card-grid,
    .relationship-row,
    .map-text-equivalent {
      grid-template-columns: 1fr;
    }

    .map-text-equivalent li {
      padding-right: 0;
    }
  }

  @media (max-width: 640px) {
    .map-hero-links {
      gap: 0.65rem;
    }

    .mesh-flow {
      padding: 0.85rem;
    }

    .mesh-row {
      display: grid;
