---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegistryPageHero from "../../components/RegistryPageHero.astro";
import ReadingGuide from "../../components/ReadingGuide.astro";
import GAICSourceTrace from "../../components/GAICSourceTrace.astro";
import SocialShare from "../../components/SocialShare.astro";
import SemanticEvidenceBand from "../../components/SemanticEvidenceBand.astro";
import { getGaicP1SourceTraceByRoute } from "../../data/gaicP1SourceTrace";
import { concepts, getConceptBySlug, getProjectBySlug, pageRegistry, siteConfig } from "../../data/site";
import { absoluteUrl } from "../../data/schema";

export function getStaticPaths() {
  return concepts.map((concept) => ({
    params: { slug: concept.slug }
  }));
}

const { slug } = Astro.params;
const concept = slug ? getConceptBySlug(slug) : undefined;

if (!concept) {
  throw new Error(`Unknown concept: ${slug}`);
}

const essays = await getCollection("essays", ({ data }) => data.status === "published");
const essaysBySlug = new Map(essays.map((essay) => [essay.id, essay]));
const relatedEssays = concept.relatedEssays
  .map((essaySlug) => essaysBySlug.get(essaySlug))
  .filter((essay): essay is NonNullable<typeof essay> => Boolean(essay));
const relatedProjects = concept.relatedProjects.reduce<
  Array<NonNullable<ReturnType<typeof getProjectBySlug>>>
>((acc, projectSlug) => {
  const project = getProjectBySlug(projectSlug);
  if (project) acc.push(project);
  return acc;
}, []);
const relatedTerms = concept.relatedTerms
  .map((termSlug) => getConceptBySlug(termSlug))
  .filter((term): term is NonNullable<typeof term> => Boolean(term));
const canonicalPath = `/concepts/${concept.slug}/`;
const conceptUrl = new URL(canonicalPath, siteConfig.siteUrl).toString();
const gaicSourceTrace = getGaicP1SourceTraceByRoute(canonicalPath);
const whitePaperHub = "/research/global-ai-compliance-white-paper-2026/";
const governanceAiAgentPath = "/governance/ai-agent-governance/";
const conceptCorePath = "/concepts/agentic-lifecycle-governance/";
const conceptCoreUrl = new URL(conceptCorePath, siteConfig.siteUrl).toString();
const whitePaperUrl = new URL(whitePaperHub, siteConfig.siteUrl).toString();
const isAiAgentGovernanceBridge = concept.slug === "ai-agent-governance";
const gaicJsonLdLink = concept.gaicEntity
  ? {
      citation: whitePaperUrl,
      isBasedOn: {
        "@type": "TechArticle",
        name: "Global AI Compliance White Paper 2026",
        url: whitePaperUrl
      }
    }
  : {};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${conceptUrl}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.siteUrl
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Concepts",
      item: `${siteConfig.siteUrl}/concepts/`
    },
    {
      "@type": "ListItem",
      position: 3,
      name: concept.term,
      item: conceptUrl
    }
  ]
};
const definedTermJsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "@id": `${conceptUrl}#defined-term`,
  name: concept.term,
  description: concept.definition,
  url: conceptUrl,
  keywords: concept.keywords,
  relatedLink: [
    ...(concept.gaicEntity ? [conceptCoreUrl, whitePaperUrl] : []),
    ...relatedTerms.map((term) => new URL(`/concepts/${term.slug}/`, siteConfig.siteUrl).toString())
  ],
  ...gaicJsonLdLink,
  inDefinedTermSet: {
    "@id": `${siteConfig.siteUrl}/concepts/#defined-term-set`,
    "@type": "DefinedTermSet",
    name: pageRegistry.concepts.title
  }
};
const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${conceptUrl}#webpage`,
  url: conceptUrl,
  name: concept.term,
  description: concept.seoDescription,
  mainEntity: {
    "@id": `${conceptUrl}#defined-term`
  },
  ...(isAiAgentGovernanceBridge
    ? {
        significantLink: absoluteUrl(governanceAiAgentPath)
      }
    : {}),
  ...(concept.boundaryNote
    ? {
        conditionsOfAccess: concept.boundaryNote
      }
    : {}),
  breadcrumb: {
    "@id": `${conceptUrl}#breadcrumb`
  },
  ...gaicJsonLdLink
};
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${conceptUrl}#article`,
  headline: concept.term,
  description: concept.seoDescription,
  url: conceptUrl,
  author: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  publisher: {
    "@id": `${siteConfig.siteUrl}#person`
  },
  dateModified: "2026-05-12",
  keywords: concept.keywords,
  about: concept.keywords.map((keyword) => ({
    "@type": "Thing",
    name: keyword
  })),
  ...(gaicSourceTrace
    ? {
        citation: [
          whitePaperUrl,
          ...gaicSourceTrace.sourceAnchors.map((anchor) => absoluteUrl(anchor.href))
        ],
        mentions: gaicSourceTrace.sourceAnchors.map((anchor) => ({
          "@type": "Thing",
          name: anchor.label
        }))
      }
    : {}),
  ...gaicJsonLdLink
};
---

<BaseLayout
  title={concept.seoTitle}
  description={concept.seoDescription}
  canonicalPath={canonicalPath}
  jsonLd={[pageJsonLd, articleJsonLd, breadcrumbJsonLd, definedTermJsonLd]}
  ogType="article"
  keywords={concept.keywords}
  ogImagePath="/social/og-concepts.png"
  ogImageAlt={`${concept.term} — ${siteConfig.author.name} concept record`}
>
  <RegistryPageHero
    title={concept.term}
    objectType="DEFINED_TERM"
    objectValue="AI AGENT LIFECYCLE"
    lead={concept.seoDescription}
  >
    <div class="concept-hero-links">
      <a href="/concepts/" class="registry-annotation concept-hero-link">
        <span class="registry-key">BACK_TO</span>: <span class="registry-value">CONCEPT MAP</span>
      </a>
      <a href="/lifecycle/" class="registry-annotation concept-hero-link">
        <span class="registry-key">CATEGORY</span>: <span class="registry-value">LIFECYCLE</span>
      </a>
    </div>
  </RegistryPageHero>

  <div class="zone-b page-body page-body--standard">
    <article class="shell concept-detail-shell">
      <ReadingGuide
        role="DEFINED_TERM"
        answer={concept.definition}
        startHref="#definition-panel"
        startLabel="Read the definition"
        nextLinks={[{ href: "/concepts/", label: "Return to concepts" }, { href: "/lifecycle/", label: "Open the lifecycle field" }]}
        sections={["Definition and boundary", "Source trace", "Related terms", "Related projects", "Related essays"]}
      />
      <SemanticEvidenceBand
        definition={concept.definition}
        boundary={concept.boundaryNote ?? concept.whatItIsNot ?? "Author-defined concept; not legal advice, certification, regulator approval, or an adopted standard."}
        evidence={concept.evidenceRoute}
        citation={gaicSourceTrace ? "Source trace: Global AI Compliance White Paper 2026 and linked anchors." : "Use the canonical concept URL and related project/essay links as the citation path."}
        updated="2026-08-26"
        sourceLevel={concept.gaicEntity ? "AUTHORED_ANALYSIS / SOURCE_TRACE" : "AUTHORED_ANALYSIS"}
      />
      <aside class="registry-chassis concept-sidebar" aria-label={`${concept.term} reference`}>
        <div class="registry-annotation" style="margin-bottom: 1rem;">
          <span class="registry-key">TERM_RECORD</span>
        </div>
        <p class="sidebar-term">{concept.term}</p>
        <div class="sidebar-group">
          <p class="sidebar-label">Primary coverage</p>
          <div class="keyword-list">
            {concept.keywords.map((keyword) => (
              <span>{keyword}</span>
            ))}
          </div>
        </div>
        {relatedTerms.length > 0 && (
          <div class="sidebar-group">
            <p class="sidebar-label">Related terms</p>
            <div class="sidebar-links">
              {relatedTerms.map((term) => (
                <a href={`/concepts/${term.slug}/`}>{term.term}</a>
              ))}
            </div>
          </div>
        )}
        {concept.gaicEntity && (
          <div class="sidebar-group">
            <p class="sidebar-label">GAIC authority</p>
            <div class="sidebar-links">
              <a href={conceptCorePath}>Agentic Lifecycle Governance</a>
              <a href={whitePaperHub}>Global AI Compliance White Paper 2026</a>
            </div>
          </div>
        )}
      </aside>

      <div class="concept-article">
        <section class="registry-chassis definition-panel" id="definition-panel">
          <div class="registry-annotation" style="margin-bottom: 1rem;">
            <span class="registry-key">CANONICAL_DEFINITION</span>
          </div>
          <p>{concept.definition}</p>
        </section>

        {concept.canonicalRole && (
          <section class="registry-chassis canonical-role-panel">
            <div class="registry-annotation" style="margin-bottom: 1rem;">
              <span class="registry-key">ROUTE_ROLE</span>
            </div>
            <h2>{concept.canonicalRole.title}</h2>
            <p>{concept.canonicalRole.body}</p>
            <div class="relation-links compact-source-links">
              {concept.canonicalRole.links.map((link) => (
                <a href={link.href}>
                  <strong>{link.label}</strong>
                  <span>{link.description}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <section class="concept-section">
          <h2>{concept.gaicEntity ? "Why it matters" : "The problem it names"}</h2>
          <p>{concept.problem}</p>
        </section>

        <section class="concept-section">
          <h2>Why existing approaches are not enough</h2>
          <p>{concept.whyExistingApproachesAreNotEnough}</p>
        </section>

        {concept.whatItIsNot && (
          <section class="concept-section">
            <h2>What it is not</h2>
            <p>{concept.whatItIsNot}</p>
          </section>
        )}

        <section class="concept-section">
          <h2>{concept.gaicEntity ? "How it relates to Agentic Lifecycle Governance" : "How it relates to AI Agent Lifecycle"}</h2>
          <p>{concept.relationToLifecycle}</p>
        </section>

        {concept.relationToGaic && (
          <section class="concept-section">
            <h2>How it relates to the GAIC white paper</h2>
          <p>{concept.relationToGaic}</p>
        </section>
      )}

        {(concept.boundaryNote || concept.sourceLinks) && (
          <section class="registry-chassis canonical-role-panel">
            <div class="registry-annotation" style="margin-bottom: 1rem;">
              <span class="registry-key">SOURCE_BOUNDARY</span>
            </div>
            {concept.boundaryNote && <p>{concept.boundaryNote}</p>}
            {concept.sourceLinks && (
              <div class="relation-links compact-source-links">
                {concept.sourceLinks.map((link) => (
                  <a href={link.href}>
                    <strong>{link.label}</strong>
                    <span>{link.description}</span>
                  </a>
                ))}
              </div>
            )}
          </section>
        )}

        {gaicSourceTrace && <GAICSourceTrace trace={gaicSourceTrace} />}

        {concept.entityClusters && (
          <section class="concept-section">
            <h2>Core object overview</h2>
            <div class="entity-cluster-grid">
              {concept.entityClusters.map((cluster) => (
                <article class="entity-cluster">
                  <h3>{cluster.name}</h3>
                  <ul>
                    {cluster.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>
        )}

        {concept.detailSections && concept.detailSections.map((section) => (
          <section class="concept-section">
            <h2>{section.title}</h2>
            <p>{section.body}</p>
          </section>
        ))}

        {concept.lifecycleChain && (
          <section class="concept-section">
            <h2>Lifecycle responsibility chain</h2>
            <div class="lifecycle-chain" aria-label={`${concept.term} lifecycle responsibility chain`}>
              {concept.lifecycleChain.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </section>
        )}

        <section class="concept-section">
          <h2>Evidence route</h2>
          <p>{concept.evidenceRoute}</p>
        </section>

        {concept.gaicEntity && (
          <section class="relation-grid" aria-label={`${concept.term} GAIC authority routes`}>
            <article class="registry-chassis relation-panel">
              <div class="registry-annotation" style="margin-bottom: 0.9rem;">
                <span class="registry-key">CONCEPT_CORE</span>
              </div>
              <h2>Agentic Lifecycle Governance</h2>
              <div class="relation-links">
                <a href={conceptCorePath}>
                  <strong>Open the Concept Core</strong>
                  <span>The short entry layer for the lifecycle responsibility object model.</span>
                </a>
              </div>
            </article>
            <article class="registry-chassis relation-panel">
              <div class="registry-annotation" style="margin-bottom: 0.9rem;">
                <span class="registry-key">AUTHORITY_SOURCE</span>
              </div>
              <h2>Global AI Compliance White Paper 2026</h2>
              <div class="relation-links">
                <a href={whitePaperHub}>
                  <strong>Open the white paper hub</strong>
                  <span>The sealed v0.3.2 Public Edition source for RCCS-M, ALCS, and MRO methodology.</span>
                </a>
              </div>
            </article>
            <article class="registry-chassis relation-panel">
              <div class="registry-annotation" style="margin-bottom: 0.9rem;">
                <span class="registry-key">APPLIED_PLAYBOOKS</span>
              </div>
              <h2>Applied governance playbooks</h2>
              <div class="relation-links">
                <a href="/playbooks/">
                  <strong>Open the playbook mesh</strong>
                  <span>Applied guides for rollback, auditability, human-role responsibility, vendor workflows, and Harness Engineering.</span>
                </a>
              </div>
            </article>
          </section>
        )}

        <section class="relation-grid" aria-label={`${concept.term} related routes`}>
          {relatedEssays.length > 0 && (
            <article class="registry-chassis relation-panel">
              <div class="registry-annotation" style="margin-bottom: 0.9rem;">
                <span class="registry-key">RELATED_ESSAYS</span>
              </div>
              <h2>Related essays</h2>
              <div class="relation-links">
                {relatedEssays.map((essay) => (
                  <a href={`/essays/${essay.id}/`}>
                    <strong>{essay.data.title}</strong>
                    <span>{essay.data.description}</span>
                  </a>
                ))}
              </div>
            </article>
          )}

          {relatedProjects.length > 0 && (
            <article class="registry-chassis relation-panel">
              <div class="registry-annotation" style="margin-bottom: 0.9rem;">
                <span class="registry-key">PROOF_PATH</span>
              </div>
              <h2>Related projects / proof path</h2>
              <div class="relation-links">
                {relatedProjects.map((project) => (
                  <a href={`/projects/${project.slug}/`}>
                    <strong>{project.name}</strong>
                    <span>{project.summary}</span>
                  </a>
                ))}
              </div>
            </article>
          )}

          {relatedTerms.length > 0 && (
            <article class="registry-chassis relation-panel relation-panel--wide">
              <div class="registry-annotation" style="margin-bottom: 0.9rem;">
                <span class="registry-key">RELATED_TERMS</span>
              </div>
              <h2>Related terms internal links</h2>
              <div class="term-link-grid">
                {relatedTerms.map((term) => (
                  <a href={`/concepts/${term.slug}/`}>{term.term}</a>
                ))}
              </div>
            </article>
          )}
        </section>

        <SocialShare
          title={concept.term}
          description={concept.seoDescription}
          url={conceptUrl}
        />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .concept-hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.2rem;
    margin-top: 1.4rem;
  }

  .concept-hero-link {
    text-decoration: none;
  }

  .concept-hero-link:hover .registry-value {
    color: var(--color-action);
  }

  .concept-detail-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 3rem;
    align-items: start;
    max-width: 1080px;
  }

  /* ReadingGuide and SemanticEvidenceBand are child components with their own
     Astro scopes. Use :global so the shell, rather than auto-placement, owns
     the reading order at desktop widths. */
  .concept-detail-shell > :global(.reading-guide) {
    grid-column: 1 / -1;
    grid-row: 1;
    min-width: 0;
  }

  .concept-detail-shell > :global(.semantic-evidence-band) {
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 0;
    min-width: 0;
  }

  .concept-sidebar {
    grid-column: 2;
    grid-row: 3;
    position: sticky;
    top: 7rem;
    padding: var(--registry-card-padding);
  }

  .sidebar-term {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 760;
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--current-text);
  }

  .sidebar-group {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--current-line);
  }

  .sidebar-label {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--current-muted);
  }

  .keyword-list,
  .sidebar-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .keyword-list span {
    display: inline-flex;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--current-line);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.25;
    color: var(--current-muted);
  }

  .sidebar-links a {
    color: var(--color-action);
    font-size: 0.86rem;
    line-height: 1.35;
    text-decoration: none;
  }

  .concept-article {
    grid-column: 1;
    grid-row: 3;
    display: grid;
    gap: 2.5rem;
  }

  .definition-panel {
    padding: var(--registry-panel-padding);
    border-left: 3px solid var(--color-rule);
  }

  .definition-panel p,
  .canonical-role-panel p,
  .concept-section p {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.72;
    color: var(--current-muted);
  }

  .definition-panel p {
    color: var(--current-text);
  }

  .canonical-role-panel {
    padding: var(--registry-panel-padding);
    border-left: 3px solid var(--color-rule);
  }

  .canonical-role-panel h2 {
    margin: 0 0 0.9rem;
    color: var(--current-text);
    font-size: 1.35rem;
    line-height: var(--type-card-title-line-height);
    letter-spacing: var(--type-card-title-letter-spacing);
    word-spacing: var(--type-card-title-word-spacing);
  }

  .compact-source-links {
    margin-top: 1rem;
  }

  .concept-section {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--current-line);
  }

  .concept-section h2,
  .relation-panel h2 {
    margin: 0 0 0.9rem;
    font-size: 1.45rem;
    line-height: var(--type-card-title-line-height);
    letter-spacing: var(--type-card-title-letter-spacing);
    word-spacing: var(--type-card-title-word-spacing);
    color: var(--current-text);
  }

  .relation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .entity-cluster-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.1rem;
  }

  .entity-cluster {
    padding: var(--registry-card-padding);
    border: 1px solid var(--current-line);
    background: color-mix(in srgb, var(--current-surface) 88%, transparent);
  }

  .entity-cluster h3 {
    margin: 0 0 0.8rem;
    color: var(--current-text);
    font-size: 1rem;
    line-height: var(--type-card-title-line-height);
    letter-spacing: var(--type-card-title-letter-spacing);
    word-spacing: var(--type-card-title-word-spacing);
  }

  .entity-cluster ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding-left: 1.1rem;
  }

  .entity-cluster li {
    color: var(--current-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .lifecycle-chain {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .lifecycle-chain span {
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--current-line);
    color: var(--color-meta);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .relation-panel {
    padding: var(--registry-card-padding);
  }

  .relation-panel--wide {
    grid-column: 1 / -1;
  }

  .relation-links {
    display: grid;
    gap: 1rem;
  }

  .relation-links a {
    display: grid;
    gap: 0.35rem;
    color: var(--current-text);
    text-decoration: none;
  }

  .relation-links strong {
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .relation-links span {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--current-muted);
  }

  .term-link-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
  }

  .term-link-grid a {
    color: var(--color-action);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .sidebar-links a:hover,
  .relation-links a:hover strong,
  .term-link-grid a:hover {
    color: var(--current-text);
  }

  @media (max-width: 920px) {
    .concept-detail-shell,
    .relation-grid,
    .entity-cluster-grid {
      grid-template-columns: 1fr;
    }

    .concept-detail-shell > :global(.reading-guide),
    .concept-detail-shell > :global(.semantic-evidence-band),
    .concept-sidebar,
    .concept-article {
      grid-column: auto;
      grid-row: auto;
    }

    .concept-sidebar {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .concept-detail-shell {
      gap: 2rem;
    }

    .concept-sidebar,
    .definition-panel,
    .relation-panel {
      padding: var(--registry-card-padding);
    }

    .definition-panel p,
    .concept-section p {
      font-size: 0.98rem;
      line-height: 1.68;
    }
  }
</style>
