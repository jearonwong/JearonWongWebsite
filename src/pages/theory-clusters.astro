---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegistryPageHero from "../components/RegistryPageHero.astro";
import { pageRegistry, siteConfig } from "../data/site";
import { absoluteUrl, createBreadcrumbJsonLd } from "../data/schema";

const canonicalPath = "/theories/";
const canonicalUrl = absoluteUrl(canonicalPath);
const legacyPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalUrl}#legacy-compatibility`,
  url: canonicalUrl,
  name: pageRegistry.ideasLegacy.title,
  description: pageRegistry.ideasLegacy.lead,
  isPartOf: {
    "@id": `${siteConfig.siteUrl}#website`
  },
  mainEntityOfPage: {
    "@id": `${canonicalUrl}#webpage`
  }
};
const legacyBreadcrumbJsonLd = createBreadcrumbJsonLd(canonicalUrl, [
  { name: "Home", path: "/" },
  { name: "Ideas", path: canonicalPath }
]);
---

<BaseLayout
  title="Ideas"
  description="Compatibility route retained for older links. The canonical ideas route is /theories."
  canonicalPath={canonicalPath}
  noindex={true}
  jsonLd={[legacyPageJsonLd, legacyBreadcrumbJsonLd]}
>
  <RegistryPageHero
    title={pageRegistry.ideasLegacy.title}
    objectType={pageRegistry.ideasLegacy.objectType}
    objectValue={pageRegistry.ideasLegacy.objectValue}
    lead={pageRegistry.ideasLegacy.lead}
  >
    <div class="registry-annotation">
      <span class="registry-key">NEXT_ROUTE</span>: <span class="registry-value">/theories/</span>
    </div>
    <div style="margin-top: 1.5rem;">
      <a href="/theories/" class="button button-outline">Open Ideas</a>
    </div>
  </RegistryPageHero>
</BaseLayout>
