---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";

const targetPath = "/mapping/extended-ecosystem/";
---

<BaseLayout
  title="Ecosystem Mapping"
  description="Compatibility alias for the Extended Ecosystem Lifecycle Governance Mapping page."
  canonicalPath={targetPath}
  noindex
>
  <div class="zone-a registry-grid alias-shell">
    <SiteHeader />
    <section class="shell alias-panel">
      <div class="registry-annotation">
        <span class="registry-key">ROUTE_ALIAS</span>: <span class="registry-value">ECOSYSTEM_MAPPING</span>
      </div>
      <h1>Ecosystem Mapping</h1>
      <p>
        This compatibility route points to the Extended Ecosystem Lifecycle Governance Mapping page.
      </p>
      <a href={targetPath} class="button button-primary">Open mapping</a>
    </section>
  </div>
</BaseLayout>

<style>
  .alias-shell {
    min-height: 100svh;
    display: grid;
    align-items: center;
  }

  .alias-panel {
    display: grid;
    gap: 1rem;
    max-width: 42rem;
    padding-top: 7rem;
    padding-bottom: 6rem;
  }

  .alias-panel h1 {
    margin: 0;
    color: var(--text-registry-primary);
    font-size: clamp(3rem, 7vw, 5.8rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  .alias-panel p {
    max-width: 38rem;
    margin: 0;
    color: rgba(241, 245, 249, 0.76);
    font-size: 1.08rem;
    line-height: 1.68;
  }

  .alias-panel .button {
    width: fit-content;
  }
</style>
