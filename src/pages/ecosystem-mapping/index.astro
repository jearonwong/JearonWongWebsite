---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegistryPageHero from "../../components/RegistryPageHero.astro";

const targetPath = "/mapping/extended-ecosystem/";
---

<BaseLayout
  title="Ecosystem Mapping"
  description="Compatibility alias for the Extended Ecosystem Lifecycle Governance Mapping page."
  canonicalPath={targetPath}
  noindex
>
  <RegistryPageHero
    title="Ecosystem Mapping"
    objectType="ROUTE_ALIAS"
    objectValue="ECOSYSTEM_MAPPING"
    lead="This compatibility route points to the Extended Ecosystem Lifecycle Governance Mapping page."
  >
    <a href={targetPath} class="button button-primary">Open mapping</a>
  </RegistryPageHero>
</BaseLayout>
