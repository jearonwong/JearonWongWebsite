---
import { primaryNav, secondaryNavGroups, siteConfig, siteSemanticBaseline, socialLinks } from "../data/site";

const trustLinks = [
  { href: "/privacy/", label: "Privacy Policy" },
  { href: "/terms/", label: "Terms" }
];

const footerRouteGroups = [
  { key: "mainline", label: "Mainline", items: primaryNav },
  ...secondaryNavGroups
];
---

<footer class="site-footer-shell zone-b">
  <div class="shell site-footer">
    <div class="footer-intro">
      <div class="footer-kicker" aria-label="Site state">
        <span>RESEARCH LEDGER</span>
        <span aria-hidden="true">/</span>
        <span>PUBLIC HEADQUARTERS</span>
      </div>
      <h2>{siteConfig.author.name}</h2>
      <p class="footer-role">{siteConfig.author.role}</p>
      <p class="footer-thesis">{siteSemanticBaseline.problemStatement}</p>
      <div class="footer-social" aria-label="Social links">
        {socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">{link.platform}</a>
        ))}
      </div>
    </div>

    <nav aria-label="Footer routes" class="footer-routes">
      {footerRouteGroups.map((group) => (
        <div class="footer-route-group">
          <span class="footer-route-label">{group.label}</span>
          <div class="footer-route-list">
            {group.items.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <div class="footer-bottom">
      <nav aria-label="Site trust links" class="footer-trust">
        {trustLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <p class="footer-copy">&copy; {new Date().getFullYear()} Jearon Wong</p>
    </div>
  </div>
</footer>

<style>
  .site-footer-shell {
    --footer-ink: #111418;
    --footer-muted: var(--color-meta);
    --footer-line: var(--color-rule);
    --footer-soft-line: var(--color-rule-soft);
    margin-top: 0;
    border-top: 1px solid var(--footer-line);
    background: #f7f8fa;
    color: var(--footer-ink);
  }

  .site-footer {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.6fr);
    gap: clamp(3rem, 7vw, 7rem);
    padding: 4.5rem 0 1.5rem;
  }

  .footer-intro {
    align-self: start;
    min-width: 0;
  }

  .footer-kicker,
  .footer-route-label,
  .footer-social,
  .footer-trust,
  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: var(--type-meta-letter-spacing);
    line-height: var(--type-meta-line-height);
    word-spacing: var(--type-meta-word-spacing);
    text-transform: uppercase;
  }

  .footer-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--footer-muted);
  }

  .footer-intro h2 {
    margin: 1.35rem 0 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3vw, 2.8rem);
    font-weight: 650;
    letter-spacing: var(--type-section-title-letter-spacing);
    line-height: var(--type-section-title-line-height);
    word-spacing: var(--type-section-title-word-spacing);
  }

  .footer-role {
    margin: 0;
    color: var(--footer-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: var(--type-meta-letter-spacing);
    line-height: var(--type-meta-line-height);
    word-spacing: var(--type-meta-word-spacing);
    text-transform: uppercase;
  }

  .footer-thesis {
    max-width: 24ch;
    margin: 2.25rem 0 1.5rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 560;
    letter-spacing: var(--type-card-title-letter-spacing);
    line-height: var(--type-card-title-line-height);
    word-spacing: var(--type-card-title-word-spacing);
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.1rem;
  }

  .footer-social a,
  .footer-route-list a,
  .footer-trust a {
    color: var(--footer-muted);
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .footer-social a {
    border-bottom: 1px solid transparent;
  }

  .footer-social a:hover,
  .footer-route-list a:hover,
  .footer-trust a:hover {
    color: var(--color-action);
  }

  .footer-social a:hover {
    border-color: currentColor;
  }

  .footer-routes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    align-content: start;
    padding-top: 0.2rem;
    border-top: 1px solid var(--footer-line);
  }

  .footer-route-group {
    min-width: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--footer-soft-line);
  }

  .footer-route-label {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--footer-muted);
  }

  .footer-route-list {
    display: grid;
    gap: 0.45rem;
  }

  .footer-route-list a {
    font-family: var(--font-display);
    font-size: 0.94rem;
    font-weight: 540;
    letter-spacing: 0;
    line-height: var(--type-card-title-line-height);
    word-spacing: var(--type-card-title-word-spacing);
  }

  .footer-bottom {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: baseline;
    padding-top: 1.25rem;
    border-top: 1px solid var(--footer-line);
  }

  .footer-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .footer-copy {
    margin: 0;
    color: var(--footer-muted);
    text-align: right;
  }

  @media (max-width: 900px) {
    .site-footer {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .footer-routes {
      grid-column: 1;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      width: min(calc(100vw - 2rem), 1240px);
      padding-top: 3.5rem;
    }

    .footer-routes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.25rem;
    }

    .footer-bottom {
      display: grid;
      gap: 0.75rem;
    }

    .footer-copy {
      text-align: left;
    }
  }
</style>
