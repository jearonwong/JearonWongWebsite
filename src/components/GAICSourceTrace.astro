---
import type { GaicP1SourceTrace } from "../data/gaicP1SourceTrace";

interface Props {
  trace: GaicP1SourceTrace;
}

const { trace } = Astro.props;
---

<section class="registry-chassis gaic-source-trace" aria-labelledby={`gaic-source-trace-${trace.route.replaceAll("/", "-")}`}>
  <div class="registry-annotation">
    <span class="registry-key">WHITE_PAPER_SOURCE_TRACE</span>
    <span class="registry-value">{trace.sourceSupport.toUpperCase()}</span>
  </div>
  <h2 id={`gaic-source-trace-${trace.route.replaceAll("/", "-")}`}>White paper source trace</h2>
  <p>{trace.summary}</p>
  <p>{trace.relation}</p>
  <p>{trace.lifecycleExample}</p>
  <p class="gaic-source-trace__boundary">{trace.boundary}</p>
  {trace.sourceAnchors.length > 0 && (
    <div class="gaic-source-trace__anchors" aria-label="White paper anchors">
      {trace.sourceAnchors.map((anchor) => (
        <a href={anchor.href}>
          <strong>{anchor.label}</strong>
          <span>{anchor.description}</span>
        </a>
      ))}
    </div>
  )}
  <div class="gaic-source-trace__related" aria-label="Canonical source routes">
    {trace.relatedLinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </div>
</section>

<style>
  .gaic-source-trace {
    display: grid;
    gap: 0.9rem;
    padding: var(--registry-panel-padding);
    border-left: 3px solid var(--accent-proof);
  }

  .gaic-source-trace h2 {
    margin: 0;
    color: var(--current-text);
    font-size: 1.35rem;
    line-height: 1.18;
    letter-spacing: 0;
  }

  .gaic-source-trace p {
    margin: 0;
    color: var(--current-muted);
    font-size: 1rem;
    line-height: 1.66;
  }

  .gaic-source-trace__boundary {
    color: var(--current-text);
  }

  .gaic-source-trace__anchors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 0.25rem;
  }

  .gaic-source-trace__anchors a {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem;
    border: 1px solid var(--current-line);
    color: var(--current-text);
    text-decoration: none;
  }

  .gaic-source-trace__anchors strong {
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .gaic-source-trace__anchors span {
    color: var(--current-muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .gaic-source-trace__related {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--current-line);
  }

  .gaic-source-trace__related a {
    color: var(--accent-signal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .gaic-source-trace__anchors a:hover strong,
  .gaic-source-trace__related a:hover {
    color: var(--current-text);
  }

  @media (max-width: 720px) {
    .gaic-source-trace__anchors {
      grid-template-columns: 1fr;
    }
  }
</style>
