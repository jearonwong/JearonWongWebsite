---
import SiteHeader from "./SiteHeader.astro";

interface Props {
  title: string;
  titleLines?: string[];
  subtitle?: string;
  objectType?: string;
  objectValue?: string;
  lead?: string;
  leadLines?: string[];
  zone?: string;
  class?: string;
}

const {
  title,
  titleLines,
  subtitle,
  objectType,
  objectValue,
  lead,
  leadLines,
  zone = "zone-a",
  class: className = ""
} = Astro.props;

const displayTitleLines = titleLines?.length
  ? titleLines.map((line, index) => ({
      line,
      isFraming: index === 0 && titleLines.length > 1 && line.trim().endsWith(":")
    }))
  : null;
const displayLeadLines = leadLines?.length ? leadLines : null;
---

<div class:list={[zone, "registry-grid", "registry-page-hero", className]}>
  <SiteHeader />
  <div class="shell registry-page-hero__shell">
    {objectType && objectValue && (
      <div class="registry-annotation registry-page-hero__annotation">
        <span class="registry-key">{objectType}</span>: <span class="registry-value">{objectValue}</span>
      </div>
    )}
    <h1 class:list={["registry-page-hero__title", displayTitleLines && "has-title-lines"]}>
      {displayTitleLines ? (
        displayTitleLines.map(({ line, isFraming }) => (
          <span
            class:list={["registry-page-hero__title-line", isFraming && "registry-page-hero__title-line--framing"]}
            data-title-role={isFraming ? "framing" : "main"}
          >
            {line}
          </span>
        ))
      ) : (
        title
      )}
    </h1>
    {subtitle && <p class="registry-page-hero__subtitle">{subtitle}</p>}
    {(lead || displayLeadLines) && (
      <p class:list={["lead", "registry-page-hero__lead", displayLeadLines && "has-lead-lines"]}>
        {displayLeadLines ? (
          displayLeadLines.map((line) => <span class="registry-page-hero__lead-line">{line}</span>)
        ) : (
          lead
        )}
      </p>
    )}
    <slot />
  </div>
</div>

<style>
  .registry-page-hero {
    padding-top: clamp(7rem, 10vw, 8.25rem);
    padding-bottom: clamp(4.4rem, 7vw, 5.25rem);
    border-bottom: 1px solid var(--border-registry);
  }

  .registry-page-hero__annotation {
    margin-bottom: 1.35rem;
  }

  .registry-page-hero__title {
    font-size: var(--type-registry-hero-title-size);
    font-weight: var(--type-registry-hero-title-weight);
    letter-spacing: var(--type-registry-hero-title-letter-spacing);
    line-height: var(--type-registry-hero-title-line-height);
    margin: 0 0 1.45rem;
    max-width: min(100%, 17em);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .registry-page-hero__title-line {
    display: block;
  }

  .registry-page-hero__title .registry-page-hero__title-line[data-title-role="framing"] {
    margin-bottom: 0.32em;
    font-size: var(--type-registry-hero-title-framing-size) !important;
    font-weight: var(--type-registry-hero-title-framing-weight) !important;
    letter-spacing: 0 !important;
    line-height: var(--type-registry-hero-title-framing-line-height) !important;
    color: rgba(241, 245, 249, 0.82);
    max-width: min(100%, 24em);
  }

  .registry-page-hero__subtitle {
    max-width: min(100%, var(--lead-measure));
    margin: 0 0 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.2vw, 1.3rem);
    font-weight: 640;
    letter-spacing: 0;
    line-height: 1.35;
    color: var(--current-text);
    overflow-wrap: anywhere;
  }

  .registry-page-hero__lead {
    width: min(100%, var(--lead-measure));
    max-width: none;
    font-size: clamp(1.05rem, 1.2vw, 1.18rem);
    color: rgba(226, 232, 240, 0.68);
    border-left: 2px solid rgba(59, 130, 246, 0.32);
    padding-left: var(--registry-compact-padding);
    line-height: 1.62;
    overflow-wrap: anywhere;
  }

  .registry-page-hero__lead-line {
    display: block;
  }

  @media (max-width: 768px) {
    .registry-page-hero {
      padding-top: 6.75rem;
      padding-bottom: 3.5rem;
    }

    .registry-page-hero__annotation {
      margin-bottom: 0.8rem;
    }

    .registry-page-hero__title {
      font-size: var(--type-registry-hero-title-size-mobile);
      line-height: var(--type-registry-hero-title-line-height-mobile);
      margin-bottom: 1.15rem;
      max-width: 100%;
    }

    .registry-page-hero__title .registry-page-hero__title-line[data-title-role="framing"] {
      font-size: var(--type-registry-hero-title-framing-size-mobile) !important;
      line-height: var(--type-registry-hero-title-framing-line-height-mobile) !important;
      max-width: 100%;
    }

    .registry-page-hero__subtitle {
      max-width: 100%;
      margin-bottom: 0.75rem;
      font-size: clamp(0.95rem, 4vw, 1.12rem);
    }

    .registry-page-hero__lead {
      font-size: 1rem;
      line-height: 1.6;
      padding-left: var(--space-2);
      width: 100%;
    }
  }
</style>
